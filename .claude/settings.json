{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/loop-kit/bin/hook-loop-triage.mjs\"",
            "timeout": 10,
            "statusMessage": "loop 入口分流检查单"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/review-provider-context-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "评审供应方内联认证纪律"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/mail-loop/mail-watch.sh\" hook-prompt",
            "timeout": 20,
            "statusMessage": "mail-loop 收件箱看门狗（待投递新回信注入）"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/mail-loop/mail-watch.sh\" hook-session-start",
            "timeout": 20,
            "statusMessage": "mail-loop 收件箱看门狗（拉起常驻轮询 + 补投未处理回信）"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/loop-kit/bin/hook-loop-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "loop 阶段互锁"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/loop-kit/bin/hook-stop.mjs\"",
            "timeout": 30,
            "statusMessage": "term-lint 扫描回合输出"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/term-guard-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "term-guard 甲扫回合输出（warn-only 观察期）"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/mail-loop/mail-watch.sh\" hook-stop",
            "timeout": 20,
            "statusMessage": "mail-loop 收件箱看门狗（有新回信就把回合拉回来）"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/loop-kit/bin/hook-posttool.mjs\"",
            "timeout": 30,
            "statusMessage": "term-lint 扫描写入文件"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/config-lane-guard-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "model-lane-guard I2 config 异构守卫（写 loop/config.json 时）"
          }
        ]
      }
    ]
  }
}
