   221	export function startChatSut({ port = 0, scenario = 'happy' } = {}) {
   222	  return new Promise((resolve, reject) => {
   223	    const child = fork(fileURLToPath(import.meta.url), ['--serve', '--port', String(port), '--scenario', scenario], { stdio: ['ignore', 'inherit', 'inherit', 'ipc'] });
   224	    let settled = false;
   225	    const timer = setTimeout(() => { if (!settled) { settled = true; try { child.kill(); } catch {} reject(new Error('chat 假 SUT 子进程启动超时')); } }, 10000);
   226	    child.once('message', (msg) => {
   227	      if (settled || !msg || !msg.ready) return;
   228	      settled = true;
   229	      clearTimeout(timer);
   230	      resolve({
   231	        url: 'http://127.0.0.1:' + msg.port,
   232	        port: msg.port,
   233	        close: () => new Promise((r) => {
   234	          if (child.exitCode !== null || child.killed) return r();
   235	          const to = setTimeout(() => { try { child.kill('SIGKILL'); } catch {} r(); }, 3000);
   236	          child.once('exit', () => { clearTimeout(to); r(); });
   237	          try { child.kill(); } catch { clearTimeout(to); r(); }
   238	        }),
   239	      });
   240	    });
   241	    child.once('error', (e) => { if (!settled) { settled = true; clearTimeout(timer); reject(e); } });
   242	    child.once('exit', (code) => { if (!settled) { settled = true; clearTimeout(timer); reject(new Error('chat 假 SUT 子进程未就绪即退出 code=' + code)); } });
   243	  });
   244	}
