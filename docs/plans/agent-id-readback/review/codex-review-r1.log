   129	
   130	check('G4c sol 假唯一攻击：同名两行且其一码中，仍必须 ambiguous（禁先按名+码过滤成一条）', () => {
   131	  // 期望码 AG-001 恰好命中其一——若实现先用 name+code 过滤，会伪造出唯一行判 unique
   132	  const out = resolveDualIdentity({
   133	    dom: baseDom(),
