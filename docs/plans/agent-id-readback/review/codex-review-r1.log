   117	
   118	check('G4b 完整集合内同名>1→ambiguous（即使 DOM 只见一卡）', () => {
   119	  const out = resolveDualIdentity({
   120	    dom: baseDom(),
   121	    envelope: okEnvelope([
   122	      rowAlice,
   123	      { id: '99', code: 'AG-099', name: 'Alice' },
   124	    ]),
   125	    expected: signedExpected(),
   126	  });
