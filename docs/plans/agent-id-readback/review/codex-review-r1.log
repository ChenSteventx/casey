   147	
   148	check('G5a expected.code 不等→action_failed', () => {
   149	  const expected = { ...jointExpected(), code: 'AG-999' };
   150	  const out = resolveDualIdentity({ dom: baseDom(), envelope: okEnvelope([rowAlice]), expected });
   151	  mustResolution(out, 'action_failed');
