   320	function snapshotDir(dir) {
   321	  const out = new Map();
   322	  (function walk(current) {
   323	    for (const entry of readdirSync(current, { withFileTypes: true })) {
   324	      const path = join(current, entry.name);
   325	      if (entry.isDirectory()) walk(path);
   326	      else out.set(path, readFileSync(path).toString('base64'));
   327	    }
   328	  })(dir);
   329	  return out;
   330	}
