    10	//
    11	// 检查面（每条独立 check）：
    12	//   G1a-G1d  完整性先决各失败支：envelope status invalid/conflict/unsettled/empty→action_failed；
    13	//   G2       DOM failed→action_failed；
    14	//   G3       完整集合命中 0→absent；
    15	//   G4a-G4c  DOM ambiguous 或同名>1→ambiguous（先数同名再查码——sol 假唯一攻击）；
    16	//   G5a-G5d  名唯一但 expected.code/dom.code/信封 code/signedPlatformId 任一不等→action_failed；
    17	//   G6       三方全等→unique + matched 三元组 deepEqual；
    18	//   G7a-G7b  signedPlatformId 缺席（编译首采）：不参与比对但其余判据照跑。
    19	
    20	import { isDeepStrictEqual } from 'node:util';
    21	
    22	const TAG = 'agent-id-gate';
    23	let failures = 0;
    24	let passes = 0;
    25	const red = (label, detail) => { failures += 1; console.error(`RED  ${TAG}: ${label}: ${detail}`); };
    26	const ok = (label) => { passes += 1; console.log(`ok   ${TAG}: ${label}`); };
    27	
    28	// ---- 被测模块（红先行：现在不存在，动态 import 捕获缺席）----
    29	const MODULE_REL = '../../lib/agent-identity-gate.mjs';
    30	let resolveDualIdentity = null;
    31	let absentReason = null;
    32	try {
    33	  const mod = await import(new URL(MODULE_REL, import.meta.url).href);
    34	  if (typeof mod.resolveDualIdentity === 'function') {
    35	    resolveDualIdentity = mod.resolveDualIdentity;
    36	  } else {
    37	    absentReason = '模块存在但未导出 resolveDualIdentity';
    38	  }
    39	} catch (e) {
    40	  absentReason = e?.code === 'ERR_MODULE_NOT_FOUND'
    41	    ? `模块缺席（${e.code}）——lib/agent-identity-gate.mjs 尚未实现，红先行`
    42	    : `模块加载失败（${e?.code ?? e?.name}: ${e?.message}）`;
    43	}
    44	
    45	// ---- 夹具：全等基线（逐 check 单点变异）----
    46	const rowAlice = Object.freeze({ id: '42', code: 'AG-001', name: 'Alice' });
    47	const okEnvelope = (rows) => ({ status: 'ok', rows: rows.map((r) => ({ ...r })), total: rows.length });
    48	const baseDom = () => ({ status: 'unique', name: 'Alice', code: 'AG-001' });
    49	const signedExpected = () => ({
    50	  openName: 'Alice',
    51	  code: 'AG-001',
    52	  signedPlatformId: '42',
    53	  signedCode: 'AG-001',
    54	  signedName: 'Alice',
    55	});
    56	// 编译首采期望（signedPlatformId 缺席）
