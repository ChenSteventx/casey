   107	// SSE 分片：静默点 = 流 finished（同 p5 fake-sut 发法：event: finished + {status:200}）。
   108	function streamReply(res, scenario) {
   109	  res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-store', Connection: 'keep-alive' });
   110	  const chunks = scenario === 'error'
   111	    ? ['操作失败：', '服务异常']
   112	    : ['您好，', '已了解您的症状。', '建议多休息。'];
   113	  chunks.forEach((c, i) => {
   114	    setTimeout(() => { try { res.write('data: ' + c + '\n\n'); } catch { /* 客户端已关 */ } }, 300 + i * 400);
   115	  });
   116	  setTimeout(() => {
   117	    try {
   118	      res.write('event: finished\ndata: ' + JSON.stringify({ status: 200, finished: true }) + '\n\n');
   119	      res.end();
   120	    } catch { /* 客户端已关 */ }
   121	  }, 300 + chunks.length * 400 + 300);
   122	}
