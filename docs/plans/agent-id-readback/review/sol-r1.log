    13	export async function resolveAgentSearchTarget(page, { openName, containerSelector = '.agent-item' } = {}) {
    14	  const name = typeof openName === 'string' ? openName : '';
    15	  if (!name.trim()) return { resolution: 'absent', candidateCount: 0 };
    16	  const probe = page.getByText(name, { exact: true });
    17	  const count = await probe.count().catch(() => null);
    18	  if (count === null || count === 0) return { resolution: 'absent', candidateCount: 0 };
    19	  if (count > 1) return { resolution: 'ambiguous', candidateCount: count };
    20	  const inContainer = await probe
    21	    .evaluate((el, sel) => !!el.closest(sel), containerSelector)
    22	    .catch(() => null);
    23	  if (inContainer !== true) return { resolution: 'container-out', candidateCount: 1 };
    24	  return { resolution: 'unique', candidateCount: 1 };
    25	}
