    29	    const attributedStepId = isBg(url) || !firing || !isApi ? null : firing;
    30	    const rec = { requestId: e.requestId, url, method: e.request.method, status: null, ts: e.timestamp, initiator, type, firingStepId: firing, attributedStepId, errorEnvelope: null, streamFinished: undefined, streamStatus: undefined };
    31	    byReq.set(e.requestId, rec);
    32	    records.push(rec);
