   124	function makeHandler(scenario) {
   125	  return (req, res) => {
   126	    const path = new URL(req.url, 'http://127.0.0.1').pathname;
   127	    if (req.method === 'GET' && path === '/') return html(res, SIDEBAR + '<h1>首页</h1>');
   128	    if (req.method === 'GET' && path === '/agent/list') return html(res, scenario === 'twins' ? TWINS_LIST_PAGE : LIST_PAGE);
   129	    if (req.method === 'GET' && path === '/agent/detail') return html(res, detailPage(scenario));
   130	    if (req.method === 'GET' && path === '/ai-api/tester/agent/stream') return streamReply(res, scenario);
   131	    if (req.method === 'GET' && path === '/ai-manager/auths/getTempTokenForApi') {
   132	      // 假临时凭据端点：只回成功信封，绝不回真值形态（打码考场只考路由名字面）。
   133	      const body = JSON.stringify({ status: 200 });
   134	      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Content-Length': Buffer.byteLength(body) });
   135	      res.end(body);
   136	      return;
   137	    }
   138	    if (req.method === 'GET' && path === '/ai-api/background/stream') {
   139	      // 背景长流：只发注释心跳、永不 finished、永不 end（服务进程随 close() 一并回收）。
   140	      res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-store', Connection: 'keep-alive' });
   141	      res.write(': bg\n\n');
   142	      return;
   143	    }
   144	    const body = JSON.stringify({ status: 404 });
   145	    res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8', 'Content-Length': Buffer.byteLength(body) });
   146	    res.end(body);
   147	  };
   148	}
