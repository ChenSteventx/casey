   150	export function startChatSut({ port = 0, scenario = 'happy' } = {}) {
   151	  return new Promise((resolve, reject) => {
   152	    const child = fork(fileURLToPath(import.meta.url), ['--serve', '--port', String(port), '--scenario', scenario], { stdio: ['ignore', 'inherit', 'inherit', 'ipc'] });
   153	    let settled = false;
   154	    const timer = setTimeout(() => { if (!settled) { settled = true; try { child.kill(); } catch {} reject(new Error('chat 假 SUT 子进程启动超时')); } }, 10000);
   155	    child.once('message', (msg) => {
   156	      if (settled || !msg || !msg.ready) return;
   157	      settled = true;
   158	      clearTimeout(timer);
   159	      resolve({
   160	        url: 'http://127.0.0.1:' + msg.port,
   161	        port: msg.port,
   162	        close: () => new Promise((r) => {
   163	          if (child.exitCode !== null || child.killed) return r();
   164	          const to = setTimeout(() => { try { child.kill('SIGKILL'); } catch {} r(); }, 3000);
   165	          child.once('exit', () => { clearTimeout(to); r(); });

