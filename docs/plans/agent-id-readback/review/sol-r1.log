    23	    const type = e.type || null;
    24	    // 正向归因：仅 script/XHR/Fetch/EventSource 这类用户动作触发的 API 才系到本步；
    25	    // 背景 denylist、文档导航、非脚本发起、无活动步 → 一律 null（默认 null 是 fail-safe 物理落点，绝不默认成最近步）。
    26	    if (type === 'EventSource') streamOpen++;
    27	    if ((type === 'XHR' || type === 'Fetch') && !isBg(url)) inFlightApi.add(e.requestId);
