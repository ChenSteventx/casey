   175	function serveMain() {
   176	  const argv = process.argv;
   177	  const port = Number(argv[argv.indexOf('--port') + 1] || 0);
   178	  const scIdx = argv.indexOf('--scenario');
   179	  const scenario = scIdx >= 0 ? argv[scIdx + 1] : 'happy';
   180	  const server = http.createServer(makeHandler(scenario));
   181	  server.listen(port, '127.0.0.1', () => {
   182	    if (process.send) process.send({ ready: true, port: server.address().port });
   183	  });
   184	}
   185	
   186	const isServeMain = process.argv[1] && resolvePath(process.argv[1]) === fileURLToPath(import.meta.url) && process.argv.includes('--serve');
   187	if (isServeMain) serveMain();

