   119	        try { existing = JSON.parse(readExisting(journalPath)); } catch { return denied('PUBLICATION_JOURNAL_INVALID'); }
   120	        if (JSON.stringify(existing) !== JSON.stringify(expectedJournal)) return denied('PUBLICATION_INPUT_MISMATCH');
   121	      } else {
   122	        if (io.exists(journalTmp)) return denied('PUBLICATION_JOURNAL_TMP_ORPHANED');
   123	        try {
   124	          io.writeExclusive(journalTmp, journalText);
   125	          io.rename(journalTmp, journalPath);
   126	        } catch {
   127	          try { io.remove(journalTmp); } catch { /* 留给人工审计 */ }
   128	          return denied('PUBLICATION_JOURNAL_PREPARE_FAILED', true);
   129	        }
   130	      }
   131	    } catch {
   132	      return denied('PUBLICATION_JOURNAL_IO_FAILED', true);
   133	    }
   134	
   135	    // 先把所有缺失目标写成 tmp；已到位目标只接受逐字节相等。
   136	    for (let index = 0; index < writes.length; index++) {
   137	      const { path, text } = writes[index];
   138	      try {
   139	        if (io.exists(path) && readExisting(path) === text) continue;
   140	        if (io.exists(tmps[index])) {
   141	          if (readExisting(tmps[index]) !== text) return denied('PUBLICATION_TMP_MISMATCH');
   142	        } else {
   143	          io.writeExclusive(tmps[index], text);
   144	        }
   145	      } catch {
   146	        return denied('PUBLICATION_STAGE_FAILED', true);
   147	      }
   148	    }
   149	
   150	    // 调用契约已强制 authorityPath 位于最后；前序中断只留下无本次新 PRD checksum 的内容。
   151	    for (let index = 0; index < writes.length; index++) {
   152	      const { path, text } = writes[index];
   153	      if (index === writes.length - 1 && plan.beforeAuthorityCommit) {
   154	        try {
   155	          if (plan.beforeAuthorityCommit() !== true) return denied('PUBLICATION_PRE_AUTHORITY_CHECK_FAILED');
   156	        } catch {
   157	          return denied('PUBLICATION_PRE_AUTHORITY_CHECK_FAILED');
   158	        }
   159	      }
   160	      try {
   161	        if (io.exists(path) && readExisting(path) === text) {
   162	          if (io.exists(tmps[index])) io.remove(tmps[index]);
   163	          continue;
   164	        }
   165	        // stage 与 commit 之间仍须重核 tmp；生产 archive 读缝以 O_NOFOLLOW + fd inode
   166	        // 取字节，拒绝把中断后换入的 symlink rename 成永久审计件。
   167	        if (!io.exists(tmps[index]) || readExisting(tmps[index]) !== text) {
   168	          return denied('PUBLICATION_TMP_PRECOMMIT_MISMATCH');
   169	        }
   170	        io.rename(tmps[index], path);
   171	      } catch {
   172	        return denied('PUBLICATION_COMMIT_INTERRUPTED', true);
   173	      }
   174	    }
   175	    for (const { path, text } of writes) {
   176	      try { if (!io.exists(path) || readExisting(path) !== text) return denied('PUBLICATION_FINAL_CHECK_FAILED', true); }
   177	      catch { return denied('PUBLICATION_FINAL_CHECK_FAILED', true); }
   178	    }
   179	    try { io.remove(journalPath); }
   180	    catch { return denied('PUBLICATION_JOURNAL_CLEANUP_FAILED', true); }
   181	    return ok(recovered);
   182	  };
   183	}
