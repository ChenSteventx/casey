   401	  // 生产 compile 的 flow 是 step 数组；旧 authority/测试文档也可能用闭合 `{steps:[...]}`。
   402	  // 两种只是同一域的容器形态，逐 step 闭合校验与固定 side-effect policy 完全相同。
   403	  const directFlow = collectionKey === 'steps' ? closedArray(document) : null;
   404	  const root = directFlow ? null : dataRecord(document);
   405	  if (!directFlow && !root) return null;
