   164	    physical.push({ kind, ...extra });
   165	    const behavior = actions[kind];
   166	    if (behavior === 'throw') {
   167	      // 合成敌意异常：原文携假 selector 与假地址，任何外泄都会被公开面钉逮到。
   168	      const error = new Error(`SYNTHETIC_FAILURE ${SELECTOR} ${ORIGIN}/fake-detail`);
   169	      error.name = 'TimeoutError';
   170	      throw error;
   171	    }
   172	    return undefined;
   173	  };
   174	
   175	  const handle = {
   176	    async evaluate(fn, arg) {
   177	      // 复刻 Playwright 的 handle→node 解包：句柄实参在浏览器侧变成 DOM 节点。
   178	      const other = arg && typeof arg === 'object' && typeof arg.__nodeNow === 'function'
   179	        ? arg.__nodeNow()
   180	        : arg;
   181	      return fn(node, other);
   182	    },
   183	    async ownerFrame() { return frame; },
   184	    async click(options) { return record('click', options); },
   185	    async dblclick(options) { return record('dblclick', options); },
   186	    async fill(value, options) { return record('fill', options, { value }); },
   187	    async press(key, options) { return record('press', options, { key }); },
   188	  };
   189	  Object.defineProperty(handle, '__nodeNow', {
   190	    value: () => node, enumerable: false, writable: false, configurable: false,
   191	  });
   192	
   193	  const locator = {
   194	    first() { return locator; },
   195	    async waitFor() {},
   196	    async count() { stats.countCalls += 1; return 1; },
   197	    async elementHandle() { return handle; },
   198	    async click(options) { return record('click', options); },
   199	    async dblclick(options) { return record('dblclick', options); },
   200	    async fill(value, options) { return record('fill', options, { value }); },
   201	    async press(key, options) { return record('press', options, { key }); },
   202	  };
   203	
   204	  Object.assign(page, {
   205	    name: String(name),
   206	    physical,
   207	    stats,
   208	    locator(selector) {
   209	      stats.locatorSelectors.push(selector);
   210	      return locator;
   211	    },
   212	    mainFrame: () => frame,
   213	    url() { return url; },
   214	    async opener() { return null; },
   215	    on(event, handler) {
   216	      const list = listeners.get(event) || [];
   217	      list.push(handler);
   218	      listeners.set(event, list);
   219	    },
   220	    isClosed() { return closed; },
   221	    async close() {
   222	      if (closed) return;
   223	      closed = true;
   224	      for (const handler of listeners.get('close') || []) await handler();
   225	    },
   226	    async addInitScript() {},
   227	    // 毒方法：raw 面任何分支都不得导航修正（护栏面，越界即可见）。
   228	    async goto() { stats.gotoCalls += 1; throw new Error('RAW_NAV_MUST_NOT_GOTO'); },
   229	  });
   230	  return page;
   231	}
