   483	// fresh runtime 授权：录制段真关闭 → 回放段对象归属，逐段用现役生产件铸权。
   484	function mintFresh(topologyAuthority) {
   485	  const emitter = (extra = {}) => {
   486	    const listeners = new Map();
   487	    return {
   488	      ...extra,
   489	      on(event, handler) {
   490	        const list = listeners.get(event) || [];
   491	        list.push(handler);
   492	        listeners.set(event, list);
   493	      },
   494	      emit(event) {
   495	        for (const handler of listeners.get(event) || []) handler();
   496	      },
   497	    };
   498	  };
   499	  let recordingConnected = true;
   500	  const recordingBrowser = emitter({ isConnected: () => recordingConnected });
   501	  const recordingContext = emitter({ browser: () => recordingBrowser });
   502	  const witnessed = createFreshReplayWitness({ recordingBrowser, recordingContext });
   503	  assert(witnessed?.ok === true && witnessed.witness,
   504	    `fresh witness 创建失败：${JSON.stringify(witnessed)}`);
   505	  recordingContext.emit('close');
   506	  recordingConnected = false;
   507	  recordingBrowser.emit('disconnected');
   508	  const replayBrowser = emitter({ isConnected: () => true });
   509	  const replayContext = emitter({ browser: () => replayBrowser });
   510	  const replayPage = emitter({ context: () => replayContext, isClosed: () => false });
   511	  const authorized = authorizeFreshReplayRuntime({
   512	    witness: witnessed.witness,
   513	    replayBrowser,
   514	    replayContext,
   515	    replayPage,
   516	    topologyAuthority,
   517	  });
   518	  assert(authorized?.ok === true && authorized.freshRuntimeAuthority,
   519	    `fresh runtime 授权失败：${JSON.stringify(authorized)}`);
   520	  return authorized.freshRuntimeAuthority;
   521	}
