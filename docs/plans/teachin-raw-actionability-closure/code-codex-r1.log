   303	      if (pageAuthority !== authority) return { ok: false, reason: 'PAGE_AUTHORITY_STALE' };
   304	      try {
   305	        return { ok: true, value: await evaluate(page) };
   306	      } catch {
   307	        return { ok: false, reason: 'PAGE_EVALUATION_FAILED' };
   308	      }
   309	    },
   310	    async performClick({ pageAuthority, perform } = {}) {
   311	      if (pageAuthority !== authority) return { ok: false, reason: 'PAGE_AUTHORITY_STALE' };
   312	      try {
   313	        return { ok: true, value: await perform(page) };
   314	      } catch {
   315	        return { ok: false, reason: 'PAGE_ACTION_FAILED' };
   316	      }
   317	    },
   318	    async consumeNewPageEvent() { return { ok: false, reason: 'TOPOLOGY_EVENT_INVALID' }; },
   319	  });
