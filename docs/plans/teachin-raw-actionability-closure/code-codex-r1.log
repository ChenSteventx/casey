   326	// 真驱动的完整一步：resolve（铸一次性 authority）→ perform（消费）。
   327	async function driveOnce(topologyAuthority, event) {
   328	  const resolved = await canonicalRawPlaywrightDriver.resolve({
   329	    event,
   330	    topologyAuthority,
   331	    executionTargetAuthority: EXECUTION.authority,
   332	  });
   333	  if (!resolved || resolved.resolution !== 'unique' || !resolved.actionAuthority) {
   334	    return { resolved, performed: null };
   335	  }
   336	  const performed = await canonicalRawPlaywrightDriver.perform({
   337	    actionAuthority: resolved.actionAuthority,
   338	    topologyAuthority,
   339	    executionTargetAuthority: EXECUTION.authority,
   340	  });
   341	  return { resolved, performed };
   342	}
