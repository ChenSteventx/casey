   258	// 保真替身（G2 对账基准）：逐条复刻真控制器的可观测语义——
   259	// performClick 吞回调抛错、成功体无 value 键、键集与真控制器全等。
   260	function fidelityTopologyDouble(page) {
   261	  const authority = Object.freeze(Object.create(null));
   262	  const deny = (reason) => Object.freeze({ ok: false, reason, verdictHint: 'NEEDS_HUMAN' });
   263	  return Object.freeze({
   264	    activePageAuthority: () => authority,
   265	    async evaluateActive({ pageAuthority, evaluate } = {}) {
   266	      if (pageAuthority !== authority) return deny('PAGE_AUTHORITY_STALE');
   267	      if (typeof evaluate !== 'function') return Object.freeze({ ok: false, reason: 'PAGE_EVALUATION_INVALID' });
   268	      try {
   269	        return Object.freeze({ ok: true, reason: null, value: await evaluate(page) });
   270	      } catch {
   271	        return deny('PAGE_EVALUATION_FAILED');
   272	      }
   273	    },
   274	    async performClick({ pageAuthority, perform } = {}) {
   275	      if (pageAuthority !== authority) return deny('PAGE_AUTHORITY_STALE');
   276	      if (typeof perform !== 'function') return Object.freeze({ ok: false, reason: 'PAGE_ACTION_INVALID' });
   277	      let failed = false;
   278	      try {
   279	        // 回调返回值一律丢弃——这正是真控制器的行为，替身不得偷偷回传。
   280	        await perform(page);
   281	      } catch {
   282	        failed = true;
   283	      }
   284	      if (failed) return deny('PAGE_ACTION_FAILED');
   285	      return Object.freeze({
   286	        ok: true,
   287	        reason: null,
   288	        handoff: Object.freeze({ kind: 'none', candidateCount: 0 }),
   289	        activePageAuthority: authority,
   290	      });
   291	    },
   292	    async consumeNewPageEvent() { return deny('TOPOLOGY_EVENT_INVALID'); },
   293	  });
   294	}
