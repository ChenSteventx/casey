   390	function walkSources(dir, prefix, acc) {
   391	  for (const entry of readdirSync(dir, { withFileTypes: true })) {
   392	    const abs = join(dir, entry.name);
   393	    const rel = `${prefix}/${entry.name}`;
   394	    if (entry.isDirectory()) walkSources(abs, rel, acc);
   395	    else if (entry.isFile() && entry.name.endsWith('.mjs')) acc.push(rel);
   396	  }
   397	  return acc;
   398	}
