   368	function captureConsole(fn) {
   369	  const chunks = [];
   370	  const outWrite = process.stdout.write;
   371	  const errWrite = process.stderr.write;
   372	  process.stdout.write = (chunk) => { chunks.push(`out:${String(chunk)}`); return true; };
   373	  process.stderr.write = (chunk) => { chunks.push(`err:${String(chunk)}`); return true; };
   374	  const restore = () => { process.stdout.write = outWrite; process.stderr.write = errWrite; };
   375	  let value;
   376	  try {
   377	    value = fn();
   378	  } catch (error) {
   379	    restore();
   380	    throw error;
   381	  }
   382	  if (value && typeof value.then === 'function') {
   383	    return value.then((resolved) => { restore(); return { value: resolved, chunks }; },
   384	      (error) => { restore(); throw error; });
   385	  }
   386	  restore();
   387	  return Promise.resolve({ value, chunks });
   388	}
