   386	// 唯一 admission → runtime 编排边界：全包准入失败时 fresh factory 与全部 driver 调用数恒为零。
   387	export async function admitAndRunRawReplay(options = {}) {
   388	  let caseId;
   389	  let captureBytes;
   390	  let freshRuntimeFactory;
   391	  let topologyAuthority;
   392	  let executionTargetAuthority;
   393	  let actionDriver;
   394	  let eventObserver;
   395	  try {
   396	    if (!options || typeof options !== 'object') {
   397	      return denied('RAW_CAPTURE_INPUT_INVALID');
   398	    }
   399	    ({
   400	      caseId,
   401	      captureBytes,
   402	      freshRuntimeFactory,
   403	      topologyAuthority,
   404	      executionTargetAuthority,
   405	      actionDriver,
   406	      eventObserver,
   407	    } = options);
   408	  } catch {
   409	    return denied('RAW_CAPTURE_INPUT_INVALID');
   410	  }
   411	  const admitted = admitRawReplayCapture({ caseId, captureBytes });
   412	  if (admitted.ok !== true) return admitted;
   413	  if (typeof freshRuntimeFactory !== 'function') {
   414	    return denied('FRESH_RUNTIME_AUTHORITY_INVALID');
   415	  }
   416	  let created;
   417	  try {
   418	    created = await freshRuntimeFactory({ topologyAuthority });
   419	  } catch {
   420	    return denied('FRESH_RUNTIME_AUTHORITY_INVALID');
   421	  }
   422	  if (created?.ok !== true || !created.freshRuntimeAuthority) {
   423	    return denied(stableReason(created?.reason || 'FRESH_RUNTIME_AUTHORITY_INVALID'));
   424	  }
   425	  return runRawReplay({
   426	    captureAuthority: admitted.captureAuthority,
   427	    freshRuntimeAuthority: created.freshRuntimeAuthority,
   428	    topologyAuthority,
   429	    executionTargetAuthority,
   430	    actionDriver,
   431	    ...(eventObserver === undefined ? {} : { eventObserver }),
   432	  });
   433	}

