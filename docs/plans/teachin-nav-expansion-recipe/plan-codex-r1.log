    63	  }
    64	  if (!sameRows(source.terminalHardPredicates, distilled.terminalHardPredicates, ['ok'])) {
    65	    return 'TERMINAL_PREDICATE_MISMATCH';
    66	  }
    67	  for (const row of source.terminalHardPredicates) {
    68	    const verdict = source.intents.find((intent) => intent.intentId === row.intentId)?.verdict;
