    79	  if (source.entities.length !== distilled.entities.length) {
    80	    return distilled.entities.length < source.entities.length
    81	      ? 'ENTITY_EVIDENCE_MISSING' : 'ENTITY_MISMATCH';
    82	  }
    83	  if (!sameRows(source.entities, distilled.entities,
    84	    ['intentId', 'role', 'kind', 'identitySha256'])) {
    85	    return 'ENTITY_MISMATCH';
    86	  }
    87	  if (source.effects.length !== distilled.effects.length) {
    88	    return distilled.effects.length < source.effects.length
    89	      ? 'EFFECT_EVIDENCE_MISSING' : 'EFFECT_MISMATCH';
    90	  }
    91	  if (!sameRows(source.effects, distilled.effects,
    92	    ['intentId', 'effectClass', 'evidenceRefs', 'projectionSha256'])) {
