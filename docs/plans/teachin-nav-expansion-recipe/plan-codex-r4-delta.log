    `解析单元 atom 应为 nav.workflowManagement：${digest(resolution)}`);
  assert(unit.evidenceEventSeqs.join(',') === '1,2',
    `evidenceEventSeqs 必须精确覆盖两击 [1,2]：${digest(resolution)}`);
  assert(unit.resolution === 'known',
