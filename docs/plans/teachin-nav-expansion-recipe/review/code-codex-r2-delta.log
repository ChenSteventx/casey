   177	// source grant 只喂 axes/frozen verdict，atom grant 只喂现役 flow-bridge/compile。
   178	export function issueSourceSemanticGrant(options = {}) {
   179	  const record = readResolution(options, 'resolutionAuthority');
   180	  if (!record) return denied('RESOLUTION_AUTHORITY_INVALID');
   181	  if (record.sourceIssued) return denied('SOURCE_SEMANTIC_GRANT_INVALID');
   182	  record.sourceIssued = true;
   183	  const grant = frozen(Object.create(null));
   184	  SOURCE_GRANT_STATE.set(grant, { record, consumed: false });
   185	  return frozen({ ok: true, grant });
   186	}
   187	
   188	export function issueAtomRoundtripGrant(options = {}) {
   189	  const record = readResolution(options, 'resolutionAuthority');
   190	  if (!record) return denied('RESOLUTION_AUTHORITY_INVALID');
   191	  if (record.atomIssued) return denied('ATOM_ROUNDTRIP_GRANT_INVALID');
   192	  record.atomIssued = true;
   193	  const grant = frozen(Object.create(null));
   194	  ATOM_GRANT_STATE.set(grant, { record, consumed: false });
   195	  return frozen({ ok: true, grant });
   196	}
   197	
   198	function consumeGrant(state, grant) {
   199	  const entry = grant && typeof grant === 'object' ? state.get(grant) : null;
   200	  if (!entry || entry.consumed) return null;
   201	  entry.consumed = true;
   202	  return entry.record;
   203	}
   204	
   205	// 非消费式验真：source semantic completion 先核 binding 再消费，cross-pair 探针
   206	// 不得吃掉任一方 genuine grant。只暴露 caseId 与 capture 绑定，不泄 projection 内容。
   207	export function inspectSourceSemanticGrant(sourceSemanticGrant) {
   208	  const entry = sourceSemanticGrant && typeof sourceSemanticGrant === 'object'
   209	    ? SOURCE_GRANT_STATE.get(sourceSemanticGrant) : null;
   210	  if (!entry || entry.consumed) return null;
   211	  return frozen({
   212	    caseId: entry.record.caseId,
   213	    captureSha256: entry.record.captureSha256,
   214	  });
   215	}
   216	
   217	// 只供同进程 canonical 消费者：atom roundtrip 与 source semantic completion。
   218	export function consumeAtomRoundtripGrant(atomRoundtripGrant) {
   219	  return consumeGrant(ATOM_GRANT_STATE, atomRoundtripGrant);
   220	}
   221	
   222	export function consumeSourceSemanticGrant(sourceSemanticGrant) {
   223	  return consumeGrant(SOURCE_GRANT_STATE, sourceSemanticGrant);
   224	}

