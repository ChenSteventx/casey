   183	  const mappingCandidate = remapped.resolution.resolved.map((unit) => ({
   184	    intentId: unit.intentId,
   185	    atom: unit.atom,
   186	    params: structuredClone(unit.params),
   187	    evidenceEventSeqs: [...unit.evidenceEventSeqs],
   188	  }));
