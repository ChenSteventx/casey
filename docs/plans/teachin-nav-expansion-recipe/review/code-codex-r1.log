   208	  return Object.freeze({
   209	    ok: true,
   210	    plan: {
   211	      sourcePlan: {
   212	        pairId: `pair_${token}`,
   213	        testcase: paths.testcase,
   214	        expected: paths.expected,
   215	        expectedObligations,
   216	        sutBuildDigest,
   217	        channelProfileDigest,
   218	        identityProfileDigest: digestOf(Buffer.concat([
   219	          Buffer.from('identity-profile:', 'utf8'),
   220	          channelProfileBytes,
   221	        ])),
   222	        replayKernelDigest: digestOf(replayKernelBytes),
   223	        resetPlanDigest: digestOf('read-only-v1-reset-plan'),
   224	        sessionPolicyDigest: digestOf('fresh-login-session-v1'),
   225	        source: {
   226	          candidate: paths.testcase,
   227	          events: paths.capture,
   228	          entityLock: paths.entityLock,
   229	          runNamespace: `run_source_${token}`,
   230	        },
   231	      },
   232	      projection: {
   233	        mappingCandidate,
   234	        authoredTestCase: authored,
   235	      },
   236	      distilled: {
   237	        authoringRunNamespace: `run_authoring_${token}`,
   238	        runNamespace: `run_distilled_${token}`,
   239	      },
   240	    },
   241	  });
