   158	  } catch {
   159	    return denied('UNSAFE_DATA_SHAPE');
   160	  }
   161	  if (!Array.isArray(projection)) return denied('UNSAFE_DATA_SHAPE');
   162	  if (!isPlainRecord(registry) || !isPlainRecord(registry.atoms)) {
   163	    return denied('MAPPING_ATOM_UNKNOWN');
   164	  }
   165	
   166	  const recipes = collectRecipes(registry);
   167	  const businessEvents = projection.filter((event) => event.role === 'business');
   168	  // 守卫入参 fail-closed（时点必须在业务事件集算出之后、主循环之前）：非 Set 直接拒；
   169	  // 成员须正安全整数，且必须确实是本次投影里的业务事件 eventSeq。放行幽灵 seq 等于
   170	  // 调用方以为声明了绑定、守卫却全程空转——静默失守比早失败危险得多。
   171	  if (boundIntents !== undefined) {
   172	    if (!(boundIntents instanceof Set)) return denied('UNSAFE_DATA_SHAPE');
   173	    const businessSeqs = new Set(businessEvents.map((event) => event.eventSeq));
   174	    for (const seq of boundIntents) {
   175	      if (!Number.isSafeInteger(seq) || seq <= 0) return denied('UNSAFE_DATA_SHAPE');
   176	      if (!businessSeqs.has(seq)) return denied('UNSAFE_DATA_SHAPE');
   177	    }
   178	  }
   179	  const structural = projection.filter((event) => event.role === 'structural');
   180	  const resolved = [];
   181	  const pending = [];
   182	  let cursor = 0;
   183	  let mappingOrdinal = 0;
   184	
   185	  while (cursor < businessEvents.length) {
   186	    const hits = recipes.filter(
   187	      (recipe) => matchesAt(recipe, businessEvents, cursor, boundIntents),
   188	    );
   189	    const longest = hits.reduce(
   190	      (max, recipe) => Math.max(max, recipe.actions.length),
   191	      0,
   192	    );
   193	    const best = hits.filter((recipe) => recipe.actions.length === longest);
   194	    if (best.length === 1) {
   195	      const recipe = best[0];
   196	      const span = businessEvents.slice(cursor, cursor + recipe.actions.length);
   197	      mappingOrdinal += 1;
   198	      resolved.push(frozen({
   199	        mappingKey: `m${mappingOrdinal}`,
   200	        intentId: span[0].intentId,
   201	        atom: recipe.atom,
   202	        params: frozen(structuredClone(recipe.params)),
   203	        evidenceEventSeqs: frozen(span.map((event) => event.eventSeq)),
   204	        evidenceCompoundKeys: frozen(span.map((event) => event.compoundKey)),
   205	        resolution: 'known',
   206	        ruleId: recipe.ruleId,
   207	      }));
   208	      cursor += recipe.actions.length;
   209	      continue;
   210	    }
   211	
   212	    const event = businessEvents[cursor];
   213	    let reason;
   214	    if (best.length > 1) reason = 'KNOWN_RECIPE_AMBIGUOUS';
   215	    else if (SUPPORTED_ACTIONS.has(event.action)) reason = 'KNOWN_RECIPE_MISSING';
   216	    else reason = 'UNSUPPORTED_ACTION';
   217	    pending.push(frozen({
   218	      intentId: event.intentId,
   219	      compoundKey: event.compoundKey,
   220	      eventSeq: event.eventSeq,
   221	      action: event.action,
   222	      reason,
   223	    }));
   224	    cursor += 1;
   225	  }
   226	
   227	  const resolutionAuthority = frozen(Object.create(null));
   228	  const record = frozen({
   229	    recipes,
   230	    resolved: frozen(resolved),
   231	    pending: frozen(pending),
   232	    structural: frozen(structural),
   233	  });
   234	  RESOLUTION_STATE.set(resolutionAuthority, record);
   235	  return frozen({
   236	    ok: true,
   237	    atomResolutionAuthority: resolutionAuthority,
   238	    recipes,
   239	    resolved: record.resolved,
   240	    pending: record.pending,
   241	    structural: record.structural,
   242	  });
   243	}
