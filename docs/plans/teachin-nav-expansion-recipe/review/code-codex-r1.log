   151	export function resolveCaptureAtoms(options = {}) {
   152	  let projection;
   153	  let registry;
   154	  let boundIntents;
   155	  try {
   156	    if (!options || typeof options !== 'object') return denied('UNSAFE_DATA_SHAPE');
