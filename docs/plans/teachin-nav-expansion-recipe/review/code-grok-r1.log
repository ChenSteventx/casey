  function proj(events, intentIdBySeq) {
    const req = { capture: captureDoc(events) };
    if (intentIdBySeq !== undefined) req.intentIdBySeq = intentIdBySeq;
    const p = projectCaptureEvents(req);
    assert(p.ok, `proj fail ${JSON.stringify(p)}`);
    return p.projection;
