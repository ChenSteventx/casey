      assert(!merged, `out-of-slot text "${t}" must NOT match grouped recipe: ${JSON.stringify(r.resolved)}`);
    }
  });

  // --- A2: slot1 exact, slot0 wrong but slot0 text is substring of whitelist via includes misuse ---
  // matchesAt uses Array.includes exact equality, not string includes — probe
  check('槽 位 用  Array.includes 精 确 相 等 ， 非 字 符 串  includes', () => {
    const r = resolveCaptureAtoms({
      projection: proj([group(1, '进 入 智 能 应 用 '), item(2)]),
