    || !/^sha256:[a-f0-9]{64}$/.test(sutBuildDigest || '')
    || !Buffer.isBuffer(channelProfileBytes) || !Buffer.isBuffer(replayKernelBytes)) {
    return denied('CYCLE_PLAN_INVALID');
