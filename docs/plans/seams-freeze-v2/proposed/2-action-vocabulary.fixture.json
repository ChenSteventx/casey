{
  "schemaVersion": 1,
  "draft": true,
  "source": {
    "seam": "events.json",
    "enumPath": "casey/events.json#/definitions/event/properties/action/enum"
  },
  "entries": [
    {
      "action": "click",
      "label": "单击",
      "channels": [
        "web"
      ],
      "paramSchema": {
        "requiredEventFields": [],
        "optionalEventFields": [
          "semantic",
          "role",
          "accessibleName",
          "text",
          "fieldLabel",
          "fallbackCss",
          "nth"
        ],
        "locatorBinding": "required-anyOf",
        "constraintNote": "对齐 events.schema allOf：交互动作须落 semantic / role+accessibleName / text / fieldLabel / dropdownUnit 之一，禁纯坐标步。x/y 仅录制元数据。"
      },
      "coordinateFallback": {
        "allowed": false,
        "onlyVia": null,
        "note": "web 单击以语义定位器 + 点击身份门 为准；坐标兜底不允许。"
      },
      "threeAxisEvidence": {
        "actionAxis": {
          "performedGate": "点击身份门：过滤后 count===1 或点击后身份回读成立才置 actionPerformed=true。",
          "ambiguousSignal": "多匹配或坐标兜底点击 → AMBIGUOUS_ACTION。"
        },
        "assertionAxisFeeds": [
          "urlPathname",
          "textVisible",
          "countChange"
        ],
        "forensicsAxis": [
          "watchNetworkForensics 网络取证（response/requestfailed + 错误信封，按发起方归因）",
          "生命周期（pageerror / dialog）"
        ]
      },
      "driver": {
        "channelDriver": "web/_data_runner",
        "call": "findEvent → 语义定位器 click（点击身份门 包裹）"
      },
      "failClosed": {
        "whenUnsupported": "NEEDS_HUMAN",
        "needsHumanReason": "INDETERMINATE",
        "neverSubstitute": true,
        "neverSelfHeal": true
      },
      "golden": [
        "tests/_golden/p5-replay.golden.mjs",
        "tests/_golden/fixtures/p5/replay-cases.json"
      ]
    },
    {
      "action": "fill",
      "label": "填值",
      "channels": [
        "web"
      ],
      "paramSchema": {
        "requiredEventFields": [
          "value"
        ],
        "optionalEventFields": [
          "fieldLabel",
          "semantic",
          "required",
          "uniqueGuard",
          "fallbackCss",
          "nth"
        ],
        "locatorBinding": "required-anyOf",
        "constraintNote": "events.schema：fill 必带 value；交互定位 anyOf 同 click。value 含 uniqueName/ts 必模板化（{{uniqueName}}/{{ts}}），绝不冻字面量。"
      },
      "coordinateFallback": {
        "allowed": false,
        "onlyVia": null,
        "note": "目标字段经语义定位器唯一命中后填值；坐标兜底不允许。"
      },
      "threeAxisEvidence": {
        "actionAxis": {
          "performedGate": "定位经点击身份门唯一命中后写入，且写后值回读相符（与 inputReadback 同源证据）。",
          "ambiguousSignal": "目标字段多匹配或坐标兜底 → AMBIGUOUS_ACTION。"
        },
        "assertionAxisFeeds": [
          "inputReadback",
          "requiredFilled"
        ],
        "forensicsAxis": [
          "watchNetworkForensics 网络取证（输入触发的校验/查重请求）",
          "生命周期（pageerror / dialog）"
        ]
      },
      "driver": {
        "channelDriver": "web/_data_runner",
        "call": "findEvent → fill（value 模板实例化后写入）"
      },
      "failClosed": {
        "whenUnsupported": "NEEDS_HUMAN",
        "needsHumanReason": "INDETERMINATE",
        "neverSubstitute": true,
        "neverSelfHeal": true
      },
      "golden": [
        "tests/_golden/p5-replay.golden.mjs",
        "tests/_golden/fixtures/p5/replay-cases.json"
      ]
    },
    {
      "action": "selectOption",
      "label": "下拉选值",
      "channels": [
        "web"
      ],
      "paramSchema": {
        "requiredEventFields": [
          "dropdownUnit"
        ],
        "optionalEventFields": [
          "optionScope",
          "textOverride"
        ],
        "locatorBinding": "required-anyOf",
        "constraintNote": "events.schema：selectOption 必带 dropdownUnit（三要素 fieldLabel/optionText/scope 非空），dropdownUnit 本身满足交互定位 anyOf。"
      },
      "coordinateFallback": {
        "allowed": false,
        "onlyVia": null,
        "note": "下拉语义单元定位选项，坐标兜底不允许。"
      },
      "threeAxisEvidence": {
        "actionAxis": {
          "performedGate": "下拉语义单元三要素定位唯一，选中后选项值回读相符（与 dropdownReadback 同源证据）。",
          "ambiguousSignal": "scope 或 optionText 多匹配 → AMBIGUOUS_ACTION。"
        },
        "assertionAxisFeeds": [
          "dropdownReadback"
        ],
        "forensicsAxis": [
          "watchNetworkForensics 网络取证（选项加载/联动请求）",
          "生命周期（pageerror / dialog）"
        ]
      },
      "driver": {
        "channelDriver": "web/_data_runner",
        "call": "findEvent → selectOption（dropdownUnit 语义单元）"
      },
      "failClosed": {
        "whenUnsupported": "NEEDS_HUMAN",
        "needsHumanReason": "INDETERMINATE",
        "neverSubstitute": true,
        "neverSelfHeal": true
      },
      "golden": [
        "tests/_golden/p5-replay.golden.mjs",
        "tests/_golden/fixtures/p5/replay-cases.json"
      ]
    },
    {
      "action": "press",
      "label": "按键",
      "channels": [
        "web"
      ],
      "paramSchema": {
        "requiredEventFields": [
          "key"
        ],
        "optionalEventFields": [],
        "locatorBinding": "none",
        "constraintNote": "events.schema：press 必带 key（如 Enter）；press 不受交互定位 anyOf 约束——作用于当前聚焦目标，不解析新元素。"
      },
      "coordinateFallback": {
        "allowed": false,
        "onlyVia": null,
        "note": "press 无定位需求，作用于当前聚焦目标；坐标兜底不适用。"
      },
      "threeAxisEvidence": {
        "actionAxis": {
          "performedGate": "keydown 在当前聚焦目标派发成功（无点击身份门，press 不解析新元素）。",
          "ambiguousSignal": "无聚焦目标时绝不静默成功，落 NEEDS_HUMAN。"
        },
        "assertionAxisFeeds": [
          "streamReplyReceived",
          "urlPathname",
          "textVisible"
        ],
        "forensicsAxis": [
          "watchNetworkForensics 网络取证（Enter 提交/发消息触发的请求与流式响应）",
          "生命周期（pageerror / dialog）"
        ]
      },
      "driver": {
        "channelDriver": "web/_data_runner",
        "call": "page.keyboard.press(key)"
      },
      "failClosed": {
        "whenUnsupported": "NEEDS_HUMAN",
        "needsHumanReason": "INDETERMINATE",
        "neverSubstitute": true,
        "neverSelfHeal": true
      },
      "golden": [
        "tests/_golden/p5-replay.golden.mjs",
        "tests/_golden/fixtures/p5/replay-cases.json"
      ]
    }
  ]
}
