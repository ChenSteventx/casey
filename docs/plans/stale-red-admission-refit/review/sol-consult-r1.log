    87	
    88	// 破坏性硬闸（前缀参数化）—— 独立于状态机：凡带 entityNameParam 的原子，不论注册表有无 states
    89	// 都强制实体名非空且带注入前缀（护栏 #14 fail-closed，防误删真实数据/污染共享环境）。
    90	// 真异构评审 B4/B5（2026-06-29 codex gpt-5.5）：原先此闸裹在 checkStateMachine 里、只在 registry.states
    91	//   存在时才跑 —— 无 states 注册表会把整条破坏性硬闸静默绕过；且空/缺实体名旧版直接放行。皆属最危险 fail-open。
    92	export function checkDestructivePrefix(flow, reg, prefix) {
    93	  const problems = [];
    94	  const atomDefs = reg.atoms ?? {};
    95	  flow.steps.forEach((step, i) => {
    96	    const def = atomDefs[step.atom];
    97	    if (!def || !def.entityNameParam) return;
    98	    if (typeof prefix !== 'string' || prefix.trim() === '') {
    99	      // startsWith('') 恒真会把硬闸静默清零 —— 前缀缺失/为空一律拒。
   100	      problems.push(`step[${i}] (${step.atom})：破坏性硬闸前缀缺失/为空，拒绝放行（uniquePrefix 必须是非空字符串）`);
   101	      return;
   102	    }
   103	    const v = (step.params ?? {})[def.entityNameParam];
   104	    if (typeof v !== 'string' || v.trim() === '') {
   105	      // 空/缺实体名无从证明带前缀 —— fail-closed，绝不放行破坏性原子。
   106	      problems.push(`step[${i}] (${step.atom})：破坏性原子实体名「${def.entityNameParam}」缺失/为空，拒绝放行（须非空且带前缀「${prefix}」）`);
   107	    } else if (!v.startsWith(prefix)) {
   108	      // output-seal A13：实体名值原值不回显（flow confirm 后可编辑、值可携任意内容），step 序号 + 前缀留定位。
   109	      problems.push(`step[${i}] (${step.atom})：实体名必须带前缀「${prefix}」（破坏性硬闸，防误删真实数据/污染环境；原值不回显）`);
   110	    }
   111	  });
   112	  return problems;
   113	}
   114	
   115	// 三闸合一：闸一(结构) → 破坏性前缀硬闸(不依赖 states、永远跑) →（注册表 v2 含 states 时）状态机。
   116	// 前缀从参数注入、非写死。破坏性闸独立确保无 states 注册表也挡得住裸名/空名破坏性原子（B4/B5）。
   117	export function validateDraft(draft, { prefix, registry, initialStates } = {}) {
   118	  const problems = validateStructural(draft, registry);
   119	  if (problems.length === 0 && registry) {
   120	    problems.push(...checkDestructivePrefix(draft, registry, prefix));
   121	    if (registry.states) problems.push(...checkStateMachine(draft, registry, initialStates));
   122	  }
   123	  return { ok: problems.length === 0, problems };
   124	}

