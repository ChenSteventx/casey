   558	async function compileAtomStep(run, { atom, params = {} }) {
   559	  if (atom === 'login') { run.notes.push('login 原子由登录预备动作承接，不产 event（凭据红线，护栏 #7）'); return; }
   560	  if ((atom && atom.startsWith('assert.')) || NAMED_ASSERTION_ATOMS.has(atom)) {
   561	    // 断言原子不产 event：折进所在 intent 作 P4 草拟输入（G7-3 取 A，意图留痕）。
   562	    run.assertionAtoms.push({ intentId: run.lastIntentId, atom, params });
   563	    return;
   564	  }
