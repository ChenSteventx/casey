    69	    const reprStepId = reprStepOf.get(iid);
    70	    const eventActions = es.map((e) => ({ stepId: e.stepId, action: actionByStep.get(e.stepId) || { resolution: 'none' } }));
    71	    const stepIds = new Set(es.map((e) => e.stepId));
    72	    const net = records.filter((r) => r.firingStepId != null && stepIds.has(r.firingStepId)).map((r) => projectNet(r, reprStepId));
