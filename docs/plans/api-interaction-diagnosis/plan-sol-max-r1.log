    93	      records: f.records() || [],
    94	      pageErrors: Array.isArray(runtime.pageErrors) ? runtime.pageErrors.slice() : [],
    95	    };
    96	  }
    97	  if (f && Array.isArray(f.network)) {
    98	    const pe = Array.isArray(f.lifecycle?.pageerror) ? f.lifecycle.pageerror : [];
    99	    return { records: f.network, pageErrors: pe };
   100	  }
   101	  return { records: [], pageErrors: [] };
   102	}
   103	
   104	/** 真回放一遍已晋升的 spec，产 axes 全文（不裁定；裁定归冻结裁判）。 */
   105	export async function replayPromotedSpec({ runtime, caseId, eventsDoc, expectedDoc }) {
   106	  const page = runtime.page;
   107	  const ctx = {
   108	    uniqueName: 'r1',
   109	    baseUrl: '',
   110	    profile: {},
   111	    admitReplayActionOrigin: typeof runtime.originAdmission === 'function'
   112	      ? runtime.originAdmission : null,
   113	  };
