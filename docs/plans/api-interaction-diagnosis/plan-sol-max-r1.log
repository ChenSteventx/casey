    86	export async function waitReplyStable(page, selector, {
    87	  stableMs = 2000,
    88	  budgetMs = 10000,
    89	} = {}) {
    90	  const startedAt = Date.now();
    91	  let previous = null;
    92	  let unchangedSince = Date.now();
    93	  while (Date.now() - startedAt < budgetMs) {
    94	    let current = null;
    95	    try {
    96	      const locator = page.locator(selector).last();
    97	      current = (await locator.count()) ? await locator.innerText({ timeout: 500 }) : null;
    98	    } catch {
    99	      current = null;
   100	    }
   101	    if (current !== previous) {
   102	      previous = current;
   103	      unchangedSince = Date.now();
   104	    } else if (current != null && Date.now() - unchangedSince >= stableMs) {
   105	      return current;
   106	    }
   107	    await new Promise((resolve) => setTimeout(resolve, 250));
   108	  }
   109	  return previous;
   110	}
