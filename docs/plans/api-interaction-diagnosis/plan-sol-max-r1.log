   170	    }
   171	  }
   172	
   173	  const snapshot = forensicsSnapshot(runtime);
   174	  return projectReplayAxes({
   175	    caseId,
   176	    records: snapshot.records,
   177	    intentOrder,
   178	    intentEvents,
   179	    reprStepOf,
   180	    actionByStep,
   181	    pageErrors: snapshot.pageErrors,
   182	    intentCount,
   183	    expectedByIntent,
   184	    globalAssertions,
   185	    intentUrl,
   186	    intentToasts,
   187	    intentTextHits,
   188	    intentButtonHits,
   189	    intentButtonSeen,
   190	    intentButtonDisabledHits,
   191	    intentReply,
   192	    intentInputReadback,
   193	    chatCfg: null,
   194	    allStepIds: new Set(events.map((e) => e.stepId)),
   195	  });
   196	}
