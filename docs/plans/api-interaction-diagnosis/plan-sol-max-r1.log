    67	  // 同源+method+规范化 pathname+查询参数命中的请求投影有界三元组喂外部账本回调；完整响应体
    68	  // 仅瞬时解析、不进 records（数据最小化，sol P1-6）。不静态引入身份模块（毒探针面）。
    69	  const idSeqByRequestId = new Map();
    70	  let idSeqCounter = 0;
