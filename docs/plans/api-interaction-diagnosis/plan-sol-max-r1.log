    10	export class ReplayFinalizeAbort extends Error {
    11	  constructor(reason, exitCode = 1) {
    12	    super(reason);
    13	    this.name = 'ReplayFinalizeAbort';
    14	    this.reason = reason;
    15	    this.exitCode = exitCode;
    16	  }
    17	}
    18	
    19	async function finalizeVideo({
    20	  args,
    21	  context,
    22	  loginPage,
    23	  page,
    24	  sweepVideos,
    25	}) {
    26	  if (!args.videoDir) return false;
    27	  const loginVideo = loginPage ? loginPage.video() : null;
    28	  const replayVideo = page.video();
    29	  try {
    30	    await context.close();
    31	  } catch {
    32	    // Video is diagnostic-only; absence remains acceptable.
    33	  }
    34	  if (loginVideo) {
    35	    let deleted = false;
    36	    for (let attempt = 0; attempt < 2 && !deleted; attempt += 1) {
    37	      try {
    38	        await loginVideo.delete();
    39	        deleted = true;
    40	      } catch {
    41	        // One bounded retry.
    42	      }
    43	    }
    44	    if (!deleted) throw new ReplayFinalizeAbort('LOGIN_VIDEO_DELETE_FAILED');
    45	  }
    46	  let videoOk = false;
    47	  try {
    48	    const rawPath = replayVideo ? await replayVideo.path() : null;
    49	    if (rawPath) {
    50	      renameSync(rawPath, join(args.videoDir, 'video.webm'));
    51	      videoOk = true;
    52	    }
    53	  } catch {
    54	    videoOk = false;
    55	  }
    56	  if (!videoOk) sweepVideos();
    57	  return videoOk;
    58	}
    59	
    60	function assertCredentialSafe(outputs, reason) {
    61	  if (!credentialGate(outputs).ok) throw new ReplayFinalizeAbort(reason);
    62	}
    63	
    64	export async function finalizeReplayArtifacts({
    65	  args,
    66	  context,
    67	  loginPage,
    68	  page,
    69	  sweepVideos,
    70	  caseId,
    71	  records,
    72	  loginMark,
    73	  intentOrder,
    74	  intentEvents,
    75	  reprStepOf,
    76	  expectedByIntent,
    77	  globalAssertions,
    78	  allStepIds,
    79	  pageErrors,
    80	  guardAborts,
    81	  evidence,
    82	  videoStartedAt,
    83	  runStartedAt,
    84	  log,
    85	}) {
    86	  const videoOk = await finalizeVideo({
    87	    args,
    88	    context,
    89	    loginPage,
    90	    page,
    91	    sweepVideos,
    92	  });
    93	  const allRecords = records.slice(loginMark);
    94	  const partitioned = partitionGuardAbortPageErrors({ pageErrors, guardAborts });
    95	  if (partitioned.excluded.length) {
    96	    log(`guard-abort causal exclusion: ${partitioned.excluded.length}`);
    97	  }
    98	  const axesText = projectReplayAxes({
    99	    caseId,
   100	    records: allRecords,
   101	    intentOrder,
   102	    intentEvents,
   103	    reprStepOf,
   104	    actionByStep: evidence.actionByStep,
   105	    pageErrors: partitioned.kept,
   106	    intentCount: evidence.intentCount,
   107	    expectedByIntent,
   108	    globalAssertions,
   109	    intentUrl: evidence.intentUrl,
   110	    intentToasts: evidence.intentToasts,
   111	    intentTextHits: evidence.intentTextHits,
   112	    intentButtonHits: evidence.intentButtonHits,
   113	    intentButtonSeen: evidence.intentButtonSeen,
   114	    intentButtonDisabledHits: evidence.intentButtonDisabledHits,
   115	    intentReply: evidence.intentReply,
   116	    intentInputReadback: evidence.intentInputReadback,
   117	    chatCfg: evidence.chatCfg,
   118	    allStepIds,
   119	  });
   120	  assertCredentialSafe({ 'axes.json': axesText }, 'AXES_CREDENTIAL_GATE_REJECTED');
   121	  writeFileSync(args.out, axesText, 'utf8');
   122	
   123	  if (evidence.historyEnabled) {
   124	    const denominator = evidence.historyLines.filter(
   125	      (line) => line.locatorResolution !== null,
   126	    );
   127	    const metrics = {
   128	      schemaVersion: 1,
   129	      caseId,
   130	      runId: args.runId || null,
   131	      totalSteps: evidence.historyLines.length,
   132	      passedActions: evidence.historyLines.filter((line) => line.result === 'ok').length,
