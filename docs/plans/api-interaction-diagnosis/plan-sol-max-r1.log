   150	    if (args.runHistory) {
   151	      writeFileSync(args.runHistory, outputs['run-history.jsonl'], 'utf8');
   152	    }
   153	    if (args.runMetrics) {
   154	      writeFileSync(args.runMetrics, outputs['run-metrics.json'], 'utf8');
   155	    }
   156	  }
   157	
   158	  if (args.videoDir && videoOk) {
   159	    const videoText = `${JSON.stringify({
   160	      schemaVersion: 1,
   161	      file: 'video.webm',
   162	      startedAt: videoStartedAt,
   163	      steps: evidence.videoSteps,
   164	    }, null, 2)}\n`;
   165	    if (!videoText.includes('://')) {
   166	      assertCredentialSafe({ 'video.json': videoText }, 'VIDEO_CREDENTIAL_GATE_REJECTED');
   167	      writeFileSync(join(args.videoDir, 'video.json'), videoText, 'utf8');
   168	    }
   169	  }
   170	  return { videoOk };
   171	}

