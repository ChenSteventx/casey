   180	// ── selftest tier1：hermetic 链路自检 ─────────────────────────
   181	function selftestTier1() {
   182	  console.log(col(C.bold, '\ncasey selftest --tier1 —— hermetic 链路自检（零外部依赖）\n'));
   183	  let ok = true;
   184	  const step = (name, fn) => {
   185	    try { const pass = fn(); ok = ok && pass; console.log(`${pass ? col(C.green, 'ok  ') : col(C.red, 'RED ')} ${name}`); }
   186	    catch (e) { ok = false; console.log(`${col(C.red, 'RED ')} ${name} —— ${e.message}`); }
   187	  };
   188	
   189	  // 1. 统一语言：注册表完整（白名单方向）
   190	  step('统一语言注册表完整（term-lint --registry exit 0）', () => runNode(kit('term-lint.mjs'), ['--registry'], { quiet: true }).code === 0);
   205	  step('质量门禁消费 1-story 契约并翻绿（gate exit 0 + passes 翻 true）', () => {
   206	    const tmp = path.join(CASES_DIR, '_selftest'); fs.mkdirSync(tmp, { recursive: true });
   207	    const prd = path.join(tmp, 'prd-_selftest.json');
   208	    fs.writeFileSync(prd, JSON.stringify({
   209	      schemaVersion: 1,
   210	      task: 'tier1 自检：可执行规格 exit 0 即翻绿',
   211	      stories: [{ id: 'tier1', desc: 'hermetic 自检 story', lane: 'implementation', acceptance: ['node -e "process.exit(0)"'], passes: false }],
   212	      testChecksums: {},
   213	    }, null, 2), 'utf8');
   214	    const code = runNode(kit('gate.mjs'), ['--prd', 'cases/_selftest/prd-_selftest.json'], { quiet: true }).code;
   215	    const flipped = JSON.parse(fs.readFileSync(prd, 'utf8')).stories[0].passes === true;
   216	    return code === 0 && flipped;
   217	  });
   218	
   219	  // 5. 裁判零 LLM（护栏 #15，I1）：verdict.mjs 依赖闭包无 LLM/网络客户端（model-lane-guard 契约）
   220	  step('裁判零 LLM：verdict.mjs 闭包无 LLM/网络客户端（verdict-purity-guard exit 0）', () =>
   221	    runNode(path.join(PROJECT_ROOT, 'bin', 'verdict-purity-guard.mjs'),
   222	      ['--entry', path.join(PROJECT_ROOT, 'bin', 'verdict.mjs')], { quiet: true }).code === 0);
