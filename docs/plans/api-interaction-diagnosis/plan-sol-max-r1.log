   316	/**
   317	 * 逐步全拒时的单值 reason（D7 把 exit 4 切成两种，不得混用）：
   318	 *   干净全 PASS 案 → NO_HARNESS_ERROR_STEPS（唯一字面）；
   319	 *   其余 → 逐步具名拒因清单，reason 取最具体的那条（非「本来就不该自愈」的那条优先）。
   320	 */
   321	function summarizeReason(verdict, rejections) {
   322	  if (verdict.steps.every((s) => s.verdict === 'PASS')) return HEAL_REJECT.NO_HARNESS_ERROR_STEPS;
   323	  const specific = rejections.find((r) => r.reason !== HEAL_REJECT.VERDICT_NOT_HARNESS_ERROR);
   324	  return specific ? specific.reason : HEAL_REJECT.VERDICT_NOT_HARNESS_ERROR;
   325	}
