   203	    if (!Array.isArray(pageErrors)) return;
   204	    pageErrors.push({
   205	      attributedStepId: options?.currentStep?.() ?? null,
   206	      message: String(error?.message || error).slice(0, 200),
   207	    });
   208	  });
   209	  return Object.freeze({
   210	    ok: true,
   211	    reason: null,
   212	    watcher: watchNetworkForensics(cdp, options),
   213	  });
   214	}
