    28	export function createExclusiveRunDir(caseId, { attempts = 8 } = {}) {
    29	  const parent = join(PROJECT_ROOT, 'runs', caseId);
    30	  mkdirSync(parent, { recursive: true });
    31	  for (let i = 0; i < attempts; i++) {
    32	    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\./g, '');
    33	    const runId = `run_tier2_${stamp}_${randomBytes(3).toString('hex')}`;
    34	    const abs = join(parent, runId);
    35	    try {
    36	      mkdirSync(abs, { recursive: false }); // 已存在即抛（排他创建，绝不复用）
