   162	  const videoMetaPath = path.join(runDir, 'video.json');
   163	  if (!opts['no-video'] && fs.existsSync(videoMetaPath)) rmArgs.push('--video-meta', videoMetaPath);
   164	  stage('报表模型装配', bin('report-model.mjs'), rmArgs);
   165	  // 回放诊断呈现（report-diagnostics 路 B）：相3 恒产两旁件于本 runDir，相6 传路径进呈现层——仅诊断不进裁定。
   166	  stage('相6 report 报告', bin('report.mjs'), ['--model', modelOut, '--out', runDir,
   167	    '--run-history', path.join(runDir, 'run-history.jsonl'), '--run-metrics', path.join(runDir, 'run-metrics.json')]);
   168	
   169	  const videoNote = fs.existsSync(path.join(runDir, 'video.webm')) ? ' / video.webm / video.json' : '';
