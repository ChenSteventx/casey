    14	export function checkErrorEnvelope(body, { successField, successValue } = {}) {
    15	  // fail-closed：成功字段名缺失/空白/敏感 一律不放行（护栏 #14/#7）。
    16	  if (typeof successField !== 'string' || successField.trim() === '' || SENSITIVE_FIELD.test(successField)) {
    17	    return { field: typeof successField === 'string' ? successField : null, expected: successValue, actual: undefined, ok: false };
    18	  }
    19	  // 真异构评审 B6（2026-06-29 codex gpt-5.5）：缺 successValue 配置、或 body 缺该字段时，
    20	  //   原版 actual===undefined===successValue 会假判 ok:true（把软失败信封洗成正常）。配置/字段不全一律 fail-closed。
    21	  if (successValue === undefined) {
    22	    return { field: successField, expected: successValue, actual: undefined, ok: false };
    23	  }
    24	  const present = body != null && Object.prototype.hasOwnProperty.call(body, successField);
    25	  const actual = present ? body[successField] : undefined;
    26	  return { field: successField, expected: successValue, actual, ok: present && actual === successValue };
