   127	 */
   128	export function applyLocatorToEvent(event, locatorAfter) {
   129	  const withinValue = nonEmptyStr(locatorAfter.within) ? locatorAfter.within : null;
   130	  const nextRole = nonEmptyStr(locatorAfter.role) ? locatorAfter.role : null;
   131	  const nextName = nonEmptyStr(locatorAfter.accessibleName) ? locatorAfter.accessibleName : null;
   132	  const out = {};
   133	  for (const key of Object.keys(event)) {
   134	    if (key === 'semantic' && isObj(event.semantic) && event.semantic.kind === 'role') {
   135	      const s = {};
   136	      for (const k of Object.keys(event.semantic)) {
   137	        if (k === 'role' && nextRole !== null) s.role = nextRole;
   138	        else if (k === 'name' && nextName !== null) s.name = nextName;
   139	        else s[k] = event.semantic[k];
   140	      }
   141	      out.semantic = s;
   142	      continue;
   143	    }
   144	    if (key === 'role' && nextRole !== null) { out.role = nextRole; continue; }
   145	    if (key === 'accessibleName' && nextName !== null) { out.accessibleName = nextName; continue; }
   146	    if (key === 'within') {
   147	      if (withinValue !== null) out.within = withinValue;
   148	      continue;
   149	    }
   150	    out[key] = event[key];
   151	  }
   152	  if (withinValue !== null && !Object.prototype.hasOwnProperty.call(out, 'within')) {
   153	    out.within = withinValue;
   154	  }
   155	  return out;
   156	}
   157	
   158	/** 候选文档：逐键搬运原文档，只替换 events[eventIndex]（其余字节与次序一字不动）。 */
   159	export function buildCandidateDoc(eventsDoc, eventIndex, locatorAfter) {
   160	  const out = {};
   161	  for (const key of Object.keys(eventsDoc)) {
   162	    if (key !== 'events') { out[key] = eventsDoc[key]; continue; }
   163	    out.events = eventsDoc.events.map((ev, i) => (
   164	      i === eventIndex ? applyLocatorToEvent(ev, locatorAfter) : ev
   165	    ));
   166	  }
   167	  return out;
   168	}
   169	
   170	/**
   171	 * S4 主入口：校签 → 校底座 → 校锚位 → 产候选旁文件 → 自证原 events 未动。
   172	 *
   173	 * 回 { candidatePath, candidateSha256, eventsPath, eventsSha256, stepId, eventIndex }。
   174	 * 任一闸不过抛 HealApplyError（调用方按 kind 落退出码）。
   175	 */
   176	export function applySignedPatch({ outDir, caseId, patch, tsToken }) {
   177	  validatePatchShape(patch, caseId);
   178	  requireSignedPatch(patch);
   179	
   180	  // ② 底座闸：补丁只能改本 case 的 events（路径事实源 = lib/paths.mjs）。
   181	  const eventsPath = resolve(patch.specTarget.eventsPath);
   182	  const canonicalEvents = resolve(casePaths(caseId).events);
   183	  if (eventsPath !== canonicalEvents) {
   184	    throw new HealApplyError(APPLY_REJECT.SPEC_TARGET_MISMATCH,
   185	      '补丁 specTarget.eventsPath 不是本 case 的 events（路径不回显），拒改');
   186	  }
   187	  if (!existsSync(eventsPath)) {
   188	    throw new HealApplyError(APPLY_REJECT.SPEC_TARGET_MISMATCH, 'events 底座不在场');
   189	  }
   190	  const eventsSha256Before = sha256File(eventsPath);
   191	  let eventsDoc;
   192	  try {
   193	    eventsDoc = JSON.parse(readFileSync(eventsPath, 'utf8'));
   194	  } catch {
   195	    throw new HealApplyError(APPLY_REJECT.PATCH_INVALID, 'events 不是合法 JSON（内容不回显）');
   196	  }
   197	  if (!isObj(eventsDoc) || !Array.isArray(eventsDoc.events) || eventsDoc.events.length === 0) {
   198	    throw new HealApplyError(APPLY_REJECT.PATCH_INVALID, 'events 须为 { caseId, events:[非空] }');
   199	  }
   200	  if (nonEmptyStr(patch.specTarget.fingerprintBefore)
   201	    && patch.specTarget.fingerprintBefore !== fingerprintOf(eventsDoc)) {
   202	    throw new HealApplyError(APPLY_REJECT.SPEC_BASE_DRIFTED,
   203	      '签后 events 底座指纹已变（recordedAt/length 不符），须重生补丁');
   204	  }
   205	
   206	  // ③ 锚位闸：目标事件必须在原位、且现役定位仍等于 locatorBefore。
   207	  const idx = patch.specTarget.eventIndex;
   208	  const target = eventsDoc.events[idx];
   209	  if (!isObj(target) || target.stepId !== patch.stepId) {
   210	    throw new HealApplyError(APPLY_REJECT.SPEC_TARGET_MISMATCH,
   211	      `events[${idx}] 不是补丁的目标步 ${patch.stepId}`);
   212	  }
   213	  const before = currentLocatorOf(target);
   214	  const wantRole = nonEmptyStr(patch.locatorBefore.role) ? patch.locatorBefore.role : null;
   215	  const wantName = nonEmptyStr(patch.locatorBefore.accessibleName)
   216	    ? patch.locatorBefore.accessibleName : null;
   217	  if ((wantRole !== null && before.role !== wantRole)
   218	    || (wantName !== null && before.accessibleName !== wantName)) {
   219	    throw new HealApplyError(APPLY_REJECT.SPEC_TARGET_MISMATCH,
   220	      '目标步现役定位与补丁 locatorBefore 不符（补丁不是给这份字节的）');
   221	  }
   222	
   223	  const candidateDoc = buildCandidateDoc(eventsDoc, idx, patch.locatorAfter);
   224	  const candidateText = eventsText(candidateDoc);
   225	  if (candidateText === eventsText(eventsDoc)) {
   226	    // 与现役字节等价 = 无可自愈之处（D7 归「无一步可自愈」语义，绝不产 no-op 候选）。
   227	    throw new HealApplyError(APPLY_REJECT.REANCHOR_NOOP,
   228	      '重锚后候选与现役 events 字节等价，无可应用的定位漂移', 'noop');
   229	  }
   230	
   231	  const driftDir = driftDirOf(outDir);
   232	  mkdirSync(driftDir, { recursive: true });
   233	  const candidatePath = candidatePathOf(driftDir, caseId, tsToken);
   234	  writeFileSync(candidatePath, candidateText, 'utf8');
   235	
   236	  // 非就地自证：应用全程原 events 一个字节都不许动（护栏 #5）。
   237	  if (sha256File(eventsPath) !== eventsSha256Before) {
   238	    throw new HealApplyError(APPLY_REJECT.EVENTS_MUTATED,
   239	      '应用过程中原 events 字节发生变化（非就地纪律被破坏），fail-closed');
   240	  }

