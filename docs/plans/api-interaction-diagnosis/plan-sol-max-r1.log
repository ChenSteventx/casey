   115	  const events = eventsDoc.events;
   116	  const intentOrder = [];
   117	  const intentEvents = new Map();
   118	  for (const ev of events) {
   119	    if (!intentEvents.has(ev.intentId)) { intentEvents.set(ev.intentId, []); intentOrder.push(ev.intentId); }
   120	    intentEvents.get(ev.intentId).push(ev);
   121	  }
   122	  const reprStepOf = new Map(intentOrder.map((iid) => [iid, intentEvents.get(iid).slice(-1)[0].stepId]));
   123	  const expectedByIntent = new Map((expectedDoc.intents || []).map((it) => [
   124	    it.intentId, (it.expected || []).map((a) => projectReplayAssertion(a, ctx)),
   125	  ]));
   126	  const globalAssertions = (expectedDoc.globalAssertions || []).map((a) => projectReplayAssertion(a, ctx));
   127	
   128	  const actionByStep = new Map();
   129	  const intentUrl = new Map();
   130	  const intentCount = new Map();
   131	  const intentToasts = new Map();
   132	  const intentTextHits = new Map();
   133	  const intentButtonHits = new Map();
   134	  const intentButtonSeen = new Map();
   135	  const intentButtonDisabledHits = new Map();
   136	  const intentInputReadback = new Map();
   137	  const intentReply = new Map();
   138	  const countSelector = '.hr-table-row';
   139	
   140	  for (const ev of events) {
   141	    const isFirst = intentEvents.get(ev.intentId)[0].stepId === ev.stepId;
   142	    const isLast = reprStepOf.get(ev.intentId) === ev.stepId;
   143	    if (isFirst) {
   144	      const baseline = await captureIntentObservationBaseline({
   145	        page, countSelector, chat: null, replySelector: null,
   146	      });
   147	      intentCount.set(ev.intentId, { before: baseline.count, after: null });
   148	    }
   149	    actionByStep.set(ev.stepId, await dispatchHealAction(bound, ev));
   150	    if (isLast) {
   151	      const assertions = [...(expectedByIntent.get(ev.intentId) || []), ...globalAssertions];
   152	      const terminal = await captureIntentObservationTerminal({
   153	        page, countSelector, chat: null, replySelector: null, replyBaseline: null,
   154	        assertions, buttons: null,
   155	      });
   156	      intentUrl.set(ev.intentId, terminal.url);
   157	      const count = intentCount.get(ev.intentId);
   158	      if (count) count.after = terminal.count;
   159	      intentToasts.set(ev.intentId, terminal.toasts);
   160	      intentTextHits.set(ev.intentId, terminal.textHits);
   161	      if (terminal.buttonObservation) {
   162	        intentButtonHits.set(ev.intentId, terminal.buttonObservation.buttonHits);
   163	        intentButtonDisabledHits.set(ev.intentId, terminal.buttonObservation.buttonDisabledHits);
   164	        if (terminal.buttonObservation.buttonSeen != null) {
   165	          intentButtonSeen.set(ev.intentId, terminal.buttonObservation.buttonSeen);
   166	        }
   167	      }
   168	      intentInputReadback.set(ev.intentId, inputReadbackFromAction(actionByStep.get(ev.stepId)));
