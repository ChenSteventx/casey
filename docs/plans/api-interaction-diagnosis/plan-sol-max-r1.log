     7	// 任何 CDP 调用都套有界超时——getResponseBody 对流式/已逐出响应可能永不 resolve，会拖死 drain()。
     8	const withTimeout = (pr, ms) => Promise.race([Promise.resolve(pr).catch(() => null), new Promise((r) => setTimeout(() => r(null), ms))]);
