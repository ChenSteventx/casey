    10	      malformed = true;
    11	      continue;
    12	    }
    13	    counts[verdict] += 1;
    14	  }
    15	  return {
    16	    counts,
    17	    total: steps.length,
    18	    allPass: !malformed && steps.length > 0 && counts.PASS === steps.length,
    19	    malformed,
    20	  };
