   363	    const p = emitReceipt({
   364	      outcome: 'reverify-routed-human',
   365	      route: 'human',
   366	      reason: REVERIFY_REJECT.RESET_PROOF_ABSENT,
   367	      note: '未证明本用例可复位/幂等，整案重放不安全；本轮不跑复核、不产任何合成裁定（D3/D6）。',
