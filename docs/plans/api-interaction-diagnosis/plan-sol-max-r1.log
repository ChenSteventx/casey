    10	// ── 身份通道纯函数面（agent-id-readback；导出供零 SUT 金牌钉验，watchNetworkForensics 内联消费）──
    11	const IDENTITY_BODY_MAX = 256 * 1024;
    12	const walkIdentityPath = (obj, dotted) => String(dotted).split('.').reduce((acc, key) => (acc && typeof acc === 'object' ? acc[key] : undefined), obj);
    13	
    14	// 请求准入判据（codex R1-H2）：同源（sutOrigin 精确等）+ method + 规范化 pathname 精确等 + 按剖面
    15	// queryParam 提取查询回声。任一不符回 null（不入身份通道）；url 不可解析同 null（fail-safe）。
    16	export function matchIdentityRequest(url, method, { channel, sutOrigin } = {}) {
    17	  if (!channel || typeof channel !== 'object') return null;
    18	  let parsed = null;
    19	  try { parsed = new URL(url); } catch { return null; }
    20	  if (typeof sutOrigin !== 'string' || sutOrigin === '' || parsed.origin !== sutOrigin) return null;
    21	  if (method !== channel.method) return null;
    22	  if (parsed.pathname !== channel.pathname) return null;
    23	  return {
    24	    urlPathname: parsed.pathname,
    25	    urlOrigin: parsed.origin,
    26	    queryEcho: typeof channel.queryParam === 'string' && channel.queryParam !== ''
    27	      ? parsed.searchParams.get(channel.queryParam)
    28	      : null,
    29	  };
    30	}
    31	
    32	// 响应投影判据（codex R1-H4）：HTTP 只认明确成功态（2xx）；剖面 successField 在响应体内在场时
    33	// 必须严格等于 successValue，否则 failed——HTTP 200 的 API 失败信封绝不得当成功身份页消费。
    34	export function projectIdentityEnvelope(text, status, { channel, successField, successValue } = {}) {
    35	  if (!Number.isInteger(status) || status < 200 || status >= 300) return { kind: 'failed' };
    36	  if (typeof text !== 'string' || Buffer.byteLength(text, 'utf8') > IDENTITY_BODY_MAX) return { kind: 'invalid' };
    37	  let obj = null;
    38	  try { obj = JSON.parse(text); } catch { return { kind: 'invalid' }; }
    39	  if (successField != null && obj && typeof obj === 'object' && !Array.isArray(obj)
    40	    && Object.prototype.hasOwnProperty.call(obj, successField) && obj[successField] !== successValue) {
    41	    return { kind: 'failed' };
    42	  }
    43	  const rawRows = walkIdentityPath(obj, channel.recordsPath);
    44	  const total = walkIdentityPath(obj, channel.totalPath);
    45	  if (!Array.isArray(rawRows)) return { kind: 'invalid' };
    46	  const f = channel.fields;
    47	  const rows = rawRows.map((row) => (row && typeof row === 'object' && !Array.isArray(row)
    48	    ? { id: row[f.id], code: row[f.code], name: row[f.name] }
    49	    : { id: null, code: null, name: null }));
    50	  const out = { kind: 'parsed', rows, total };
    51	  if (channel.hasNextPath != null) out.hasNext = walkIdentityPath(obj, channel.hasNextPath);
    52	  return out;
    53	}
