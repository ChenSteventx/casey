   189	// ── 通过标准（D3 codex delta）────────────────────────────────────────────────
   190	/** 目标步 PASS ∧ 全案无非目标步「绿→非绿」新回归。 */
   191	export function judgeReverification({ baseline, current, stepId }) {
   192	  const before = new Map((baseline.steps || []).map((s) => [s.stepId, s.verdict]));
   193	  const after = new Map((current.steps || []).map((s) => [s.stepId, s.verdict]));
   194	  const targetBefore = before.get(stepId) ?? null;
   195	  const targetAfter = after.get(stepId) ?? null;
   196	  const regressions = [];
   197	  for (const [sid, was] of before) {
   198	    if (sid === stepId) continue;
   199	    const now = after.has(sid) ? after.get(sid) : null;
   200	    if (was === 'PASS' && now !== 'PASS') regressions.push({ stepId: sid, before: was, after: now });
   201	  }
   202	  return {
   203	    passed: targetAfter === 'PASS' && regressions.length === 0,
   204	    targetStep: { stepId, before: targetBefore, after: targetAfter },
   205	    regressions,
   206	  };
   207	}
   208	
   209	// ── journal ↔ receipt 互绑（D13 codex 8）──────────────────────────────────────
   210	const bareSha = (v) => (typeof v === 'string' ? v.replace(/^sha256:/, '') : null);
   211	
   212	/** 任一面对不上 → 畸形面 fail-closed（exit 65）：不在无绑定的账上跑回滚。 */
   213	export function assertJournalReceiptBound({ journal, receipt, receiptPath }) {
   214	  const bad = (detail) => {
   215	    throw new HealReverifyError(REVERIFY_REJECT.JOURNAL_RECEIPT_UNBOUND, detail);
   216	  };
   217	  const rj = bareSha(receipt.journalSha256);
   218	  const rc = bareSha(receipt.journalCoreSha256);
   219	  const jr = bareSha(journal.receiptSha256);
   220	  if (!rj || !rc || !jr) bad('journal/receipt 缺互绑哈希字段（journalSha256/journalCoreSha256/receiptSha256）');
   221	  if (rj !== bareSha(journal.sealedJournalSha256)) {
   222	    bad('receipt 记的封账 journal 哈希与 journal 自记的不一致');
   223	  }
   224	  if (rc !== journalCoreSha256(journal)) {
   225	    bad('receipt 记的事务核哈希与现役 journal 现算的核哈希不一致（journal 内容被改）');
   226	  }
   227	  if (jr !== sha256File(receiptPath)) {
   228	    bad('journal 记的 receipt 内容哈希与 receipt 文件实际字节不一致（收据被改）');
   229	  }
   230	}
   231	
   232	// ── 基线绑定复验（D14 ②）──────────────────────────────────────────────────────
   233	/**
   234	 * 先验哈希再用：读一次基线 verdict 字节 → 比 journal 不可变核冻的哈希 → 才拿来当对照底座。
   235	 * 无绑定 / 件缺席 / 字节被换一律畸形面 fail-closed（exit 65），绝不在可疑基线上判「无新回归」。
   236	 */
   237	export function admitBaselineVerdict({ journal, baselinePath }) {
   238	  const want = bareSha(journal?.baseline?.verdictSha256);
   239	  if (!want) {
   240	    throw new HealReverifyError(REVERIFY_REJECT.BASELINE_UNBOUND,
   241	      'journal 不可变核未冻结基线 verdict 绑定，拒在无绑定的基线上判「有无非目标步新回归」');
   242	  }
   243	  if (!existsSync(baselinePath)) {
   244	    throw new HealReverifyError(REVERIFY_REJECT.BASELINE_MISSING, 'heal 前基线 verdict.json 不在场');
   245	  }
   246	  const bytes = readFileSync(baselinePath);
   247	  if (createHash('sha256').update(bytes).digest('hex') !== want) {
   248	    throw new HealReverifyError(REVERIFY_REJECT.BASELINE_UNBOUND,
   249	      '基线 verdict 当下字节与晋升时冻进 journal 核的绑定不一致（提案后基线被替换），拒复核');
   250	  }
   251	  try {
   252	    const doc = JSON.parse(bytes.toString('utf8'));
   253	    if (!isObj(doc)) throw new Error('non-object');
   254	    return doc;
   255	  } catch {
   256	    throw new HealReverifyError(REVERIFY_REJECT.BASELINE_MISSING,
   257	      'heal 前基线 verdict.json 不是合法 JSON 对象（内容不回显）');
   258	  }
   259	}
   260	
   261	// ── 编排主入口 ───────────────────────────────────────────────────────────────
   262	/**
   263	 * 回 { outcome, exitCode:0, receiptPath, ... }：
   264	 *   'reverified' / 'reverify-routed-human' / 'reverify-failed-rolled-back'（D7 六值全集之三）。
   265	 * 拒绝路径抛 HealReverifyError（kind → 65/6）。
   266	 */
   267	export async function runReverify({ outDir, caseId, receiptPath, tsToken, seamPath }) {
   268	  // D13 ②：hermetic 门禁是**第一道**闸——生产调用（无 seam）连收据都不该读，直接 exit 64
   269	  // 具名说明「v1 复核仅 hermetic，真机复核 route:human」，不留任何走到裁定面的路径。
   270	  const admittedSeam = admitReverifySeam({ seamPath });
