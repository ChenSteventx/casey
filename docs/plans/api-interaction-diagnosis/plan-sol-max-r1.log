    18	
    19	// ── 真回放：现役共用身份门 + 现役语义定位 + 现役只读漂移探针 ─────────────────
    20	// D13 ①：复核的定位面**只**走现役 `compile-atoms-support::locatorFor`（与回放消费面
    21	// `lib/replay-actions.mjs::semanticLocator` 逐字同形）。`within` 在这里一个字都不读——
    22	// 生产回放不读它，复核多读一个键就等于「复核比生产强」，那种绿不能代表回放会绿。
    23	// 候选文件里的 `within` 仍在（人签绑定的字节差 + 前向兼容注记），只是无人消费。
    24	async function resolveHealCandidate({ event, runtime }) {
    25	  const { page } = runtime;
    26	  const locator = locatorFor(page, event);
    27	  if (!locator) return { count: 0 };
    28	  try { await locator.first().waitFor({ state: 'attached', timeout: 1200 }); } catch { /* 缺席由 count 如实反映 */ }
    29	  let n = 0;
    30	  try { n = await locator.count(); } catch { n = 0; }
    31	  if (n !== 1) return { count: n };
    32	  return { count: 1, candidate: { locator: locator.first(), page }, pageAuthority: page };
    33	}
    34	
    35	// 无 ElementHandle 提供者时只可确证「该 locator 当刻仍恰解析到一个节点」，与现役 generic
    36	// 路径的同名分支（lib/replay-actions.mjs::revalidateFormalCandidate）逐字同语义。
    37	async function revalidateHealCandidate({ candidate, pageAuthority }) {
    38	  if (candidate.page !== pageAuthority) return null;
    39	  let candidateCount = 0;
    40	  try { candidateCount = await candidate.locator.count(); } catch { return null; }
    41	  const unique = candidateCount === 1;
    42	  return { connected: unique, sameNode: unique, candidateCount, ownerMatches: true };
    43	}
    44	
    45	async function performHealCandidate({ candidate, event, runtime }) {
    46	  const loc = candidate.locator;
    47	  try {
    48	    if (event.action === 'click') await loc.click({ timeout: 2000 });
    49	    else if (event.action === 'dblclick') await loc.dblclick({ timeout: 2000 });
    50	    else if (event.action === 'fill') await loc.fill(instantiate(event.value, runtime.ctx), { timeout: 2000 });
    51	    else if (event.action === 'press') await loc.press(event.key || 'Enter', { timeout: 2000 });
    52	    else return false;
    53	    return true;
    54	  } catch { return false; }
    55	}
    56	
    57	async function admitHealOrigin({ runtime }) {
    58	  const admit = runtime.ctx?.admitReplayActionOrigin;
    59	  if (typeof admit !== 'function') return true;
    60	  try { return await admit(runtime.page) === true; } catch { return false; }
    61	}
    62	
    63	async function probeHealDrift({ event, runtime }) {
    64	  return findEquivalentAffordance(runtime.page, event.atom, event.targetName);
    65	}
    66	
    67	const healActionGate = createActionAuthorityGate({
