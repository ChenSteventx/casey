   122	}
   123	
   124	// ── 运行时来源（可注入接缝）──────────────────────────────────────────────────
   125	function pickOpenRuntime(mod) {
   126	  if (typeof mod?.openRuntime === 'function') return mod.openRuntime;
   127	  if (typeof mod?.createRuntimeBootstrap === 'function') {
   128	    const built = mod.createRuntimeBootstrap({});
   129	    if (typeof built?.openRuntime === 'function') return built.openRuntime;
   130	  }
   131	  if (typeof mod?.default?.openRuntime === 'function') return mod.default.openRuntime;
   132	  return null;
   133	}
   134	
   135	/**
   136	 * hermetic 专用门（D13 ②）。回接缝的绝对路径；两种不合格一律 kind='usage' → exit 64：
   137	 *   · 无 seam = 生产调用 —— v1 复核只做 hermetic，真机复核 route:human；
   138	 *   · seam 解析后越出本仓 tests/ —— 拒载（门禁形与冻结金牌兼容：金牌 seam 即在 tests/ 下）。
   139	 * 路径判定按目录前缀比较（`tests` + 分隔符），杜绝 `tests-evil/` 这类同前缀旁目录蒙混。
   140	 */
   141	export function admitReverifySeam({ seamPath }) {
   142	  if (!nonEmptyStr(seamPath)) {
   143	    throw new HealReverifyError(REVERIFY_REJECT.HERMETIC_ONLY,
   144	      'v1 复核仅 hermetic：须经 CASEY_HEAL_RUNTIME_SEAM 注入本仓 tests/ 下的运行时接缝；'
   145	      + '真机复核在 v1 一律 route:human（GRILL D13 ②，与 S0 热路径证伪、D3 变更型自洽）',
   146	      'usage');
   147	  }
   148	  // 先解析真实路径再判门禁：只比 resolve() 的话，tests/ 下挂一枚指向仓外的符号链接就能绕过。
   149	  // 门禁基准同样取真实路径（仓自身若落在链接下，两边一起归一才比得准）。
   150	  let abs = resolve(seamPath);
   151	  try { abs = realpathSync(abs); } catch { /* 件不在场：留 resolve 值，后面的加载会闭合拒 */ }
   152	  let root = PROJECT_ROOT;
   153	  try { root = realpathSync(PROJECT_ROOT); } catch { /* 仓根不可解析时退回原值 */ }
   154	  const gate = join(root, 'tests') + sep;
   155	  if (!abs.startsWith(gate)) {
   156	    throw new HealReverifyError(REVERIFY_REJECT.SEAM_OUT_OF_TREE,
   157	      'CASEY_HEAL_RUNTIME_SEAM 解析后的绝对路径不在本仓 tests/ 目录下，拒载（路径不回显）',
   158	      'usage');
   159	  }
   160	  return abs;
   161	}
   162	
   163	/** 打开复核运行时：只认过门禁的 hermetic 接缝，生产真浏览器链路在 v1 不接。 */
   164	export async function openReverifyRuntime({ seamPath }) {
   165	  const abs = admitReverifySeam({ seamPath });
   166	  let mod;
   167	  try {
   168	    mod = await import(pathToFileURL(abs).href);
   169	  } catch {
   170	    throw new HealReverifyError(REVERIFY_REJECT.RUNTIME_UNAVAILABLE, '复核运行时接缝模块不可加载');
   171	  }
   172	  const open = pickOpenRuntime(mod);
   173	  if (!open) {
   174	    throw new HealReverifyError(REVERIFY_REJECT.RUNTIME_UNAVAILABLE, '接缝模块未导出 openRuntime');
   175	  }
   176	  const opened = await open({ role: 'distilled', executionTargetAuthority: null });
   177	  if (opened?.ok !== true || !isObj(opened.runtime)) {
   178	    throw new HealReverifyError(REVERIFY_REJECT.RUNTIME_UNAVAILABLE, '接缝运行时未开成');
   179	  }
   180	  return opened.runtime;
   181	}
   182	
   183	async function closeRuntime(runtime) {
   184	  for (const owner of [runtime?.context, runtime?.browser]) {
   185	    try { await owner?.close?.(); } catch { /* 关闭失败不改判定 */ }
   186	  }
   187	}
