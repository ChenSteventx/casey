   216	export function createPageForensicsHub({
   217	  context,
   218	  options = {},
   219	  pageErrors,
   220	} = {}) {
   221	  const watchers = [];
   222	  const attached = new WeakSet();
   223	  let identitySequence = 0;
   224	  const sharedOptions = {
   225	    ...options,
   226	    identitySequence: () => {
   227	      identitySequence += 1;
   228	      return identitySequence;
   229	    },
   230	  };
   231	  const attachForensics = async ({ page } = {}) => {
   232	    if (!page || typeof page !== 'object' || attached.has(page)) return;
   233	    const attachedPage = await attachPageForensics({
   234	      context,
   235	      page,
   236	      options: sharedOptions,
   237	      pageErrors,
   238	    });
   239	    if (!attachedPage.ok) {
   240	      const failure = new Error('PAGE_FORENSICS_ATTACH_FAILED');
   241	      failure.reason = 'PAGE_FORENSICS_ATTACH_FAILED';
   242	      throw failure;
   243	    }
   244	    attached.add(page);
   245	    watchers.push(attachedPage.watcher);
   246	  };
   247	  return Object.freeze({
   248	    attachPageForensics: attachForensics,
   249	    forensics: Object.freeze({
   250	      records: () => watchers.flatMap((watcher) => watcher.records()),
   251	      inFlightCount: () => watchers.reduce(
   252	        (total, watcher) => total + watcher.inFlightCount(),
   253	        0,
   254	      ),
   255	      awaitStreamsSettled: async (ms) => {
   256	        await Promise.all(watchers.map(
   257	          (watcher) => watcher.awaitStreamsSettled(ms),
   258	        ));
   259	      },
   260	      drain: async () => {
   261	        await Promise.all(watchers.map((watcher) => watcher.drain()));
   262	      },
   263	    }),
   264	  });
   265	}
