    78	    channel: identityChannel, successField, successValue,
    79	  });
    80	  let streamOpen = 0;        // 在途 SSE 流计数（finished 前）
    81	  const settleWaiters = [];  // 等所有流 finished 的 resolver
    82	  const inFlightApi = new Set(); // 在途前台 API 请求（requestWillBeSent 到 loadingFinished/Failed 之间），drain 据此等齐
    83	  const isBg = (url) => denylist.some((d) => url.includes(d));
    84	
    85	  cdp.on('Network.requestWillBeSent', (e) => {
    86	    const url = e.request.url;
    87	    const firing = currentStep ? currentStep() : null;
    88	    const initiator = (e.initiator && e.initiator.type) || null;
    89	    const type = e.type || null;
    90	    // 正向归因：仅 script/XHR/Fetch/EventSource 这类用户动作触发的 API 才系到本步；
    91	    // 背景 denylist、文档导航、非脚本发起、无活动步 → 一律 null（默认 null 是 fail-safe 物理落点，绝不默认成最近步）。
    92	    if (type === 'EventSource') streamOpen++;
    93	    if ((type === 'XHR' || type === 'Fetch') && !isBg(url)) inFlightApi.add(e.requestId);
    94	    const isApi = type === 'XHR' || type === 'Fetch' || type === 'EventSource' || (initiator === 'script' && type !== 'Document');
    95	    const attributedStepId = isBg(url) || !firing || !isApi ? null : firing;
    96	    const rec = { requestId: e.requestId, url, method: e.request.method, status: null, ts: e.timestamp, initiator, type, firingStepId: firing, attributedStepId, errorEnvelope: null, streamFinished: undefined, streamStatus: undefined };
    97	    byReq.set(e.requestId, rec);
    98	    records.push(rec);
    99	    if (identityChannel) {
   100	      const matched = matchIdentityRequest(url, rec.method, { channel: identityChannel, sutOrigin: identityChannel.sutOrigin });
   101	      if (matched) {
   102	        const requestSeq = nextIdentitySequence();
   103	        idSeqByRequestId.set(e.requestId, requestSeq);
