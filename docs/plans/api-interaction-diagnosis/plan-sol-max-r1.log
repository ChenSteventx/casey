   338	    const p = reverifyReceiptPathOf(driftDir, caseId, tsToken);
   339	    const text = jsonText({
   340	      schemaVersion: 1,
   341	      artifactKind: 'heal-receipt',
   342	      kind: 'reverify',
   343	      caseId,
   344	      stepId: receipt.stepId,
   345	      tsToken: String(tsToken),
   346	      at,
   347	      promoteReceiptPath: resolve(receiptPath),
   348	      journalPath,
   349	      ...body,
   350	    });
