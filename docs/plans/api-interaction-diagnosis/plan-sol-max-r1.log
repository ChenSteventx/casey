   185	export async function attachPageForensics({
   186	  context,
   187	  page,
   188	  options,
   189	  pageErrors,
   190	} = {}) {
   191	  if (!context || typeof context.newCDPSession !== 'function'
   192	    || !page || typeof page.on !== 'function') {
   193	    return Object.freeze({ ok: false, reason: 'PAGE_FORENSICS_ATTACH_FAILED' });
   194	  }
