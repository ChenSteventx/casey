   224	  // 清理临时产物
   225	  try { fs.rmSync(path.join(CASES_DIR, '_selftest'), { recursive: true, force: true }); } catch { /* ignore */ }
   226	
   227	  console.log('');
   228	  if (ok) { console.log(col(C.green, 'selftest --tier1: 全链路 GREEN —— 确定性内核 + 统一语言双向有效。')); process.exit(0); }
   229	  console.log(col(C.red, 'selftest --tier1: 有红 —— 确定性内核未就绪。')); process.exit(1);
   230	}
