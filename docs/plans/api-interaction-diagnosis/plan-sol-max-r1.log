   232	// ── selftest tier2：真机冒烟自检【壳层】（p9-tier2-live-smoke，GRILL D3）────
   233	// 壳层只三件事：①严格解析用参（用法错先于任何环境采集与任何连接判定 → 64）②采集 + 逐例走生产
   234	// run 同链、落 receipt ③把结构化结果喂纯层 lib/selftest-tier2.mjs，按纯层退出码退出。
   235	// 判定逻辑与全部文案常量都在纯层，壳层一个判据都不自造（防两处漂移）。
   236	// 退出方式（联审 r1 M2）：一律写完再设 process.exitCode 自然返回——
   237	// stdout 是管道时 process.exit() 会截断待写数据，那样「尾行不可旁路」这条就成了空话。
   238	function writeOutSync(text) {
   239	  fs.writeSync(1, text.endsWith('\n') ? text : `${text}\n`);
   240	}
   241	async function selftestTier2(rest) {
   242	  const { prepareTier2, executeTier2, renderTier2Result } = await import('../lib/selftest-tier2-collect.mjs');
   243	  const prepared = prepareTier2(rest);
   244	  if (!prepared.ok) {
   245	    // 拒付回执零回显原始值（M1）：只出稳定码、参数序号与脱敏类别，安全形状 caseId 才列出；
   246	    // 且这几行已在 prepareTier2 里逐行过完凭据封印（形状安全但恰为真实敏感值的也不放行）。
   247	    fs.writeSync(2, `${col(C.red, '\n[selftest --tier2] 用参错误 → 拒跑(64)')}\n${prepared.refusalLines.join('\n')}\n`
   248	      + '用法：casey selftest --tier2 --sut <隧道回环基址> [--case <manifest 成员 id> ...] [--authorize-mutation <变更型成员 id> ...]\n');
   249	    process.exitCode = 64;
   250	    return;
   251	  }
   252	  writeOutSync(col(C.bold, '\ncasey selftest --tier2 —— 真机冒烟自检（机器面）\n'));
   253	  const { result, consumerProblems, judgeEvidence } = await executeTier2(prepared);
   254	  // 渲染在壳层模块内成文（含尾行常量透传 TIER2_MACHINE_GREEN_TAIL 的单一事实源），出口过凭据兜底密封。
   255	  const rendered = renderTier2Result({ result, consumerProblems, judgeEvidence });
   256	  writeOutSync(rendered.text);
   257	  if (result.exitCode === 0 && !rendered.text.includes(TIER2_MACHINE_GREEN_TAIL)) {
   258	    writeOutSync(TIER2_MACHINE_GREEN_TAIL); // 尾行不可旁路：渲染若丢了它，这里同步补写
   259	  }
   260	  process.exitCode = result.exitCode;
   261	}
