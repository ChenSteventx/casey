   279	    releasePromoteLock(lockPath);
   280	  }
   281	}
   282	
   283	/** 锁面统一：拿不到锁沿用晋升面既有拒因语义（LOCK_BUSY/LOCK_STALE/LOCK_UNAVAILABLE）→ exit 6。 */
   284	function acquireReverifyLock(caseDir) {
