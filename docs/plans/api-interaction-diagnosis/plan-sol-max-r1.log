   196	  try {
   197	    cdp = await context.newCDPSession(page);
   198	    await cdp.send('Network.enable');
   199	  } catch {
   200	    return Object.freeze({ ok: false, reason: 'PAGE_FORENSICS_ATTACH_FAILED' });
   201	  }
