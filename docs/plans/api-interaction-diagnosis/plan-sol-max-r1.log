   137	    if (r.code !== 0) {
   138	      console.error(col(C.red, `[run] 阶段「${label}」非零退出（${r.code}）→ fail-closed`));
   139	      if (r.stderr) console.error(col(C.gray, r.stderr.slice(-600)));
   140	      process.exit(normCode(r.code));
