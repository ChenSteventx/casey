   290	  }
   291	}
   292	
   293	async function runReverifyUnderLock({ outDir, caseId, receiptPath, tsToken, admittedSeam }) {
   294	  const driftDir = driftDirOf(outDir);
   295	  mkdirSync(driftDir, { recursive: true });
   296	  const at = isoOf(tsToken);
   297	  const receipt = readJsonOr(resolve(receiptPath), REVERIFY_REJECT.RECEIPT_INVALID, 'HealReceipt');
   298	  if (receipt.artifactKind !== 'heal-receipt' || receipt.caseId !== caseId
   299	    || receipt.outcome !== 'promoted' || !nonEmptyStr(receipt.stepId)
   300	    || !nonEmptyStr(receipt.journalPath)) {
   301	    throw new HealReverifyError(REVERIFY_REJECT.RECEIPT_INVALID,
   302	      'HealReceipt 不是本 case 的已晋升收据（artifactKind/caseId/outcome/stepId/journalPath 须齐全）');
   303	  }
   304	  const journalPath = resolve(receipt.journalPath);
   305	  const journal = readJournal(journalPath);
   306	  if (journal.status !== 'promoted' || journal.sealed !== true) {
   307	    throw new HealReverifyError(REVERIFY_REJECT.PROMOTION_NOT_IN_FORCE,
