   206	// ── receipt 归类（五类 + 一致性判据；plan §1.3）─────────────────
   207	export function classifyTier2Receipt({ projected, timedOut, systemicCode, childExitCode, exitCodeLegend }) {
   208	  const problems = [];
   209	  if (timedOut) return { receiptClass: 'timeout', problems: ['超出用例声明超时'] };
   210	  if (systemicCode) return { receiptClass: 'systemic_abort', problems: [`系统性前置闸拒付：${systemicCode}`] };
   211	
   212	  const exitInLegend = Number.isInteger(childExitCode) && (exitCodeLegend || []).includes(childExitCode);
   213	  if (!exitInLegend) problems.push(`子进程退出码不在归一图例内（${childExitCode}）`);
   214	  if (projected.staleArtifacts.length) problems.push(`产物早于本次启动（疑复用旧件）：${projected.staleArtifacts.join('/')}`);
   215	  // 生产 run 契约只有两种「管线跑完」形态（联审 r2 H5 残口：此前只封 0/1，
   216	  //   2/3/64 配齐全产物照样被当管线完成）：0 ⇔ 全 PASS；1 ⇔ 合法的非全 PASS。其余退出码一律不是管线完成。
   217	  if (childExitCode === 0 && projected.allPass !== true) problems.push('子进程 exit 0 但裁定非全 PASS（自相矛盾）');
   218	  else if (childExitCode === 1 && projected.allPass === true) problems.push('子进程 exit 1 但裁定全 PASS（自相矛盾）');
   219	  else if (childExitCode !== 0 && childExitCode !== 1) {
   220	    problems.push(`子进程退出码 ${childExitCode} 不属管线完成态（只认 0⇔全 PASS、1⇔合法非全 PASS）`);
   221	  }
   222	  if (!projected.verdictWellFormed) problems.push('裁定产物不合法或含四态外标签');
   223	  if (!projected.attachmentsComplete) {
   224	    const missing = Object.entries(projected.attachments).filter(([, v]) => !v).map(([k]) => k);
   225	    problems.push(`附件集不完整：缺 ${missing.join('/')}`);
   226	  }
   227	
   228	  if (!problems.length) return { receiptClass: 'pipeline_complete_with_verdict', problems };
   229	  if (projected.someArtifacts) return { receiptClass: 'partial_artifacts', problems };
   230	  return { receiptClass: 'stage_failed', problems };
   231	}
   200	    problems,
   201	  };
   202	}
