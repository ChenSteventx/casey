   113	    if (missing.length) {
   114	      console.error('缺失项：');
   115	      for (const m of missing) console.error(`  - ${m}`);
   116	    }
   117	    console.error('LLM 前段(相0-2 ingest/compile/draft/sign)未建、route:human；确定性尾段用法：');
   118	    console.error('  casey run <caseId> --sut <本地基址> [--events <f>] [--expected <f>] [--entity-locks <f>] [--profile <f>] [--observed <f>] [--generated-at <iso>] [--case-meta <f>] [--run-dir <dir>] [--unique-name <token>] [--login-bootstrap] [--no-video]');
