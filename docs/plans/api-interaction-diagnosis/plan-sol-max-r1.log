   370	  }
   371	
   372	  // 真 replay → 真 verdict（运行时只来自已过门禁的 hermetic 接缝）。
   373	  const runtime = await openReverifyRuntime({ seamPath: admittedSeam });
   374	  let axesText;
   375	  try {
   376	    axesText = await replayPromotedSpec({ runtime, caseId, eventsDoc, expectedDoc });
