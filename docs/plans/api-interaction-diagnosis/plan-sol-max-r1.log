    51	export const REVERIFY_REJECT = {
    52	  RECEIPT_INVALID: 'HEAL_RECEIPT_INVALID',
    53	  PROMOTION_NOT_IN_FORCE: 'HEAL_PROMOTION_NOT_IN_FORCE',
    54	  FROZEN_CONTRACT_UNSIGNED: 'HEAL_FROZEN_CONTRACT_UNSIGNED',
    55	  RESET_PROOF_ABSENT: 'HEAL_RESET_PROOF_ABSENT',
    56	  RESET_PROOF_INVALID: 'HEAL_RESET_PROOF_INVALID',
    57	  RUNTIME_UNAVAILABLE: 'HEAL_REVERIFY_RUNTIME_UNAVAILABLE',
    58	  REPLAY_FAILED: 'HEAL_REVERIFY_REPLAY_FAILED',
    59	  VERDICT_FAILED: 'HEAL_REVERIFY_VERDICT_FAILED',
    60	  BASELINE_MISSING: 'HEAL_BASELINE_VERDICT_MISSING',
    61	  BASELINE_UNBOUND: 'HEAL_BASELINE_VERDICT_UNBOUND',
    62	  HERMETIC_ONLY: 'HEAL_REVERIFY_HERMETIC_ONLY',
    63	  SEAM_OUT_OF_TREE: 'HEAL_REVERIFY_SEAM_OUT_OF_TREE',
