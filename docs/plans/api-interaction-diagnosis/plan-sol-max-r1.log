   491	    lines.push('## 工作流画布结构');
   492	    lines.push(`- 节点：${w.hasNodes ? '✓' : '✗'} · 连线：${w.hasConnection ? '✓' : '✗'} · 节点配置：${w.hasNodeConfig ? '✓' : '✗'}`);
   493	    lines.push(w.structureComplete ? '- 画布结构三类操作均已验证通过（节点/连线/节点配置）；开始/结束节点身份未单独区分。' : '- 画布结构不完整——空或半成工作流不得算满足验收（report-spec #11）。');
   494	  }
   495	  for (const g of groupSteps(steps)) {
   496	    lines.push('');
   497	    lines.push(`## ${VERDICT_ZH[g.verdict] || g.verdict}（${g.items.length}）`);
   498	    g.items.forEach((s) => {
   499	      lines.push('');
   500	      lines.push(stepMd(s));
   501	      const rows = diag.byIntent.get(s.intentId);
   502	      if (rows && rows.length) {
   503	        lines.push(`- 回放诊断（本步 event 逐行 · ${DIAG_NOTE}）：`);
   504	        rows.forEach((l) => lines.push(historyLineMd(l)));
   505	      }
   506	    });
   507	  }
   508	  if (diag.any) {
   509	    const m = diag.metrics;
   510	    lines.push('');
   511	    lines.push(`## 回放诊断（${DIAG_NOTE}）`);
   512	    if (m) {
   513	      lines.push(`- 运行 \`${diagScalar(m.runId ?? '—')}\` · 步数 ${diagScalar(m.totalSteps)} · 动作成功 ${diagScalar(m.passedActions)}`
   514	        + ` · 定位命中率 ${m.locatorHitRate == null ? '—' : `${Math.round(m.locatorHitRate * 100)}%`}`
   515	        + ` · 静默点等待 ${fmtMs(m.quietPointWaitMs)} · 总耗时 ${fmtMs(m.totalDurationMs)}`);
   516	    }
   517	    if (diag.orphan.length) {
   518	      lines.push(`- 未归属（${diag.orphan.length}）：`);
   519	      diag.orphan.forEach((l) => lines.push(historyLineMd(l)));
   520	    }
   521	  }
   522	  lines.push('');
   523	  return lines.join('\n');
   524	}
