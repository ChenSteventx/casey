   538	    verdictSummary: model.verdictSummary,
   539	    steps: (model.steps || []).map((s) => ({
   540	      stepId: s.stepId,
   541	      intentId: s.intentId,
   542	      atom: s.atom,
   543	      verdict: s.verdict,
   544	      reason: s.reason ?? null,
   545	      hasDefectTicket: s.defectTicket != null,
   546	      assertions: (s.postAssertions || []).map((a) => ({ kind: a.kind, op: a.op, value: a.value, actual: a.actual, ok: a.ok, soft: a.soft })),
   547	    })),
   548	  };
   549	  if ('naturalLanguage' in model) projection.naturalLanguage = model.naturalLanguage ?? null;
   550	  if (Array.isArray(model.atomicSteps)) projection.atomicSteps = model.atomicSteps;
   551	  if ('replayVideo' in model) projection.replayVideo = model.replayVideo ?? null;
   552	  if (Array.isArray(model.artifacts)) projection.artifacts = model.artifacts;
   553	  if ('visualReview' in model) projection.visualReview = model.visualReview ?? null;
   554	  if (Array.isArray(model.cleanupEvidence)) projection.cleanupEvidence = model.cleanupEvidence;
   555	  if ('workflowStructure' in model) projection.workflowStructure = model.workflowStructure ?? null;
