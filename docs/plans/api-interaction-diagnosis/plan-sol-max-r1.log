   317	  // D14 ②：跑复核**之前**先验基线字节仍是晋升时冻的那一份；验过的字节直接留作对照底座。
   318	  const baselinePath = baselineVerdictPathOf(paths.dir);
   319	  const baseline = admitBaselineVerdict({ journal, baselinePath });
   320	  const eventsPath = resolve(paths.events);
   321	  const eventsDoc = readJsonOr(eventsPath, REVERIFY_REJECT.RECEIPT_INVALID, 'events');
   322	  const expectedDoc = readJsonOr(resolve(paths.expected), REVERIFY_REJECT.FROZEN_CONTRACT_UNSIGNED, 'expected.frozen.json');
   323	  const signCheck = assertSignedContract(expectedDoc);
