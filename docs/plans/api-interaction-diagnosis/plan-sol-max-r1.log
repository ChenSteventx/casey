   327	  }
   328	  const locks = readJsonOr(resolve(paths.entityLocks), REVERIFY_REJECT.PROMOTION_NOT_IN_FORCE, '冻结绑定件');
   329	  const boundSha = typeof locks.eventsSha256 === 'string' ? locks.eventsSha256.replace(/^sha256:/, '') : null;
