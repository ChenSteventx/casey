   242	function emitterDouble(extra = {}) {
   243	  const listeners = new Map();
   244	  return {
   245	    ...extra,
   246	    on(event, handler) {
   247	      const entries = listeners.get(event) || [];
   248	      entries.push(handler);
   249	      listeners.set(event, entries);
   250	    },
   251	    emit(event) {
   252	      for (const handler of listeners.get(event) || []) handler();
   253	    },
   254	  };
   255	}
