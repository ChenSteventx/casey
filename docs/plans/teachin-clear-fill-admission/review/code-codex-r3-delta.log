    30	      drifts.push(`${name}: 缺文件 ${rel}`);
    31	      continue;
    32	    }
    33	    const actual = createHash('sha256').update(readFileSync(abs)).digest('hex');
    34	    if (actual !== expected) drifts.push(`${name}: 漂移 ${rel}`);
    35	  }
    36	}
