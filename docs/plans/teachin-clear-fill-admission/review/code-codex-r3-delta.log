    96	// 无参数=全量（人工用）。
    97	function parsePart() {
    98	  const i = process.argv.indexOf('--part');
    99	  if (i < 0) return null;
   100	  const m = /^([1-9]\d*)\/([1-9]\d*)$/.exec(process.argv[i + 1] || '');
