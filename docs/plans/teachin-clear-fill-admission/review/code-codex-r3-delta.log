   103	    process.exit(64);
   104	  }
   105	  const part = Number(m[1]);
   106	  const parts = Number(m[2]);
   107	  if (part > parts) {
   108	    console.error(`${TAG}: --part ${part}/${parts} 越界`);
   109	    process.exit(64);
   110	  }
   111	  return { part, parts };
   112	}
