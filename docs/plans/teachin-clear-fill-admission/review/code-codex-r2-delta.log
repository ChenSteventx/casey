}

function clickEvent(seq) {
  return { seq, action: 'click', path: '/home', selector: '#open-form', tagName: 'button' };
}

function filledEvent(seq, value) {
  const event = {
    seq,
    action: 'fill',
    path: '/home',
    selector: '#note-field',
    tagName: 'textarea',
    fieldLabel: '备注',
  };
  if (value !== undefined) event.value = value;
  return event;
}

