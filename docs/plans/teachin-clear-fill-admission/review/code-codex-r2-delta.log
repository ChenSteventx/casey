      caseId: CASE_ID,
      startUrl: '/home',
      events: [
        { action: 'click', path: '/home', selector: '#open-form', tagName: 'button' },
        { ...rawClearFillEvent(), value: bad },
      ],
      createdAt: '2026-07-29T09:00:00.000Z',
