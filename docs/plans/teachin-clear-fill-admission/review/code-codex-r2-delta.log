// 真语料 seq 11 邻接结构脱敏重表达：textarea 清空步的浏览器侧原始形状。
function rawClearFillEvent() {
  return {
    action: 'fill',
    path: '/home',
    selector: '#note-field',
    tagName: 'textarea',
    fieldLabel: '备注',
    type: 'textarea',
    value: '',
  };
}

function captureDoc(events) {
  return {
    schemaVersion: 1,
    artifactKind: 'teach-in-capture',
    caseId: CASE_ID,
    createdAt: '2026-07-29T09:00:00.000Z',
    startPath: '/home',
    source: {
      kind: 'manual',
      signed: false,
      replayReady: false,
      distillRequired: true,
    },
    events,
  };
