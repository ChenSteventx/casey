const total = EXPECT_GREEN.length + EXPECT_RED.length;

for (const file of EXPECT_GREEN) {
  const { code } = runGolden(file);
  done += 1;
  if (code === 0) {
    console.log(`ok   ${TAG} [${done}/${total}] exit=0 ${file}`);
  } else {
    failures.push(`${file}: 期望 exit 0 实得 ${code}`);
    console.error(`RED  ${TAG} [${done}/${total}] exit=${code}（期望 0）${file}`);
  }
}

for (const [file, expectCode, signature] of EXPECT_RED) {
  const { code, output } = runGolden(file);
  done += 1;
  if (code !== expectCode) {
    failures.push(`${file}: 既红期望 exit ${expectCode} 实得 ${code}（既红转绿/变码=基线漂移，须重采不许静默吃）`);
    console.error(`RED  ${TAG} [${done}/${total}] exit=${code}（既红期望 ${expectCode}）${file}`);
  } else if (!output.includes(signature)) {
    failures.push(`${file}: 既红签名漂移（未见 ${signature}）`);
    console.error(`RED  ${TAG} [${done}/${total}] 签名漂移 ${file}`);
  } else {
    console.log(`ok   ${TAG} [${done}/${total}] 既红稳定 exit=${expectCode} ${file}`);
  }
}

if (failures.length) {
  console.error(`\n${TAG}: ${total - failures.length}/${total} 符合期望，${failures.length} 偏离`);
  for (const failure of failures) console.error(` - ${failure}`);
  process.exit(1);
}
