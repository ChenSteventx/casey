     9	const ROOT = join(import.meta.dirname, '..', '..');
    10	const CASE = 'tc_agent_id_readback_real_uat_v1';
    11	const DIR = join(ROOT, 'cases', CASE);
    12	
    13	const draft = JSON.parse(readFileSync(join(DIR, 'entity-bindings.draft.json'), 'utf8'));
    14	const eventsBytes = readFileSync(join(DIR, 'events.json'));
    15	const eventsDocument = JSON.parse(eventsBytes.toString('utf8'));
    16	const obs = JSON.parse(readFileSync(join(DIR, 'identity-observations.compile.json'), 'utf8'));
    17	const row = obs.observations[0];
    18	if (!row || row.kind !== 'agent') { console.error('观察件缺 agent 行'); process.exit(1); }
    19	
    20	const scope = `sha256:${createHash('sha256').update('heren-aimanagement-agent-list-scope').digest('hex')}`;
