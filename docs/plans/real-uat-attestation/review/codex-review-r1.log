    35	    name: r.name, code: r.code, platformId: r.platformId, sourceIntentId: r.sourceIntentId,
    36	    candidateId: r.candidateId, role: r.role, atom: r.atom, evidenceStepId: r.evidenceStepId,
    37	  })),
