    22	  lockId: 'lock-agent-uat-x', kind: 'agent', bindingMode: 'existing', scopeFingerprint: scope,
    23	  expected: { name: row.name, code: row.code },
    24	  observed: { name: row.name, code: row.code, platformId: row.platformId },
    25	  source: 'user-confirmed',
    26	});
    27	const confirmations = draft.bindings.map((r) => ({ ...r, receipt }));
    28	writeFileSync(join(DIR, 'entity-confirmations.json'), JSON.stringify({ caseId: CASE, confirmations }, null, 2) + '\n');
    29	
    30	// 纯函数预验（sign 同一入口，防签署时被拒）
    31	const frozen = freezeEntityBindingsDraft({
