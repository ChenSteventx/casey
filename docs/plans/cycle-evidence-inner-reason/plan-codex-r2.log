    44	const ERROR_NAME_SET = new Set(CYCLE_EVIDENCE_ERROR_NAMES);
    45	const REASON_SET = new Set(CYCLE_EVIDENCE_REASONS);
    46	const ACTION_SET = new Set(CYCLE_EVIDENCE_ACTIONS);
    47	const RESOLUTION_SET = new Set(CYCLE_EVIDENCE_RESOLUTIONS);
