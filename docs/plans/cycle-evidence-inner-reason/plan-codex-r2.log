   138	    case 'reason': return REASON_SET.has(value);
   139	    case 'errorName': return ERROR_NAME_SET.has(value);
   140	    case 'action': return ACTION_SET.has(value);
   141	    case 'resolution': return RESOLUTION_SET.has(value);
   142	    case 'seq': return counted(value);
   143	    case 'candidateCount': return counted(value);
