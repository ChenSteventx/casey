    48	  if (draftFlagged) problems.push('manifest 带 draft 标记（草案不算已签，须定稿去标记后重签）');
    49	  const signedOk = m.signed === true && typeof m.signerId === 'string' && m.signerId.trim().length > 0
    50	    && typeof m.signedAt === 'string' && m.signedAt.trim().length > 0 && !draftFlagged;
    51	  if (!signedOk) problems.push('manifest 未人签（signed/signerId/signedAt 三件须齐且非草案）');
    52	
    53	  const caseLimit = Number.isInteger(m.caseLimit) && m.caseLimit > 0 ? m.caseLimit : null;
    54	  if (caseLimit === null) problems.push('manifest 未声明合法 caseLimit');
    55	
    56	  for (const [key, prefix] of [['winProbeResultPath', 'runs/'], ['outOfBandReceiptPath', 'runs/']]) {
    57	    if (!isRepoRelativePath(m[key], [prefix])) problems.push(`manifest 的 ${key} 非法（须仓内相对路径、无上跳段、落在 ${prefix} 下）`);
    58	  }
    59	
    60	  const members = Array.isArray(m.members) ? m.members : null;
    61	  if (!members || !members.length) {
