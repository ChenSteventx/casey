   391	  const badPrecedents = precedents.filter((p) => p.hashBound !== true
   392	    || (p.artifactPresent === true && p.hashMatch !== true));
   393	  items.push(precedents.length && !badPrecedents.length
   394	    ? ok('judge-precedents-hash-bound', `历史真机先例按产物 hash 绑定（${precedents.length} 条）`)
   395	    : fail('judge-precedents-hash-bound',
   396	      precedents.length ? `先例 hash 未绑定或已漂移：${badPrecedents.map((p) => p.id || '未标注').join('/')}` : '用例集未记历史真机先例',
