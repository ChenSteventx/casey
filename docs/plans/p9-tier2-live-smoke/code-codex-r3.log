    96	  }
    97	
    98	  const precedents = Array.isArray(m.historicalPrecedents) ? m.historicalPrecedents : [];
    99	  if (!precedents.length) problems.push('manifest 未记历史真机先例（SUT_DEFECT 面证据引用）');
   100	  for (const p of precedents) {
   101	    const it = p && typeof p === 'object' ? p : {};
