   207	export function classifyTier2Receipt({ projected, timedOut, systemicCode, childExitCode, exitCodeLegend }) {
   208	  const problems = [];
   209	  if (timedOut) return { receiptClass: 'timeout', problems: ['超出用例声明超时'] };
   210	  if (systemicCode) return { receiptClass: 'systemic_abort', problems: [`系统性前置闸拒付：${systemicCode}`] };
