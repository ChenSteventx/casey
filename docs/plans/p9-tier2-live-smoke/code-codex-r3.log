   152	function projection({ caseId = READ_CASE, streaming = false } = {}) {
   153	  const stepId = 'atstep_0';
   154	  const intentId = 'intent_0';
   155	  return {
   156	    caseId,
   157	    runDir: `runs/${caseId}/run_tier2_20260729T120000Z`,
   158	    verdict: {
   159	      schemaOk: true,
   160	      stateCounts: { PASS: 1, SUT_DEFECT: 0, HARNESS_ERROR: 0, NEEDS_HUMAN: 0 },
   161	      unknownStates: [],
   162	      catchAllReachable: true,
   163	    },
   164	    axes: {
   165	      schemaOk: true,
   166	      steps: [{
   167	        stepId,
   168	        intentId,
   169	        kind: 'click',
   170	        hardAssertionKinds: streaming ? ['noErrorEnvelope', 'streamReplyReceived'] : ['noErrorEnvelope'],
   171	        judgedAssertionKinds: streaming ? ['noErrorEnvelope', 'streamReplyReceived'] : ['noErrorEnvelope'],
   172	      }],
   173	      forensics: {
   174	        // 按发起方归因结构（非时间窗）：每条网络取证须带 initiator + attributedStepId。
   175	        network: {
   176	          present: true,
   177	          attributedByInitiator: true,
   178	          entries: [{ initiator: stepId, attributedStepId: stepId, statusClass: '2xx' }],
   179	        },
   180	        lifecycle: { present: true, pageerrorCount: 0, crashed: false },
   181	      },
   182	    },
   183	    reportModel: {
   184	      schemaOk: true,
   185	      exitCodeLegend: [0, 1, 2, 3, 64],
   186	      badgeStates: [...FOUR_STATES],
   187	    },
   188	    // 凭据兜底扫描：三阶段全过、零命中（时序另由 judgeTier2ScanTimeline 单独钉）。
   189	    credentialScan: { stages: [...REQUIRED_SCAN_STAGES], hits: [] },
   190	    streamingAssertions: streaming
   191	      ? {
   192	        expected: [{ intentId, stepId, kind: 'streamReplyReceived', soft: false }],
   193	        judged: [{ intentId, stepId, kind: 'streamReplyReceived', ok: true }],
   194	      }
   195	      : { expected: [], judged: [] },
   196	  };
   197	}
   198	
   199	function caseEntry({
   200	  caseId = READ_CASE,
   201	  effect = 'read',
   202	  receiptClass = 'pipeline_complete_with_verdict',
   203	  streaming = false,
   204	  authorizedMutation = false,
   205	  smokeAuthorized = true,
   206	  receiptPersisted = true,   // ★r2 H5 残口：receipt 真落盘核过才算数
   207	  proj,
   208	} = {}) {
   209	  return {
   210	    caseId,
   211	    effect,
   212	    smokeAuthorized,
   213	    receiptPersisted,
   214	    // 变更型条目的「本次调用逐次授权」（--authorize-mutation <caseId>）。
   215	    authorizedMutation,
   216	    receipt: {
   217	      caseId,
   218	      class: receiptClass,
   219	      runDir: `runs/${caseId}/run_tier2_20260729T120000Z`,
   220	      loginBootstrap: true,
   221	    },
   222	    projection: proj || projection({ caseId, streaming }),
   223	  };
   224	}
   225	
   226	// 覆盖矩阵第三面（SUT_DEFECT 面）的结构化冒烟证据（★r1 H1）：壳层真调现役 verdict.mjs 的产出投影
   227	//   + 历史真机先例 hash 绑定核验结果。纯层只判这份结构，不自己跑二进制（零 spawn 不变）。
   228	function judgeSmokeEvidence(overrides = {}) {
   229	  const cases = [
   230	    { id: 'sut_defect_arrival_1', expectVerdict: 'SUT_DEFECT', expectReason: null, actualVerdict: 'SUT_DEFECT', actualReason: null, ok: true },
   231	    { id: 'sut_defect_arrival_2', expectVerdict: 'SUT_DEFECT', expectReason: null, actualVerdict: 'SUT_DEFECT', actualReason: null, ok: true },
   232	    { id: 'background_401_not_attributed', expectVerdict: 'PASS', expectReason: null, actualVerdict: 'PASS', actualReason: null, ok: true },
   233	    { id: 'misattributed_5xx', expectVerdict: 'NEEDS_HUMAN', expectReason: 'SUT_DEFECT_OR_STALE', actualVerdict: 'NEEDS_HUMAN', actualReason: 'SUT_DEFECT_OR_STALE', ok: true },
   234	    { id: 'catch_all_indeterminate', expectVerdict: 'NEEDS_HUMAN', expectReason: 'INDETERMINATE', actualVerdict: 'NEEDS_HUMAN', actualReason: 'INDETERMINATE', ok: true },
   235	    { id: 'ambiguous_action', expectVerdict: 'NEEDS_HUMAN', expectReason: 'AMBIGUOUS_ACTION', actualVerdict: 'NEEDS_HUMAN', actualReason: 'AMBIGUOUS_ACTION', ok: true },
   236	    { id: 'harness_error_drift', expectVerdict: 'HARNESS_ERROR', expectReason: null, actualVerdict: 'HARNESS_ERROR', actualReason: null, ok: true },
   237	    { id: 'pass', expectVerdict: 'PASS', expectReason: null, actualVerdict: 'PASS', actualReason: null, ok: true },
   238	  ];
   239	  return {
   240	    ran: true,
   241	    fixtureChecksumOk: true,
   242	    // 证据真落盘（★r2 H1 残口：写失败=没证据，第三面必红）
   243	    evidencePersisted: true,
   244	    cases,
   245	    statesProduced: [...FOUR_STATES],
   246	    precedents: [
   247	      { id: 'attestation-run1-503', hashBound: true, artifactPresent: true, hashMatch: true },
   248	      { id: 'attestation-run1-axes', hashBound: true, artifactPresent: false, hashMatch: null },
   249	    ],
   250	    ...overrides,
   251	  };
   252	}
   253	
   254	// 默认全绿环境：一条只读例（取证面）+ 一条流式例（流式面）+ 裁判通道冒烟（SUT_DEFECT 面），三面非空。
   255	function tier2Env(overrides = {}) {
   256	  return {
   257	    now: NOW,
   258	    freshnessWindowMs: DAY_MS,
   259	    probes: readyProbes(),
   260	    judgeSmoke: judgeSmokeEvidence(),
   261	    cases: [
   262	      caseEntry({ caseId: READ_CASE }),
   263	      caseEntry({ caseId: STREAM_CASE, streaming: true }),
   264	    ],
   265	    ...overrides,
   266	  };
   267	}
   268	
   269	function idsOf(items) {
   270	  return (Array.isArray(items) ? items : []).map((it) => it && it.id);
   271	}
   272	function itemById(items, id) {
   273	  return (Array.isArray(items) ? items : []).find((it) => it && it.id === id);
   274	}
   275	function isRed(item) {
   276	  return !!item && item.status !== 'ok' && item.status !== 'route-human';
   277	}
