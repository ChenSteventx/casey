   116	// 契约冻结值查表（单源：从 loop/prd-*.json 的 testChecksums 取，代码里不写死字面量）。
   117	function frozenManifestChecksum() {
   118	  try {
   119	    const prd = JSON.parse(readFileSync(join(PROJECT_ROOT, PRD_REL), 'utf8'));
   120	    const v = (prd.testChecksums || {})[MANIFEST_REL];
   121	    return typeof v === 'string' ? v : null;
   122	  } catch { return null; }
   123	}
