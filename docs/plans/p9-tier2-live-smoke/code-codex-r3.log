    22	  if (key === 'role') return ARIA_ROLES.has(v);
    23	  if (key === 'successField' || key === 'successValue') return IDENT_RE.test(v);
    24	  if (key === 'background') return v.startsWith('/');
    25	  return false;
    26	}
    27	export function collectSecretLiterals() {
    28	  const lits = new Set();
    29	  const files = [CREDS_FILE, join(PROJECT_ROOT, 'site.json'), join(AUTH_DIR, 'site.json')];
    30	  for (const f of files) {
    31	    if (!existsSync(f)) continue;
    32	    let j;
    33	    try { j = JSON.parse(readFileSync(f, 'utf8')); } catch { continue; }
    34	    (function walk(n, key) {
    35	      if (Array.isArray(n)) { n.forEach((x) => walk(x, key)); return; }
    36	      if (n && typeof n === 'object') { for (const [k, v] of Object.entries(n)) walk(v, k); return; }
    37	      if (typeof n === 'string' && n.length >= 6 && !isNonCredentialShaped(key, n)) lits.add(n);
    38	    })(j, null);
    39	  }
    40	  return [...lits];
    41	}
    42	
    43	// 落盘前凭据门：扫将写出的产物字符串映射 { 名: 文本 }。命中 → { ok:false, hit }（fail-closed，调用方拒写）。
    44	export function credentialGate(outputs) {
    45	  const secrets = collectSecretLiterals();
    46	  for (const [name, text] of Object.entries(outputs)) {
    47	    const low = String(text).toLowerCase();
    48	    for (const kw of FORBIDDEN_KEYWORDS) {
    49	      if (low.includes(kw)) return { ok: false, hit: `产物 ${name} 含禁字段关键词「${kw}」` };
