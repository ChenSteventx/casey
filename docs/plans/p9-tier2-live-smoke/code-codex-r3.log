   189	    && TIER2_SCAN_STAGES.every((s, i) => seen[i] === s);
   190	  const problems = [];
   191	  if (!orderOk) problems.push(`扫描阶段须严格有序 ${TIER2_SCAN_STAGES.join(' → ')}，实得 ${seen.join(' → ') || '（空）'}`);
   192	  if (found.length > 0) problems.push(`命中 ${found.length} 条（规则 ${found.map((h) => obj(h).rule || '未标注').join('/')}）`);
   193	  const allOk = problems.length === 0;
   194	  return {
   195	    ok: allOk,
   196	    emitEvidence: allOk, // fail-closed：时序不对或有命中 → 一个字节的证据都不许落盘
   197	    stages: seen,
   198	    hitCount: found.length,
   199	    hitRules: found.map((h) => obj(h).rule || 'unlabeled'),
   200	    problems,
   201	  };
   202	}
