   247	export function readOutOfBandReceipt(manifest) {
   248	  const rel = manifest && manifest.json && typeof manifest.json.outOfBandReceiptPath === 'string' ? manifest.json.outOfBandReceiptPath : null;
   249	  if (!isRepoRelativePath(rel, ['runs/'])) return { present: false, acknowledged: false, confirmedAt: null, problems: ['带外回执路径未在 manifest 声明或非法'] };
   250	  const abs = join(PROJECT_ROOT, rel);
   251	  if (!existsSync(abs)) return { present: false, acknowledged: false, confirmedAt: null, problems: ['带外回执文件不在场'] };
   252	  const doc = readJsonStrict(abs);
   253	  const problems = [];
   254	  if (!doc || typeof doc !== 'object') problems.push('带外回执不是合法 JSON 对象');
   255	  else {
   256	    if (doc.schemaVersion !== 1) problems.push('带外回执 schemaVersion 不符');
   257	    if (doc.artifactKind !== 'tier2-out-of-band-receipt') problems.push('带外回执 artifactKind 不符');
   258	    if (doc.acknowledged !== true) problems.push('带外回执未标确认');
