   270	// 先例 hash 绑定核验（第三面证据的一半；另一半是裁判二进制冒烟）。
   271	export function verifyHistoricalPrecedents(manifest) {
   272	  const list = manifest && manifest.json && Array.isArray(manifest.json.historicalPrecedents) ? manifest.json.historicalPrecedents : [];
   273	  return list.map((raw) => {
   274	    const p = raw && typeof raw === 'object' ? raw : {};
   275	    const id = typeof p.id === 'string' ? p.id : '未标注';
   276	    const digest = typeof p.sha256 === 'string' ? p.sha256 : '';
   277	    const pathOk = isRepoRelativePath(p.path, ['runs/']);
   278	    const attestOk = isRepoRelativePath(p.attestedIn, ['docs/']) && existsSync(join(PROJECT_ROOT, p.attestedIn));
   279	    let attestRecordsHash = false;
   280	    if (attestOk && SHA256_HEX.test(digest)) {
   281	      try { attestRecordsHash = readFileSync(join(PROJECT_ROOT, p.attestedIn), 'utf8').includes(digest.slice(0, 8)); } catch { attestRecordsHash = false; }
   282	    }
   283	    const abs = pathOk ? join(PROJECT_ROOT, p.path) : null;
   284	    const artifactPresent = !!abs && existsSync(abs);
   285	    let hashMatch = null;
   286	    let producedAt = null;
   287	    if (artifactPresent) {
   288	      try {
   289	        hashMatch = sha256(readFileSync(abs)) === digest;
   290	        producedAt = new Date(statSync(abs).mtimeMs).toISOString();
   291	      } catch { hashMatch = false; }
   292	    }
   293	    return {
   294	      id,
   295	      hashBound: pathOk && SHA256_HEX.test(digest) && attestOk && attestRecordsHash,
   296	      artifactPresent,
   297	      hashMatch,
   298	      attestedIn: typeof p.attestedIn === 'string' ? p.attestedIn : null,
   299	      producedAt,
   300	    };
   301	  });
   302	}
     1	// lib/cred-gate.mjs —— 凭据兜底门共享件（护栏 #7，G5 取 B：单源、所有落盘口统一过门）。
     2	// 从 bin/report.mjs 抽出（p7-credgate-coverage.golden 语义一字不变）；bin/report.mjs 保留 re-export。
     3	// 消费方：相6 报告落盘（bin/report.mjs）、相1 编译产物落盘（bin/compile.mjs：flow/events/observed/compile-report）。
     4	import { readFileSync, existsSync } from 'node:fs';
     5	import { join } from 'node:path';
     6	import { AUTH_DIR, CREDS_FILE, PROJECT_ROOT } from './paths.mjs';
     7	
     8	// 凭据/禁字段关键词（与 seams-freeze.golden 同源，护栏 #7；token/cookie 为 p3 异构评审 R1-F5 补强）。
     9	export const FORBIDDEN_KEYWORDS = ['authorization', 'set-cookie', 'password', 'apikey', 'x-api-key', 'bearer ', 'secret', 'credential', 'token', 'cookie'];
    10	
    11	// 收集凭据文件里的敏感字面量值（若存在），用于精确比对——防真凭据被合成进产物后随落盘外泄。
    12	// 两类键的值不收集（皆为域定义的非凭据、且必然合法出现在产物里，收了全是假阳性）：
    13	//   - role：ARIA 角色是 W3C 公共词表枚举（button/textbox/...），events 语义定位器必含；
    14	//   - successField/successValue/background：通道剖面三件（CONTEXT 定义 = 非凭据配置、tier-2 由 site.json
    15	//     非凭据子集投影），observed 的 errorEnvelope.field 与背景轮询 URL 必含。
    16	// R1-F5 收紧（评审建议「取消跳过」违反通道剖面接缝定义，修正采纳为形状校验，audit 留案）：
    17	// 跳过只对「值形状确属该键语义」成立——role 须 ∈ ARIA 角色枚举、successField/Value 须短标识符、
    18	// background 须以 / 开头的路径段；形状不符（可疑走私值）照收进敏感池。
    19	const ARIA_ROLES = new Set(['button', 'textbox', 'combobox', 'menuitem', 'checkbox', 'radiogroup', 'radio', 'listbox', 'option', 'dialog', 'status', 'alert', 'link', 'heading', 'gridcell', 'searchbox', 'switch', 'tab', 'tabpanel', 'toolbar', 'tooltip', 'treeitem']);
