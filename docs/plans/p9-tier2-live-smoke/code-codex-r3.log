   147	  const structural = validateSuiteManifestDoc(doc);
   148	  const problems = [...structural.problems];
   149	
   150	  const frozen = frozenManifestChecksum();
   151	  let checksumOk = false;
   152	  if (typeof frozen !== 'string') problems.push('manifest 未冻入契约 testChecksums（未在册即不放行）');
   153	  else if (frozen !== digest) problems.push('manifest 字节与契约冻结值失配（件已漂移）');
