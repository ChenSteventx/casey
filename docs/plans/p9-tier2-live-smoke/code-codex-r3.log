   330	export function screenTier2CaseAuthorization(entry = {}) {
   331	  const e = obj(entry);
   332	  if (e.smokeAuthorized !== true) {
   333	    return { ran: false, refusalReason: 'manifest_smoke_authorized_flag_absent' };
   334	  }
   335	  if (e.effect !== 'read' && e.effect !== 'mutation') {
   336	    return { ran: false, refusalReason: 'effect_class_unauthorized' };
   337	  }
   338	  if (e.effect === 'mutation' && e.authorizedMutation !== true) {
   339	    return { ran: false, refusalReason: 'per_run_mutation_authorized_flag_absent' };
   340	  }
   341	  return { ran: true, refusalReason: null };
   342	}
