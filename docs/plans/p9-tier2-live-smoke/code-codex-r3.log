    63	    return { ok: false, problems, members: [], caseLimit: caseLimit || TIER2_DEFAULT_CASE_LIMIT, signedOk };
    64	  }
    65	  if (caseLimit !== null && members.length > caseLimit) problems.push(`成员数超声明上限（${members.length} > ${caseLimit}）`);
    66	
    67	  const seen = new Set();
    68	  for (const raw of members) {
    69	    const member = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
    70	    const id = member.caseId;
    71	    if (typeof id !== 'string' || !SAFE_CASE_ID.test(id)) { problems.push(`成员 caseId 不安全或缺失（只允许字母数字下划线单段）`); continue; }
    72	    if (seen.has(id)) { problems.push(`成员重复：${id}`); continue; }
    73	    seen.add(id);
    74	    if (!['read', 'mutation'].includes(member.effect)) problems.push(`成员 ${id} 的 effect 须 ∈ {read,mutation}`);
    75	    if (member.smokeAuthorized !== true) problems.push(`成员 ${id} 缺 smoke 授权标志`);
    76	    if (!Number.isInteger(member.timeoutMs) || member.timeoutMs <= 0) problems.push(`成员 ${id} 未声明合法超时`);
    77	    if (typeof member.cleanupObligation !== 'string' || !member.cleanupObligation.trim()) problems.push(`成员 ${id} 未声明清理义务`);
    78	    if (member.effect === 'mutation' && member.perRunApproval !== true) problems.push(`成员 ${id} 是变更型但未标逐次授权义务`);
    79	    const artifacts = member.artifacts && typeof member.artifacts === 'object' && !Array.isArray(member.artifacts) ? member.artifacts : null;
    80	    if (!artifacts || !Object.keys(artifacts).length) { problems.push(`成员 ${id} 未逐件记 artifact hash`); continue; }
    81	    // ③④ artifact 集精确 + 路径闭合
    82	    const names = [];
    83	    for (const [rel, digest] of Object.entries(artifacts)) {
    84	      if (!isRepoRelativePath(rel, [`cases/${id}/`])) { problems.push(`成员 ${id} 的 artifact 路径越界或非法：${rel.slice(0, 60)}`); continue; }
    85	      if (!SHA256_HEX.test(String(digest))) { problems.push(`成员 ${id} 的 artifact hash 非 sha256 十六进制：${rel}`); continue; }
    86	      const name = rel.slice(`cases/${id}/`.length);
    87	      if (!REQUIRED_ARTIFACT_NAMES.includes(name) && !OPTIONAL_ARTIFACT_NAMES.includes(name)) {
