   125	// ── 采集：单次读字节 → hash → 同一份字节解析 → 结构校验 → 磁盘件核验 ────
   126	export function readSuiteManifest() {
   127	  const manifestAbs = process.env.AT_TIER2_MANIFEST || join(PROJECT_ROOT, MANIFEST_REL);
   128	  const absent = {
   129	    present: false, signed: false, checksumOk: false, memberCount: 0,
   130	    caseLimit: TIER2_DEFAULT_CASE_LIMIT, members: [], memberIds: [], memberEffects: {},
   131	    json: null, digest: null, problems: ['人签 manifest 不在场（草案不算数）'],
   132	  };
   133	  if (!existsSync(manifestAbs)) return absent;
   134	
   135	  let bytes;
   136	  try { bytes = readFileSync(manifestAbs); } catch { return { ...absent, present: true, problems: ['manifest 不可读'] }; }
   137	  const digest = sha256(bytes);                       // ① hash 与解析同一份字节
   138	  let doc = null;
   139	  let parseOk = true;
   140	  try { doc = JSON.parse(bytes.toString('utf8')); } catch { parseOk = false; }
   141	  if (!parseOk) {
   142	    return {
   143	      ...absent, present: true, digest, problems: ['manifest 不是合法 JSON'],
   144	    };
   145	  }
