   177	    present: true,
   178	    signed: structural.signedOk,
   179	    checksumOk,
   180	    memberCount: acceptable ? verifiedMembers.length : 0,
   181	    caseLimit: structural.caseLimit,
   182	    members: acceptable ? verifiedMembers : [],
   183	    memberIds: acceptable ? verifiedMembers.map((m) => m.caseId) : [],
   184	    memberEffects: acceptable ? Object.fromEntries(verifiedMembers.map((m) => [m.caseId, m.effect])) : {},
