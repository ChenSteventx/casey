     5	//   ② 严格解析用参（拒付码与脱敏回显在 selftest-tier2-args.mjs）；
     6	//   ③ 采前置门探针（doctor 导出探针 + 两段连通 + 带外回执，消费端严格校验形状）；
     7	//   ④ 跑覆盖矩阵第三面：裁判通道运行时冒烟（selftest-tier2-judge-smoke.mjs），并落持久证据；
     8	//   ⑤ 逐例走生产 run 同链（排他 run 目录 + 核过的执行件精确路径），落 receipt；
     9	//   ⑥ 把结构化结果喂纯层 runTier2，渲染文本过出口密封，退出码由调用方自然返回。
    10	import { mkdirSync, writeFileSync, readFileSync, renameSync, rmSync } from 'node:fs';
    11	import { spawnSync } from 'node:child_process';
    12	import http from 'node:http';
    13	import https from 'node:https';
    14	import { join, dirname } from 'node:path';
    15	import { randomBytes } from 'node:crypto';
    16	import { PROJECT_ROOT, NODE_EXE } from './paths.mjs';
    17	import { collectDoctorEnv } from './doctor-probes.mjs';
    18	import {
    19	  TIER2_SCAN_STAGES, judgeTier2Readiness, judgeTier2ScanTimeline,
    20	  screenTier2CaseAuthorization, runTier2, parseTier2Args, formatTier2ArgErrors,
    21	} from './selftest-tier2.mjs';
    22	import {
    23	  MANIFEST_REL, readSuiteManifest, verifyMemberExecutionFiles,
    24	  readWinProbeResult, readOutOfBandReceipt,
    25	} from './selftest-tier2-manifest.mjs';
    26	import { createScanRecorder, scanTextForSensitive, sealTier2Output } from './selftest-tier2-scan.mjs';
    27	import { collectTier2JudgeSmoke } from './selftest-tier2-judge-smoke.mjs';
    28	import { createExclusiveRunDir, projectRunArtifacts, classifyTier2Receipt } from './selftest-tier2-projection.mjs';
    29	
    30	const CASEY_BIN = join(PROJECT_ROOT, 'bin', 'casey.mjs');
    31	const DEFAULT_FRESHNESS_WINDOW_MS = 24 * 60 * 60 * 1000;
    32	const DEFAULT_CASE_TIMEOUT_MS = 600000;
    33	
    34	// 系统性故障具名拒付码白名单（plan §1.3）：replay 前置闸的稳定拒付码
    35	//   （lib/execution-target/cli-boundary.mjs 的 REASONS 全集）+ 凭据/登录两道具名前置闸文案。
    36	// 码名一律避开禁字段关键词表——这批码要写进 receipt，带禁词会被落盘前复扫判命中、该例零证据落盘。
    37	const SYSTEMIC_REFUSAL_MARKERS = Object.freeze([
    38	  Object.freeze({ code: 'RUNTIME_UNSUPPORTED', marker: 'RUNTIME_UNSUPPORTED' }),
    39	  Object.freeze({ code: 'LOGICAL_TARGET_INVALID', marker: 'LOGICAL_TARGET_INVALID' }),
    40	  Object.freeze({ code: 'LOGICAL_TARGET_REQUIRED', marker: 'LOGICAL_TARGET_REQUIRED' }),
    41	  Object.freeze({ code: 'TRANSPORT_MODE_INVALID', marker: 'TRANSPORT_MODE_INVALID' }),
    42	  Object.freeze({ code: 'TRANSPORT_ENDPOINT_REQUIRED', marker: 'TRANSPORT_ENDPOINT_REQUIRED' }),
    43	  Object.freeze({ code: 'TARGET_TRANSPORT_MODE_MISMATCH', marker: 'TARGET_TRANSPORT_MODE_MISMATCH' }),
    44	  Object.freeze({ code: 'ORIGIN_CONTINUITY_UNAVAILABLE', marker: 'ORIGIN_CONTINUITY_UNAVAILABLE' }),
    45	  Object.freeze({ code: 'EXECUTION_TARGET_AUTHORITY_INVALID', marker: 'EXECUTION_TARGET_AUTHORITY_INVALID' }),
    46	  Object.freeze({ code: 'BROWSER_LAUNCH_FAILED', marker: 'BROWSER_LAUNCH_FAILED' }),
    47	  Object.freeze({ code: 'NAVIGATION_FAILED', marker: 'NAVIGATION_FAILED' }),
    48	  Object.freeze({ code: 'NAVIGATION_ORIGIN_MISMATCH', marker: 'NAVIGATION_ORIGIN_MISMATCH' }),
    49	  Object.freeze({ code: 'LOGIN_PREP_FAILED', marker: '登录预备动作前置失败' }),
    50	  Object.freeze({ code: 'AUDIENCE_CONTEXT_GATE', marker: '准入受众与凭据上下文不符' }),
    51	]);
    52	
    53	export function classifySystemicRefusal(text) {
    54	  const raw = String(text == null ? '' : text);
    55	  for (const { code, marker } of SYSTEMIC_REFUSAL_MARKERS) {
    56	    if (raw.includes(marker)) return code;
    57	  }
    58	  return null;
    59	}
    60	
    61	// WSL 回环 → 隧道段：壳层自采结构化结果（只记状态码与耗时，地址不入结果）。
    62	export function probeLoopbackTunnelSegment(sutBase, timeoutMs = 8000) {
    63	  return new Promise((resolve) => {
    64	    const producedAt = new Date().toISOString();
    65	    let url;
    66	    try { url = new URL(sutBase); } catch { resolve({ present: false, ok: false, producedAt, httpStatus: null }); return; }
    67	    const client = url.protocol === 'https:' ? https : http;
    68	    const t0 = Date.now();
    69	    const req = client.get(url, (res) => {
    70	      res.resume();
    71	      resolve({
    72	        present: true,
    73	        ok: Number.isInteger(res.statusCode) && res.statusCode >= 100 && res.statusCode <= 599,
    74	        httpStatus: res.statusCode,
    75	        probeMs: Date.now() - t0,
    76	        producedAt,
    77	      });
    78	    });
    79	    req.setTimeout(timeoutMs, () => { req.destroy(); resolve({ present: true, ok: false, httpStatus: null, probeMs: Date.now() - t0, producedAt }); });
    80	    req.on('error', () => resolve({ present: true, ok: false, httpStatus: null, probeMs: Date.now() - t0, producedAt }));
    81	  });
    82	}
    83	
    84	// 退出码归一图例：从本 CLI 现役 help 的图例行取（单一事实源；图例漂移即证据红）。
    85	function collectExitCodeLegend() {
    86	  const r = spawnSync(NODE_EXE, [CASEY_BIN, '--help'], { cwd: PROJECT_ROOT, encoding: 'utf8', timeout: 30000 });
    87	  const line = String(r.stdout || '').split('\n').find((l) => l.startsWith('退出码：')) || '';
    88	  return [...line.matchAll(/(\d+)/g)].map((m) => Number(m[1]));
    89	}
    90	
    91	// 原子写 + 落盘前复扫（命中即零证据落盘；写失败也算未落盘，绝不留半件）。
    92	export function writeEvidenceAtomically(absPath, text, recorder) {
    93	  if (recorder) {
    94	    recorder.scan(text, 'pre_write');
    95	    recorder.complete('pre_write');
    96	  }
    97	  const snapshot = recorder ? recorder.snapshot()
    98	    : { stages: [...TIER2_SCAN_STAGES], hits: scanTextForSensitive(text, 'pre_write') };
    99	  const timeline = judgeTier2ScanTimeline(snapshot);
   100	  if (!timeline.emitEvidence) return { written: false, snapshot };
   101	  const tmp = `${absPath}.tmp-${process.pid}-${randomBytes(3).toString('hex')}`;
   102	  try {
   103	    mkdirSync(dirname(absPath), { recursive: true });
   104	    writeFileSync(tmp, text, 'utf8');
   105	    renameSync(tmp, absPath);
   106	  } catch {
   107	    try { rmSync(tmp, { force: true }); } catch { /* 尽力 */ }
   108	    return { written: false, snapshot };
   109	  }
   110	  // 落盘核验（联审 r2 H5 残口）：不信返回值、回读字节比对——盘满/被挤掉/写了半截都在这里现形。
   111	  try {
   112	    if (readFileSync(absPath, 'utf8') !== text) return { written: false, snapshot };
   113	  } catch { return { written: false, snapshot }; }
   114	  return { written: true, snapshot };
   115	}
   116	
   117	function baseReceipt({ caseId, member, authorizedMutation, cls, ran, runDirRel, extra = {}, refusalReason = null }) {
   118	  return {
   119	    schemaVersion: 1,
   120	    artifactKind: 'tier2-run-receipt',
   121	    caseId,
   122	    class: cls,
   123	    ran,
   124	    runDir: runDirRel,
   125	    effect: member.effect,
   126	    loginBootstrap: true,
   127	    // 字段名避开禁字段关键词表（自家账不许被自家扫描判命中）。
   128	    approval: {
   129	      smokeAuthorized: member.smokeAuthorized === true,
   130	      perRunApproved: authorizedMutation === true,
   131	      source: 'signed-suite-manifest',
   132	    },
   133	    ...(refusalReason ? { refusalReason } : {}),
   134	    ...extra,
   135	    generatedAt: new Date().toISOString(),
   136	  };
   137	}
   138	
   139	// ── 单例执行（走生产 run 同链，不自建第二条编排）─────────────────
   140	export function runOneCase({ member, sut, exitCodeLegend, authorizedMutation }) {
   141	  const caseId = member.caseId;
   142	  const recorder = createScanRecorder();
   143	  // spawn 前重核执行件（H3 ⑤）：核过才跑，并把精确路径显式交给生产 run（不靠约定解析兜底）。
   144	  const files = verifyMemberExecutionFiles(member);
   145	  const dir = files.ok ? createExclusiveRunDir(caseId) : null;
   146	  if (!files.ok || !dir) {
   147	    const receipt = baseReceipt({
   148	      caseId, member, authorizedMutation, cls: 'stage_failed', ran: true,
   149	      runDirRel: dir ? dir.runDirRel : null,
   150	      extra: { preflightProblems: files.ok ? ['排他 run 目录创建失败'] : files.problems },
   151	    });
   152	    return { receipt, projection: null, receiptWritten: false, scan: { stages: [], hits: [] } };
   153	  }
   154	
   155	  const timeoutMs = Number.isInteger(member.timeoutMs) && member.timeoutMs > 0 ? member.timeoutMs : DEFAULT_CASE_TIMEOUT_MS;
   156	  const args = ['run', caseId, '--sut', sut, '--run-dir', dir.runDirAbs, '--login-bootstrap',
   157	    '--events', files.paths['events.json'],
   158	    '--expected', files.paths['expected.frozen.json'],
   159	    '--profile', files.paths['profile.json'],
   160	    '--case-meta', files.paths['testcase.json'],
   161	  ];
   162	  if (files.paths['entity-locks.frozen.json']) args.push('--entity-locks', files.paths['entity-locks.frozen.json']);
   163	  if (typeof member.uniqueNameToken === 'string' && member.uniqueNameToken) args.push('--unique-name', member.uniqueNameToken);
   164	
   165	  const startedAtMs = Date.now();
   166	  const child = spawnSync(NODE_EXE, [CASEY_BIN, ...args], {
   167	    cwd: PROJECT_ROOT, encoding: 'utf8', timeout: timeoutMs, killSignal: 'SIGKILL',
   168	  });
   169	  const durationMs = Date.now() - startedAtMs;
   170	  // 原始字节先扫（H4）：子进程两路输出；stderr 命中单列具名规则。
   171	  recorder.scan(child.stdout, 'raw_bytes');
   172	  recorder.scan(child.stderr, 'raw_bytes', { rule: 'child-stderr-sensitive' });
   173	  const timedOut = child.error && (child.error.code === 'ETIMEDOUT' || /timed?\s*out/i.test(String(child.error.message || '')));
   174	  const systemicCode = classifySystemicRefusal(String(child.stdout || '') + String(child.stderr || ''));
   175	  const childExitCode = Number.isInteger(child.status) ? child.status : null;
   176	
   177	  // 原始产物逐件按字节扫 → 解析 → 白名单投影（阶段记账由 recorder 出，不硬写常量）。
   178	  const projected = projectRunArtifacts({
   179	    caseId, runDirRel: dir.runDirRel, runDirAbs: dir.runDirAbs, exitCodeLegend,
   180	    expectedAbs: files.paths['expected.frozen.json'], recorder, startedAtMs,
   181	  });
   182	  const classified = classifyTier2Receipt({ projected, timedOut, systemicCode, childExitCode, exitCodeLegend });
   183	
   184	  const receipt = baseReceipt({
   185	    caseId, member, authorizedMutation, cls: classified.receiptClass, ran: true, runDirRel: dir.runDirRel,
   186	    extra: {
   187	      childExitCode,
   188	      childExitInLegend: Number.isInteger(childExitCode) && exitCodeLegend.includes(childExitCode),
   189	      durationMs,
   190	      timedOut: !!timedOut,
   191	      systemicRefusalCode: systemicCode,
   192	      attachments: projected.attachments,
   193	      staleArtifacts: projected.staleArtifacts,
   194	      verdictStateCounts: projected.stateCounts,
   195	      classificationProblems: classified.problems,
   196	    },
   197	  });
   198	  const written = writeEvidenceAtomically(join(dir.runDirAbs, 'tier2-receipt.json'), `${JSON.stringify(receipt, null, 2)}\n`, recorder);
   199	  const projection = projected.projection;
   200	  projection.credentialScan = written.snapshot;
   201	  return { receipt, projection, receiptWritten: written.written, scan: written.snapshot };
   202	}
   203	
   204	export function writeRefusalReceipt({ member, refusalReason, authorizedMutation }) {
   205	  const dir = createExclusiveRunDir(member.caseId);
   206	  const receipt = baseReceipt({
   207	    caseId: member.caseId, member, authorizedMutation, cls: 'refused_unauthorized', ran: false,
   208	    runDirRel: dir ? dir.runDirRel : null, refusalReason,
   209	  });
   210	  let written = false;
   211	  if (dir) {
   212	    const recorder = createScanRecorder();
   213	    recorder.complete('raw_bytes');   // 拒跑无子进程、无产物：原始字节面为空即算真跑完
   214	    recorder.complete('projection');  // 该例未进管线，无投影可做
   215	    written = writeEvidenceAtomically(join(dir.runDirAbs, 'tier2-receipt.json'), `${JSON.stringify(receipt, null, 2)}\n`, recorder).written;
   216	  }
   217	  return { receipt, receiptWritten: written };
   218	}
   219	
   220	// 第三面持久证据（H1：不止判一下，要留在盘上可复核）。
   221	export function persistJudgeSmokeEvidence(judgeSmoke) {
   222	  const dirRel = `runs/_tier2/judge-smoke_${new Date().toISOString().replace(/[-:]/g, '').replace(/\./g, '')}_${randomBytes(3).toString('hex')}`;
   223	  const doc = {
   224	    schemaVersion: 1,
   225	    artifactKind: 'tier2-judge-channel-smoke',
   226	    generatedAt: new Date().toISOString(),
   227	    ran: judgeSmoke.ran,
   228	    fixtureChecksumOk: judgeSmoke.fixtureChecksumOk,
   229	    fixtureDigest: judgeSmoke.fixtureDigest || null,
   230	    statesProduced: judgeSmoke.statesProduced,
   231	    cases: judgeSmoke.cases,
   232	    precedents: judgeSmoke.precedents,
   233	    problems: judgeSmoke.problems,
   234	  };
   235	  const recorder = createScanRecorder();
   236	  recorder.complete('raw_bytes');   // 反例集字节在采集期已按字节读过并核 hash
   237	  recorder.complete('projection');  // 本证据本体即白名单结构
   238	  const written = writeEvidenceAtomically(join(PROJECT_ROOT, dirRel, 'tier2-judge-smoke.json'), `${JSON.stringify(doc, null, 2)}\n`, recorder);
   239	  return { path: written.written ? `${dirRel}/tier2-judge-smoke.json` : null, written: written.written };
   240	}
   241	
   242	// ── 两段式入口：prepare（纯解析 + manifest，用法错在采集前判定）→ execute ──
   243	export function prepareTier2(argv) {
   244	  const manifest = readSuiteManifest();
   245	  const parsed = parseTier2Args(argv, {
   246	    memberIds: manifest.memberIds,
   247	    memberEffects: manifest.memberEffects,
   248	    caseLimit: manifest.caseLimit,
   249	  });
   250	  let refusalLines = [];
   251	  if (!parsed.ok) {
   252	    // 回显纪律（M1）：只列通过安全形状校验的 caseId（依给定次序），其余一律只出码与脱敏类别。
   253	    if (parsed.requestedCases.length) refusalLines.push(`--case 依给定次序：${parsed.requestedCases.join(', ')}`);
   254	    refusalLines.push(...formatTier2ArgErrors(parsed.errors));
   255	    refusalLines.push(`用例集来源：${MANIFEST_REL}（人签，零动态发现；${manifest.present ? `可用成员 ${manifest.memberCount}` : '当前不在场'}）`);
   256	    // 用法错这条出口也必须过逐行凭据封印（联审 r2 M1 残口）：
   257	    //   形状安全的 caseId 若恰与真实敏感字面量同值，照样不许回显——封印按来源判，不看形状。
   258	    refusalLines = sealTier2Output(refusalLines.join('\n'), 'tier2-usage-refusal').text.split('\n');
   259	  }
   260	  return { ok: parsed.ok, parsed, manifest, refusalLines };
   261	}
   262	
   263	export async function executeTier2({ parsed, manifest }) {
   264	  const now = new Date().toISOString();
   265	  const freshnessWindowMs = Number.isInteger(manifest.json?.connectivityFreshnessWindowMs)
   266	    ? manifest.json.connectivityFreshnessWindowMs : DEFAULT_FRESHNESS_WINDOW_MS;
   267	  const { site, env: doctorEnv } = await collectDoctorEnv();
   268	  const winTarget = readWinProbeResult(manifest);
   269	  const outOfBand = readOutOfBandReceipt(manifest);
   270	  const probes = {
   271	    node: doctorEnv.node,
   272	    playwright: doctorEnv.playwright,
   273	    chromium: doctorEnv.chromium,
   274	    creds: doctorEnv.creds,
   275	    // 壳层对每例恒透传登录引导（GRILL D4：production 受众锁无登录必被凭据上下文门拒）。
   276	    loginBootstrap: { requestedForEveryCase: true },
   277	    executionTarget: {
   278	      resolved: site.present === true && doctorEnv.executionTarget?.ready === true,
   279	      mode: doctorEnv.executionTarget?.transportMode || null,
   280	    },
   281	    tunnel: { proxyPort: doctorEnv.tunnel.proxyPort, portListening: doctorEnv.tunnel.portListening },
   282	    suiteManifest: {
   283	      present: manifest.present, checksumOk: manifest.checksumOk, signed: manifest.signed,
   284	      memberCount: manifest.memberCount, caseLimit: manifest.caseLimit,
   285	    },
   286	    outOfBandReceipt: outOfBand,
   287	    connectivity: { winTarget, wslTunnel: await probeLoopbackTunnelSegment(parsed.sut) },
   288	  };
   289	  const consumerProblems = [...manifest.problems, ...(winTarget.problems || []), ...(outOfBand.problems || [])];
   290	
   291	  // 覆盖矩阵第三面（裁判通道运行时冒烟）：零 SUT 接触，先跑先留证；红则纯层按空覆盖判 exit 2。
   292	  // 证据落盘结果回灌进第三面（联审 r2 H1 残口）：写不下去=没证据，第三面必红。
   293	  const collected = collectTier2JudgeSmoke(manifest);
   294	  const judgeEvidence = persistJudgeSmokeEvidence(collected);
   295	  const judgeSmoke = { ...collected, evidencePersisted: judgeEvidence.written === true, evidencePath: judgeEvidence.path };
   296	
   297	  const readiness = judgeTier2Readiness({ now, freshnessWindowMs, probes });
   298	  const envBase = { now, freshnessWindowMs, probes, judgeSmoke };
   299	  // fail-closed：前置门任一红 → 一例不跑（子进程从未启动）。
   300	  if (!readiness.ok) return { result: runTier2({ ...envBase, cases: [] }), consumerProblems, judgeEvidence };
   301	
   302	  const selected = parsed.requestedCases.length
   303	    ? manifest.members.filter((m) => parsed.requestedCases.includes(m.caseId))
   304	    : manifest.members;
   305	  const exitCodeLegend = collectExitCodeLegend();
   306	  const cases = [];
   307	  for (const member of selected) {
   308	    const authorizedMutation = parsed.authorizedMutations.includes(member.caseId);
   309	    const entry = {
   310	      caseId: member.caseId,
   311	      effect: member.effect,
   312	      smokeAuthorized: member.smokeAuthorized === true,
   313	      authorizedMutation,
   314	    };
   315	    const screen = screenTier2CaseAuthorization(entry);
   316	    if (!screen.ran) {
   317	      // 拒跑：绝不启动子进程，但 receipt 照落（授权缺失原因在册）。
   318	      const refusal = writeRefusalReceipt({ member, refusalReason: screen.refusalReason, authorizedMutation });
   319	      entry.receipt = refusal.receipt;
   320	      entry.receiptPersisted = refusal.receiptWritten;
   321	      entry.projection = null;
   322	      cases.push(entry);
   323	      continue;
   324	    }
   325	    const outcome = runOneCase({ member, sut: parsed.sut, exitCodeLegend, authorizedMutation });
   326	    entry.receipt = outcome.receipt;
   327	    // receipt 落盘核验结果进聚合（联审 r2 H5 残口：此前返回了却没人看）。
   328	    entry.receiptPersisted = outcome.receiptWritten;
   329	    entry.projection = outcome.projection;
   330	    cases.push(entry);
   331	    if (outcome.receipt.class === 'systemic_abort') break; // 系统性故障立即停全集
   332	  }
   333	  return { result: runTier2({ ...envBase, cases }), consumerProblems, judgeEvidence };
   334	}
   335	
   336	// ── 渲染（M2：只出文本、不碰退出码；调用方设 process.exitCode 自然返回，防管道截断）──
   337	export function renderTier2Result({ result, consumerProblems = [], judgeEvidence = null }) {
   338	  const lines = [];
   339	  for (const it of result.readiness) {
   340	    lines.push(`${it.status === 'ok' ? 'ok  ' : 'RED '} [${it.id}] ${it.detail}${it.hint ? '  → ' + it.hint : ''}`);
   341	  }
   342	  for (const it of (result.judgeSmoke ? result.judgeSmoke.items : [])) {
   343	    lines.push(`${it.status === 'ok' ? 'ok  ' : 'RED '} [${it.id}] ${it.detail}`);
   344	  }
   345	  for (const p of consumerProblems) lines.push(`  用例集/证据件：${p}`);
   346	  for (const cr of result.caseResults) {
   347	    const label = cr.ran ? (cr.machineRed ? 'RED ' : 'ok  ') : 'skip';
   348	    const why = cr.ran ? '' : `（${(cr.receipt && cr.receipt.refusalReason) || '拒跑'}）`;
   349	    lines.push(`${label} [${cr.caseId}] 落账 ${cr.receiptClass}${why}`);
   350	  }
   351	  // 证据落盘状态分三态：跑了例且允许落 / 跑了例但扫描命中零落盘 / 一例未跑（无用例证据可落）。
   352	  const evidenceNote = result.caseResults.length === 0
   353	    ? '无用例证据（一例未跑）'
   354	    : (result.evidenceEmitted ? '允许' : '零落盘（fail-closed）');
