   196	  for (const [rel, want] of Object.entries(artifacts)) {
   197	    const abs = join(PROJECT_ROOT, rel);
   198	    if (!existsSync(abs)) { problems.push(`执行件不在场：${rel}`); continue; }
   199	    if (sha256(readFileSync(abs)) !== want) { problems.push(`执行件 hash 失配：${rel}`); continue; }
