   213	export function readWinProbeResult(manifest) {
   214	  const rel = manifest && manifest.json && typeof manifest.json.winProbeResultPath === 'string' ? manifest.json.winProbeResultPath : null;
   215	  const miss = { present: false, ok: false, producedAt: null, problems: ['连通结果路径未在 manifest 声明或非法'] };
   216	  if (!isRepoRelativePath(rel, ['runs/'])) return miss;
   217	  const abs = join(PROJECT_ROOT, rel);
   218	  if (!existsSync(abs)) return { present: false, ok: false, producedAt: null, problems: ['连通结果文件不在场'] };
   219	  const doc = readJsonStrict(abs);
   220	  const problems = [];
   221	  if (!doc || typeof doc !== 'object') problems.push('连通结果不是合法 JSON 对象');
   222	  else {
   223	    if (doc.schemaVersion !== 1) problems.push('连通结果 schemaVersion 不符');
   224	    if (doc.artifactKind !== 'tier2-connectivity-probe') problems.push('连通结果 artifactKind 不符');
   225	    if (doc.segment !== 'windows-to-target') problems.push('连通结果 segment 不符（须真实目标段）');
   226	    if (doc.ok !== true) problems.push('连通结果自陈不成功');
