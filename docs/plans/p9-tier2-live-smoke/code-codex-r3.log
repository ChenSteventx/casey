   157	  const verifiedMembers = [];
   158	  if (structural.ok) {
   159	    for (const member of structural.members) {
   160	      const files = {};
   161	      let memberOk = true;
   162	      for (const [rel, want] of Object.entries(member.artifacts)) {
   163	        const abs = join(PROJECT_ROOT, rel);
   164	        if (!existsSync(abs)) { problems.push(`成员 ${member.caseId} 的冻结件不在场：${rel}`); memberOk = false; continue; }
   165	        if (sha256(readFileSync(abs)) !== want) { problems.push(`成员 ${member.caseId} 的冻结件 hash 失配：${rel}`); memberOk = false; continue; }
