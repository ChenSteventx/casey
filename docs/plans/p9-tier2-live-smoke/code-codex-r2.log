    24	// ── ① 排他 run 目录 ───────────────────────────────────────────
    25	export function createExclusiveRunDir(caseId, { attempts = 8 } = {}) {
    26	  const parent = join(PROJECT_ROOT, 'runs', caseId);
    27	  mkdirSync(parent, { recursive: true });
    28	  for (let i = 0; i < attempts; i++) {
    29	    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\./g, '');
    30	    const runId = `run_tier2_${stamp}_${randomBytes(3).toString('hex')}`;
    31	    const abs = join(parent, runId);
    32	    try {
    33	      mkdirSync(abs, { recursive: false }); // 已存在即抛（排他创建，绝不复用）
    34	    } catch { continue; }
    35	    if (readdirSync(abs).length !== 0) continue; // 新建目录必须为空，否则换一个
    36	    return { runId, runDirAbs: abs, runDirRel: `runs/${caseId}/${runId}` };
    37	  }
    38	  return null;
    39	}
    40	
    41	function statusClassOf(status) {
    42	  return Number.isInteger(status) && status > 0 ? `${Math.floor(status / 100)}xx` : null;
    43	}
