   104	// 运行时冒烟：真调现役裁判二进制。返回结构直接喂纯层 judgeTier2JudgeChannelSmoke。
   105	export function collectTier2JudgeSmoke(manifest) {
   106	  const fixtureAbs = join(PROJECT_ROOT, FIXTURE_REL);
   107	  const precedents = verifyHistoricalPrecedents(manifest);
   108	  const base = {
   109	    ran: false, fixtureChecksumOk: false, cases: [], statesProduced: [], precedents,
   110	    problems: [],
   111	  };
   112	  if (!existsSync(fixtureAbs)) return { ...base, problems: ['冻结反例集夹具不在场'] };
   113	  const bytes = readFileSync(fixtureAbs);
   114	  const frozen = frozenFixtureChecksum();
   115	  const digest = sha256(bytes);
   116	  const fixtureChecksumOk = typeof frozen === 'string' && frozen === digest;
   117	  const problems = [];
   118	  if (typeof frozen !== 'string') problems.push('反例集夹具未冻入任何契约 testChecksums');
   119	  else if (!fixtureChecksumOk) problems.push('反例集夹具字节已漂移（与在册冻结值失配）');
   120	  if (!existsSync(VERDICT_BIN)) return { ...base, fixtureChecksumOk, problems: [...problems, '裁判二进制不在场'] };
   121	
   122	  let fixture;
   123	  try { fixture = JSON.parse(bytes.toString('utf8')); }
   124	  catch { return { ...base, fixtureChecksumOk, problems: [...problems, '反例集夹具不是合法 JSON'] }; }
