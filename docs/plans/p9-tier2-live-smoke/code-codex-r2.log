    71	    seen.add(id);
    72	    if (!['read', 'mutation'].includes(member.effect)) problems.push(`成员 ${id} 的 effect 须 ∈ {read,mutation}`);
    73	    if (member.smokeAuthorized !== true) problems.push(`成员 ${id} 缺 smoke 授权标志`);
    74	    if (!Number.isInteger(member.timeoutMs) || member.timeoutMs <= 0) problems.push(`成员 ${id} 未声明合法超时`);
    75	    if (typeof member.cleanupObligation !== 'string' || !member.cleanupObligation.trim()) problems.push(`成员 ${id} 未声明清理义务`);
