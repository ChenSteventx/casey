    85	// 派生：与金牌 T8 同构（引已冻接缝再定点改一处，不倒着裁）。
    86	function applyDerivation(kind, input) {
    87	  if (kind === 'arrivalTwo') {
    88	    input.steps[0].action = {
    89	      kind: 'click', resolution: 'none',
    90	      identityReadback: { ok: false },
    91	      driftProbe: { sameSignatureUniquePresent: false },
    92	    };
    93	    input.steps[0].forensics.network[0].status = 200;
    94	    input.steps[0].forensics.network[0].errorEnvelope = { field: 'status', expected: 200, actual: 500, ok: false };
    95	    return input;
    96	  }
    97	  if (kind === 'misattributed') {
    98	    input.steps[0].forensics.network[0].attributedStepId = 'atstep_99';
    99	    return input;
   100	  }
   101	  return input;
   102	}
