   255	export async function executeTier2({ parsed, manifest }) {
   256	  const now = new Date().toISOString();
   257	  const freshnessWindowMs = Number.isInteger(manifest.json?.connectivityFreshnessWindowMs)
   258	    ? manifest.json.connectivityFreshnessWindowMs : DEFAULT_FRESHNESS_WINDOW_MS;
   259	  const { site, env: doctorEnv } = await collectDoctorEnv();
   260	  const winTarget = readWinProbeResult(manifest);
   261	  const outOfBand = readOutOfBandReceipt(manifest);
   262	  const probes = {
   263	    node: doctorEnv.node,
   264	    playwright: doctorEnv.playwright,
   265	    chromium: doctorEnv.chromium,
   266	    creds: doctorEnv.creds,
   267	    // 壳层对每例恒透传登录引导（GRILL D4：production 受众锁无登录必被凭据上下文门拒）。
   268	    loginBootstrap: { requestedForEveryCase: true },
   269	    executionTarget: {
   270	      resolved: site.present === true && doctorEnv.executionTarget?.ready === true,
   271	      mode: doctorEnv.executionTarget?.transportMode || null,
   272	    },
   273	    tunnel: { proxyPort: doctorEnv.tunnel.proxyPort, portListening: doctorEnv.tunnel.portListening },
   274	    suiteManifest: {
   275	      present: manifest.present, checksumOk: manifest.checksumOk, signed: manifest.signed,
   276	      memberCount: manifest.memberCount, caseLimit: manifest.caseLimit,
   277	    },
   278	    outOfBandReceipt: outOfBand,
   279	    connectivity: { winTarget, wslTunnel: await probeLoopbackTunnelSegment(parsed.sut) },
   280	  };
   281	  const consumerProblems = [...manifest.problems, ...(winTarget.problems || []), ...(outOfBand.problems || [])];
   282	
   283	  // 覆盖矩阵第三面（裁判通道运行时冒烟）：零 SUT 接触，先跑先留证；红则纯层按空覆盖判 exit 2。
   284	  const judgeSmoke = collectTier2JudgeSmoke(manifest);
   285	  const judgeEvidence = persistJudgeSmokeEvidence(judgeSmoke);
   286	
   287	  const readiness = judgeTier2Readiness({ now, freshnessWindowMs, probes });
   288	  const envBase = { now, freshnessWindowMs, probes, judgeSmoke };
   289	  // fail-closed：前置门任一红 → 一例不跑（子进程从未启动）。
   290	  if (!readiness.ok) return { result: runTier2({ ...envBase, cases: [] }), consumerProblems, judgeEvidence };
   291	
   292	  const selected = parsed.requestedCases.length
   293	    ? manifest.members.filter((m) => parsed.requestedCases.includes(m.caseId))
   294	    : manifest.members;
   295	  const exitCodeLegend = collectExitCodeLegend();
   296	  const cases = [];
   297	  for (const member of selected) {
   298	    const authorizedMutation = parsed.authorizedMutations.includes(member.caseId);
   299	    const entry = {
   300	      caseId: member.caseId,
   301	      effect: member.effect,
   302	      smokeAuthorized: member.smokeAuthorized === true,
   303	      authorizedMutation,
   304	    };
   305	    const screen = screenTier2CaseAuthorization(entry);
   306	    if (!screen.ran) {
   307	      // 拒跑：绝不启动子进程，但 receipt 照落（授权缺失原因在册）。
   308	      entry.receipt = writeRefusalReceipt({ member, refusalReason: screen.refusalReason, authorizedMutation });
   309	      entry.projection = null;
   310	      cases.push(entry);
   311	      continue;
   312	    }
   313	    const outcome = runOneCase({ member, sut: parsed.sut, exitCodeLegend, authorizedMutation });
   314	    entry.receipt = outcome.receipt;
   315	    entry.projection = outcome.projection;
   316	    cases.push(entry);
   317	    if (outcome.receipt.class === 'systemic_abort') break; // 系统性故障立即停全集
   318	  }
   319	  return { result: runTier2({ ...envBase, cases }), consumerProblems, judgeEvidence };
   320	}
