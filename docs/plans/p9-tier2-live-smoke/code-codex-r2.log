    77	  const args = (Array.isArray(argv) ? argv : []).map(String);
    78	  const errors = [];
    79	  const requestedCases = [];      // 收数组并钉给定顺序（现役通用解析器是后值覆盖前值，不能用）
    80	  const requestedMutations = [];
    81	  let sut = null;
    82	  let sutSeen = false;
    83	
    84	  for (let i = 0; i < args.length; i++) {
    85	    const a = args[i];
    86	    const at = i;
    87	    const value = (code) => {
    88	      const v = args[i + 1];
    89	      if (v === undefined || v.startsWith('--')) { errors.push(err(code, at)); return null; }
    90	      i += 1;
    91	      return v;
    92	    };
    93	    if (a === '--tier2') continue;
    94	    if (a === '--tier1') { errors.push(err('TIER2_ARG_TIER1_CONFLICT', at, { detail: '两层自检各跑一次，绝不混开' })); continue; }
    95	    if (a === '--sut') {
    96	      const v = value('TIER2_ARG_SUT_VALUE_MISSING');
    97	      if (v !== null) {
    98	        if (sutSeen) errors.push(err('TIER2_ARG_SUT_DUPLICATE', at));
    99	        sutSeen = true;
   100	        sut = v;
   101	      }
   102	      continue;
   103	    }
   104	    if (a === '--case') {
   105	      const v = value('TIER2_ARG_CASE_VALUE_MISSING');
   106	      if (v !== null) requestedCases.push({ value: v, argIndex: i });
   107	      continue;
   108	    }
   109	    if (a === '--authorize-mutation') {
   110	      const v = value('TIER2_ARG_MUTATION_VALUE_MISSING');
   111	      if (v !== null) requestedMutations.push({ value: v, argIndex: i });
   112	      continue;
   113	    }
   114	    // 未知旗标/游离位置参数：只出序号，绝不回显 token（可能是误放的地址或凭据）。
   115	    errors.push(err('TIER2_ARG_UNKNOWN_FLAG', at, { category: redactCategory(a) }));
   116	  }
   117	
   118	  if (!sutSeen) errors.push(err('TIER2_ARG_SUT_MISSING', -1, { detail: '只吃隧道回环基址' }));
   119	  else if (!isLoopbackBaseUrl(sut)) errors.push(err('TIER2_ARG_SUT_NOT_LOOPBACK', -1, { detail: '真目标地址绝不进命令行（原值不回显）' }));
   120	
   121	  const seenCases = new Set();
   122	  const safeCases = [];
   123	  for (const item of requestedCases) {
   124	    const { value: id, argIndex } = item;
   125	    const safe = SAFE_CASE_ID.test(id);
   126	    if (seenCases.has(id)) {
   127	      errors.push(err('TIER2_ARG_CASE_DUPLICATE', argIndex, safe ? { safeValue: id } : { category: redactCategory(id) }));
   128	      continue;
   129	    }
   130	    seenCases.add(id);
   131	    if (!safe) { errors.push(err('TIER2_ARG_CASE_ID_UNSAFE', argIndex, { category: redactCategory(id) })); continue; }
   132	    safeCases.push(id);
   133	    if (!memberIds.has(id)) errors.push(err('TIER2_ARG_CASE_NOT_MEMBER', argIndex, { safeValue: id, detail: '零动态发现：只认人签用例集成员' }));
   134	  }
   135	  if (requestedCases.length > caseLimit) {
   136	    errors.push(err('TIER2_ARG_CASE_LIMIT_EXCEEDED', -1, { detail: `给了 ${requestedCases.length} 条，上限 ${caseLimit}` }));
   137	  }
   138	
   139	  const seenMutations = new Set();
   140	  for (const item of requestedMutations) {
   141	    const { value: id, argIndex } = item;
   142	    const safe = SAFE_CASE_ID.test(id);
   143	    if (seenMutations.has(id)) {
   144	      errors.push(err('TIER2_ARG_MUTATION_DUPLICATE', argIndex, safe ? { safeValue: id } : { category: redactCategory(id) }));
   145	      continue;
   146	    }
   147	    seenMutations.add(id);
   148	    if (!safe) { errors.push(err('TIER2_ARG_MUTATION_ID_UNSAFE', argIndex, { category: redactCategory(id) })); continue; }
   149	    if (!memberIds.has(id)) { errors.push(err('TIER2_ARG_MUTATION_NOT_MEMBER', argIndex, { safeValue: id })); continue; }
   150	    if (Object.keys(memberEffects).length && memberEffects[id] !== 'mutation') {
   151	      errors.push(err('TIER2_ARG_MUTATION_EFFECT_MISMATCH', argIndex, { safeValue: id, detail: '非变更型成员无需逐次授权' }));
