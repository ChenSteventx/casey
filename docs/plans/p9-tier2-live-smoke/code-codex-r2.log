   135	// ── 单例执行（走生产 run 同链，不自建第二条编排）─────────────────
   136	export function runOneCase({ member, sut, exitCodeLegend, authorizedMutation }) {
   137	  const caseId = member.caseId;
   138	  const recorder = createScanRecorder();
   139	  // spawn 前重核执行件（H3 ⑤）：核过才跑，并把精确路径显式交给生产 run（不靠约定解析兜底）。
   140	  const files = verifyMemberExecutionFiles(member);
   141	  const dir = files.ok ? createExclusiveRunDir(caseId) : null;
   142	  if (!files.ok || !dir) {
   143	    const receipt = baseReceipt({
   144	      caseId, member, authorizedMutation, cls: 'stage_failed', ran: true,
   145	      runDirRel: dir ? dir.runDirRel : null,
   146	      extra: { preflightProblems: files.ok ? ['排他 run 目录创建失败'] : files.problems },
   147	    });
   148	    return { receipt, projection: null, receiptWritten: false, scan: { stages: [], hits: [] } };
   149	  }
   150	
   151	  const timeoutMs = Number.isInteger(member.timeoutMs) && member.timeoutMs > 0 ? member.timeoutMs : DEFAULT_CASE_TIMEOUT_MS;
   152	  const args = ['run', caseId, '--sut', sut, '--run-dir', dir.runDirAbs, '--login-bootstrap',
   153	    '--events', files.paths['events.json'],
   154	    '--expected', files.paths['expected.frozen.json'],
   155	    '--profile', files.paths['profile.json'],
   156	    '--case-meta', files.paths['testcase.json'],
   157	  ];
   158	  if (files.paths['entity-locks.frozen.json']) args.push('--entity-locks', files.paths['entity-locks.frozen.json']);
   159	  if (typeof member.uniqueNameToken === 'string' && member.uniqueNameToken) args.push('--unique-name', member.uniqueNameToken);
   160	
   161	  const startedAtMs = Date.now();
   162	  const child = spawnSync(NODE_EXE, [CASEY_BIN, ...args], {
   163	    cwd: PROJECT_ROOT, encoding: 'utf8', timeout: timeoutMs, killSignal: 'SIGKILL',
   164	  });
   165	  const durationMs = Date.now() - startedAtMs;
   166	  // 原始字节先扫（H4）：子进程两路输出；stderr 命中单列具名规则。
   167	  recorder.scan(child.stdout, 'raw_bytes');
   168	  recorder.scan(child.stderr, 'raw_bytes', { rule: 'child-stderr-sensitive' });
   169	  const timedOut = child.error && (child.error.code === 'ETIMEDOUT' || /timed?\s*out/i.test(String(child.error.message || '')));
   170	  const systemicCode = classifySystemicRefusal(String(child.stdout || '') + String(child.stderr || ''));
   171	  const childExitCode = Number.isInteger(child.status) ? child.status : null;
   172	
   173	  // 原始产物逐件按字节扫 → 解析 → 白名单投影（阶段记账由 recorder 出，不硬写常量）。
   174	  const projected = projectRunArtifacts({
   175	    caseId, runDirRel: dir.runDirRel, runDirAbs: dir.runDirAbs, exitCodeLegend,
   176	    expectedAbs: files.paths['expected.frozen.json'], recorder, startedAtMs,
   177	  });
   178	  const classified = classifyTier2Receipt({ projected, timedOut, systemicCode, childExitCode, exitCodeLegend });
   179	
   180	  const receipt = baseReceipt({
   181	    caseId, member, authorizedMutation, cls: classified.receiptClass, ran: true, runDirRel: dir.runDirRel,
   182	    extra: {
   183	      childExitCode,
   184	      childExitInLegend: Number.isInteger(childExitCode) && exitCodeLegend.includes(childExitCode),
