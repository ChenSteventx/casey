    60	// 出口渲染：一行一条，只出码 + 序号 + 类别/安全值/计数。
    61	export function formatTier2ArgErrors(errors) {
    62	  return (Array.isArray(errors) ? errors : []).map((e) => {
    63	    const pos = Number.isInteger(e.argIndex) && e.argIndex >= 0 ? `第 ${e.argIndex + 1} 个参数` : '整体用参';
    64	    const tailParts = [];
    65	    if (e.safeValue) tailParts.push(`用例 ${e.safeValue}`);
    66	    if (e.category) tailParts.push(`值类别 ${e.category}（原值不回显）`);
    67	    if (e.detail) tailParts.push(e.detail);
    68	    return `- [${e.code}] ${pos}${tailParts.length ? '：' + tailParts.join('；') : ''}`;
    69	  });
    70	}
