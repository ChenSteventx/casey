   130	  const tmp = mkdtempSync(join(tmpdir(), 'casey-tier2-judge-'));
   131	  const cases = [];
   132	  const statesProduced = new Set();
   133	  try {
   134	    for (const spec of TIER2_JUDGE_COUNTEREXAMPLES) {
   135	      const input = frozenCase(spec.from);
   136	      if (!input) {
   137	        cases.push({ ...toCaseShape(spec), ok: false, actualVerdict: null, actualReason: null, problem: '夹具缺该已冻案' });
   138	        continue;
   139	      }
   140	      const axesFile = join(tmp, `${spec.id}.in.json`);
   141	      const outFile = join(tmp, `${spec.id}.out.json`);
   142	      writeFileSync(axesFile, JSON.stringify(applyDerivation(spec.derive, input)), 'utf8');
   143	      const child = spawnSync(NODE_EXE, [VERDICT_BIN, '--axes', axesFile, '--out', outFile], {
   144	        cwd: PROJECT_ROOT, encoding: 'utf8', timeout: 60000,
   145	      });
