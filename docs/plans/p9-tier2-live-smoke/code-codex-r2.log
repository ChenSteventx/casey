   322	// ── 渲染（M2：只出文本、不碰退出码；调用方设 process.exitCode 自然返回，防管道截断）──
   323	export function renderTier2Result({ result, consumerProblems = [], judgeEvidence = null }) {
   324	  const lines = [];
   325	  for (const it of result.readiness) {
   326	    lines.push(`${it.status === 'ok' ? 'ok  ' : 'RED '} [${it.id}] ${it.detail}${it.hint ? '  → ' + it.hint : ''}`);
   327	  }
   328	  for (const it of (result.judgeSmoke ? result.judgeSmoke.items : [])) {
   329	    lines.push(`${it.status === 'ok' ? 'ok  ' : 'RED '} [${it.id}] ${it.detail}`);
   330	  }
   331	  for (const p of consumerProblems) lines.push(`  用例集/证据件：${p}`);
   332	  for (const cr of result.caseResults) {
   333	    const label = cr.ran ? (cr.machineRed ? 'RED ' : 'ok  ') : 'skip';
   334	    const why = cr.ran ? '' : `（${(cr.receipt && cr.receipt.refusalReason) || '拒跑'}）`;
   335	    lines.push(`${label} [${cr.caseId}] 落账 ${cr.receiptClass}${why}`);
   336	  }
   337	  // 证据落盘状态分三态：跑了例且允许落 / 跑了例但扫描命中零落盘 / 一例未跑（无用例证据可落）。
   338	  const evidenceNote = result.caseResults.length === 0
   339	    ? '无用例证据（一例未跑）'
   340	    : (result.evidenceEmitted ? '允许' : '零落盘（fail-closed）');
   341	  lines.push(`覆盖矩阵：取证面 ${result.coverage.forensics ? '非空' : '空'} / 流式面 ${result.coverage.streaming ? '非空' : '空'} / SUT_DEFECT 面 ${result.coverage.sutDefect ? '成立' : '未成立'}；用例证据落盘 ${evidenceNote}`);
   342	  if (judgeEvidence && judgeEvidence.path) lines.push(`裁判通道冒烟证据：${judgeEvidence.path}`);
   343	  for (const r of result.reasons || []) lines.push(`  ${r}`);
   344	  if (result.exitCode === 0 && result.tailLine) lines.push('', result.tailLine);
   345	  const sealed = sealTier2Output(lines.join('\n'));
   346	  return { text: sealed.text, sealed: sealed.ok };
   347	}

