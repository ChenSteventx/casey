    45	// ── ③ 原始字节先扫 + 白名单投影 ──────────────────────────────
    46	export function projectRunArtifacts({ caseId, runDirRel, runDirAbs, exitCodeLegend, expectedAbs, recorder, startedAtMs }) {
    47	  const rawInputs = [
    48	    ['axes', join(runDirAbs, 'axes.json')],
    49	    ['verdict', join(runDirAbs, 'verdict.json')],
    50	    ['reportModel', join(runDirAbs, 'report-model.json')],
    51	    ['expected', expectedAbs],
    52	  ];
    53	  const docs = {};
    54	  const staleArtifacts = [];
    55	  for (const [key, abs] of rawInputs) {
    56	    if (!abs || !existsSync(abs)) { docs[key] = null; continue; }
    57	    // 生成时刻核验（H5）：run 目录内产物必须是本次启动之后生成的。
    58	    if (key !== 'expected' && Number.isFinite(startedAtMs)) {
    59	      let mtimeMs = 0;
    60	      try { mtimeMs = statSync(abs).mtimeMs; } catch { mtimeMs = 0; }
    61	      if (!(mtimeMs >= startedAtMs)) staleArtifacts.push(key);
    62	    }
    63	    const scanned = scanRawArtifactFile(abs);
    64	    if (recorder) recorder.add(scanned.hits);
    65	    docs[key] = scanned.json;
    66	  }
    67	  if (recorder) recorder.complete('raw_bytes'); // 原始字节阶段到此真跑完
    68	
    69	  const axesDoc = docs.axes;
    70	  const verdictDoc = docs.verdict;
    71	  const modelDoc = docs.reportModel;
    72	  const expectedDoc = docs.expected;
    73	
    74	  const outcome = summarizeRunVerdict(verdictDoc);
    75	  const unknownStates = [...new Set((Array.isArray(verdictDoc?.steps) ? verdictDoc.steps : [])
    76	    .map((s) => s && s.verdict)
    77	    .filter((v) => typeof v === 'string' && !Object.keys(outcome.counts).includes(v)))];
    78	
    79	  const rawSteps = Array.isArray(axesDoc?.steps) ? axesDoc.steps : [];
    80	  const steps = rawSteps.map((s) => {
    81	    const posts = Array.isArray(s?.postAssertions) ? s.postAssertions : [];
    82	    return {
    83	      stepId: typeof s?.stepId === 'string' ? s.stepId : null,
    84	      intentId: typeof s?.intentId === 'string' ? s.intentId : null,
    85	      kind: (s?.action && typeof s.action.kind === 'string') ? s.action.kind
    86	        : (s?.atom && typeof s.atom.kind === 'string' ? s.atom.kind : null),
    87	      hardAssertionKinds: posts.filter((a) => a && a.soft === false).map((a) => a.kind),
    88	      judgedAssertionKinds: posts.filter((a) => a && typeof a.ok === 'boolean').map((a) => a.kind),
    89	    };
    90	  });
    91	
    92	  // 网络取证：只留发起方 / 归因步 / 状态码类别——地址、正文、请求头一律不投影。
    93	  const netEntries = [];
    94	  let networkPresent = false;
    95	  for (const s of rawSteps) {
    96	    const list = s && s.forensics && Array.isArray(s.forensics.network) ? s.forensics.network : null;
    97	    if (!list) continue;
    98	    networkPresent = true;
    99	    for (const e of list) {
   100	      netEntries.push({
   101	        initiator: typeof e?.initiator === 'string' ? e.initiator : null,
   102	        attributedStepId: e && Object.prototype.hasOwnProperty.call(e, 'attributedStepId')
   103	          ? (typeof e.attributedStepId === 'string' ? e.attributedStepId : null)
   104	          : undefined,
   105	        statusClass: statusClassOf(e?.status),
   106	      });
   107	    }
   108	  }
   109	  // 「按发起方归因」是产物的结构性属性：逐条都带发起方分类与归因步字段才算成立。
   110	  const attributedByInitiator = netEntries.length > 0 && netEntries.every((e) => typeof e.initiator === 'string'
   111	    && e.initiator && Object.prototype.hasOwnProperty.call(e, 'attributedStepId'));
   112	
   113	  let lifecyclePresent = false;
   114	  let pageerrorCount = 0;
   115	  let crashed = false;
   116	  for (const s of rawSteps) {
   117	    const lc = s && s.forensics ? s.forensics.lifecycle : null;
   118	    if (!lc || typeof lc !== 'object') continue;
   119	    lifecyclePresent = true;
   120	    if (Array.isArray(lc.pageerror)) pageerrorCount += lc.pageerror.length;
   121	    if (lc.crashed === true) crashed = true;
   122	  }
   123	
   124	  // 流式断言：期望侧取已签契约（证明真被要求），裁定侧取三轴步账（证明真被裁过）。
   125	  const expectedStream = [];
   126	  for (const intent of Array.isArray(expectedDoc?.intents) ? expectedDoc.intents : []) {
   127	    for (const a of Array.isArray(intent?.expected) ? intent.expected : []) {
   128	      if (!a || a.kind !== 'streamReplyReceived') continue;
   129	      const step = steps.find((s) => s.intentId === intent.intentId && s.hardAssertionKinds.includes('streamReplyReceived'))
   130	        || steps.find((s) => s.intentId === intent.intentId);
   131	      expectedStream.push({
   132	        intentId: typeof intent.intentId === 'string' ? intent.intentId : null,
   133	        stepId: step ? step.stepId : null,
   134	        kind: 'streamReplyReceived',
   135	        soft: a.soft === true,
   136	      });
   137	    }
   138	  }
   139	  const judgedStream = [];
   140	  for (const s of rawSteps) {
   141	    for (const a of Array.isArray(s?.postAssertions) ? s.postAssertions : []) {
   142	      if (!a || a.kind !== 'streamReplyReceived') continue;
   143	      judgedStream.push({
   144	        intentId: typeof s.intentId === 'string' ? s.intentId : null,
   145	        stepId: typeof s.stepId === 'string' ? s.stepId : null,
   146	        kind: 'streamReplyReceived',
   147	        ok: typeof a.ok === 'boolean' ? a.ok : null,
   148	      });
   149	    }
   150	  }
   151	
   152	  const projection = {
   153	    caseId,
   154	    runDir: runDirRel,
   155	    verdict: {
   156	      schemaOk: !!verdictDoc && !outcome.malformed,
   157	      stateCounts: outcome.counts,
   158	      unknownStates,
   159	      // catch-all 可达性：单 run 侧的可观测代理（产物零四态外标签、四态计数齐全）；
   160	      // 裁判本体的 catch-all 由第三面「裁判通道运行时冒烟」真调二进制作证。
   161	      catchAllReachable: !!verdictDoc && !outcome.malformed && unknownStates.length === 0,
   162	    },
   163	    axes: {
   164	      schemaOk: !!axesDoc && rawSteps.length > 0,
   165	      steps,
   166	      forensics: {
   167	        network: { present: networkPresent, attributedByInitiator, entries: netEntries },
   168	        lifecycle: { present: lifecyclePresent, pageerrorCount, crashed },
   169	      },
   170	    },
   171	    reportModel: {
   172	      schemaOk: !!modelDoc && Number.isInteger(modelDoc.schemaVersion),
   173	      exitCodeLegend,
   174	      badgeStates: modelDoc && modelDoc.verdictSummary && typeof modelDoc.verdictSummary === 'object'
   175	        ? Object.keys(modelDoc.verdictSummary) : [],
   176	    },
   177	    streamingAssertions: { expected: expectedStream, judged: judgedStream },
   178	  };
   179	  // 投影阶段复扫（白名单外嵌套敏感值若混进投影，在此暴露）。
   180	  if (recorder) {
   181	    recorder.scan(JSON.stringify(projection), 'projection');
   182	    recorder.complete('projection');
   183	  }
   184	
   185	  // ② 完整附件集 + 报告三件
   186	  const attachments = {};
   187	  for (const name of REQUIRED_ATTACHMENTS) attachments[name] = existsSync(join(runDirAbs, name));
   188	  for (const suffix of REPORT_SUFFIXES) attachments[`${caseId}.${suffix}`] = existsSync(join(runDirAbs, `${caseId}.${suffix}`));
   189	  const attachmentsComplete = Object.values(attachments).every(Boolean);
   190	
   191	  return {
   192	    projection,
   193	    attachments,
   194	    attachmentsComplete,
   195	    staleArtifacts,
   196	    someArtifacts: !!axesDoc || !!verdictDoc || !!modelDoc,
   197	    verdictWellFormed: !!verdictDoc && !outcome.malformed && unknownStates.length === 0,
   198	    allPass: outcome.allPass,
   199	    stateCounts: outcome.counts,
   200	  };
   201	}
