   227	  }
   228	  return {
   229	    present: true,
   230	    ok: problems.length === 0,
   231	    producedAt: doc && typeof doc.producedAt === 'string' ? doc.producedAt : null,
   232	    problems,
   233	  };
   234	}
   235	
   236	export function readOutOfBandReceipt(manifest) {
   237	  const rel = manifest && manifest.json && typeof manifest.json.outOfBandReceiptPath === 'string' ? manifest.json.outOfBandReceiptPath : null;
   238	  if (!isRepoRelativePath(rel, ['runs/'])) return { present: false, acknowledged: false, confirmedAt: null, problems: ['带外回执路径未在 manifest 声明或非法'] };
   239	  const abs = join(PROJECT_ROOT, rel);
   240	  if (!existsSync(abs)) return { present: false, acknowledged: false, confirmedAt: null, problems: ['带外回执文件不在场'] };
   241	  const doc = readJsonStrict(abs);
   242	  const problems = [];
   243	  if (!doc || typeof doc !== 'object') problems.push('带外回执不是合法 JSON 对象');
   244	  else {
   245	    if (doc.schemaVersion !== 1) problems.push('带外回执 schemaVersion 不符');
   246	    if (doc.artifactKind !== 'tier2-out-of-band-receipt') problems.push('带外回执 artifactKind 不符');
   247	    if (doc.acknowledged !== true) problems.push('带外回执未标确认');
   248	    if (typeof doc.confirmedAt !== 'string' || !doc.confirmedAt) problems.push('带外回执缺确认时点');
   249	  }
   250	  // 白名单投影：只出标志与时点，其余字段一律不读出模块。
   251	  return {
   252	    present: true,
   253	    acknowledged: problems.length === 0,
   254	    confirmedAt: doc && typeof doc.confirmedAt === 'string' ? doc.confirmedAt : null,
