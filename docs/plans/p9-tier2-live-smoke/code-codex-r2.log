   153	    }
   154	    if (requestedCases.length && !seenCases.has(id)) {
   155	      errors.push(err('TIER2_ARG_MUTATION_NOT_SELECTED', argIndex, { safeValue: id }));
   156	    }
   157	  }
   158	
   159	  return {
   160	    ok: errors.length === 0,
   161	    exitCode: errors.length === 0 ? 0 : 64,
   162	    errors,
   163	    errorCodes: errors.map((e) => e.code),
   164	    sut,
   165	    // 依给定次序的安全 caseId 列（拒付回执与执行选集共用；形状不合格的值不入列、不回显）
   166	    requestedCases: safeCases,
   167	    authorizedMutations: requestedMutations.filter((m) => SAFE_CASE_ID.test(m.value)).map((m) => m.value),
   168	    caseLimit,
   169	  };
   170	}
