   259	// 先例 hash 绑定核验（第三面证据的一半；另一半是裁判二进制冒烟）。
   260	export function verifyHistoricalPrecedents(manifest) {
   261	  const list = manifest && manifest.json && Array.isArray(manifest.json.historicalPrecedents) ? manifest.json.historicalPrecedents : [];
   262	  return list.map((raw) => {
   263	    const p = raw && typeof raw === 'object' ? raw : {};
   264	    const id = typeof p.id === 'string' ? p.id : '未标注';
   265	    const digest = typeof p.sha256 === 'string' ? p.sha256 : '';
   266	    const pathOk = isRepoRelativePath(p.path, ['runs/']);
   267	    const attestOk = isRepoRelativePath(p.attestedIn, ['docs/']) && existsSync(join(PROJECT_ROOT, p.attestedIn));
   268	    let attestRecordsHash = false;
   269	    if (attestOk && SHA256_HEX.test(digest)) {
   270	      try { attestRecordsHash = readFileSync(join(PROJECT_ROOT, p.attestedIn), 'utf8').includes(digest.slice(0, 8)); } catch { attestRecordsHash = false; }
   271	    }
   272	    const abs = pathOk ? join(PROJECT_ROOT, p.path) : null;
   273	    const artifactPresent = !!abs && existsSync(abs);
   274	    let hashMatch = null;
   275	    let producedAt = null;
   276	    if (artifactPresent) {
   277	      try {
   278	        hashMatch = sha256(readFileSync(abs)) === digest;
   279	        producedAt = new Date(statSync(abs).mtimeMs).toISOString();
   280	      } catch { hashMatch = false; }
   281	    }
   282	    return {
   283	      id,
   284	      hashBound: pathOk && SHA256_HEX.test(digest) && attestOk && attestRecordsHash,
   285	      artifactPresent,
   286	      hashMatch,
   287	      attestedIn: typeof p.attestedIn === 'string' ? p.attestedIn : null,
   288	      producedAt,
   289	    };
   290	  });
   291	}
     1	// lib/selftest-tier2-collect.mjs —— casey selftest --tier2 真机冒烟自检【编排壳】
     2	//   （GRILL D3 + plan §1.2；联审 r1 逐条收口后拆模块：manifest/scan/judge-smoke/projection 各自成件）。
     3	// 本层只做「采集 + 编排 + 渲染」，一个判据都不自造：
     4	//   ① 读人签用例集 manifest（零动态发现，闭合校验在 selftest-tier2-manifest.mjs）；
     5	//   ② 严格解析用参（拒付码与脱敏回显在 selftest-tier2-args.mjs）；
     6	//   ③ 采前置门探针（doctor 导出探针 + 两段连通 + 带外回执，消费端严格校验形状）；
     7	//   ④ 跑覆盖矩阵第三面：裁判通道运行时冒烟（selftest-tier2-judge-smoke.mjs），并落持久证据；
     8	//   ⑤ 逐例走生产 run 同链（排他 run 目录 + 核过的执行件精确路径），落 receipt；
