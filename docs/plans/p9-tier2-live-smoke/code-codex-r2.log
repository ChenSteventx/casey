   329	export function screenTier2CaseAuthorization(entry = {}) {
   330	  const e = obj(entry);
   331	  if (e.smokeAuthorized !== true) {
   332	    return { ran: false, refusalReason: 'manifest_smoke_authorized_flag_absent' };
   333	  }
   334	  if (e.effect !== 'read' && e.effect !== 'mutation') {
   335	    return { ran: false, refusalReason: 'effect_class_unauthorized' };
   336	  }
   337	  if (e.effect === 'mutation' && e.authorizedMutation !== true) {
   338	    return { ran: false, refusalReason: 'per_run_mutation_authorized_flag_absent' };
   339	  }
   340	  return { ran: true, refusalReason: null };
   341	}
