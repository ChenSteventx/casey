   203	// ── receipt 归类（五类 + 一致性判据；plan §1.3）─────────────────
   204	export function classifyTier2Receipt({ projected, timedOut, systemicCode, childExitCode, exitCodeLegend }) {
   205	  const problems = [];
   206	  if (timedOut) return { receiptClass: 'timeout', problems: ['超出用例声明超时'] };
   207	  if (systemicCode) return { receiptClass: 'systemic_abort', problems: [`系统性前置闸拒付：${systemicCode}`] };
   208	
   209	  const exitInLegend = Number.isInteger(childExitCode) && (exitCodeLegend || []).includes(childExitCode);
   210	  if (!exitInLegend) problems.push(`子进程退出码不在归一图例内（${childExitCode}）`);
   211	  if (projected.staleArtifacts.length) problems.push(`产物早于本次启动（疑复用旧件）：${projected.staleArtifacts.join('/')}`);
   212	  // 生产 run 契约：全 PASS ⇔ exit 0。两侧不自洽即工装红，绝不当管线完成。
   213	  if (childExitCode === 0 && projected.allPass !== true) problems.push('子进程 exit 0 但裁定非全 PASS（自相矛盾）');
   214	  if (childExitCode === 1 && projected.allPass === true) problems.push('子进程 exit 1 但裁定全 PASS（自相矛盾）');
   215	  if (!projected.verdictWellFormed) problems.push('裁定产物不合法或含四态外标签');
   216	  if (!projected.attachmentsComplete) {
   217	    const missing = Object.entries(projected.attachments).filter(([, v]) => !v).map(([k]) => k);
   218	    problems.push(`附件集不完整：缺 ${missing.join('/')}`);
   219	  }
   220	
   221	  if (!problems.length) return { receiptClass: 'pipeline_complete_with_verdict', problems };
   222	  if (projected.someArtifacts) return { receiptClass: 'partial_artifacts', problems };
   223	  return { receiptClass: 'stage_failed', problems };
   224	}

