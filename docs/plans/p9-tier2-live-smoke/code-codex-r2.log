   379	  items.push(!missingStates.length && !extraStates.length
   380	    ? ok('judge-four-states-exact', '四态精确全覆盖（无第五态）')
   381	    : fail('judge-four-states-exact', `四态覆盖不精确（缺 ${missingStates.join('/') || '无'}；多 ${extraStates.join('/') || '无'}）`,
