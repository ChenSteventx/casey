    41	
    42	  if (m.artifactKind !== 'tier2-suite-manifest') problems.push('manifest artifactKind 不符（须 tier2-suite-manifest）');
    43	  if (!Number.isInteger(m.schemaVersion) || m.schemaVersion <= 0) problems.push('manifest 缺合法 schemaVersion');
