   206	// ── 消费端严格校验（M3）：连通结果 / 带外回执 ─────────────────────
   207	function readJsonStrict(absPath) {
   208	  try { return JSON.parse(readFileSync(absPath, 'utf8')); } catch { return null; }
   209	}
