    17	// 生产 run 的完整附件集（replay/verdict/report-model/report 四段的落盘约定）。
    18	// 录屏旁件（video.webm/json）按既有「收敛失败容忍」口径不入必备集。
    19	const REQUIRED_ATTACHMENTS = Object.freeze([
    20	  'axes.json', 'verdict.json', 'report-model.json', 'run-history.jsonl', 'run-metrics.json',
    21	]);
    22	const REPORT_SUFFIXES = Object.freeze(['report.html', 'report.md', 'report.json']);
