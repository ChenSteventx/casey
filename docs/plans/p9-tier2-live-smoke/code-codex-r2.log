    96	  const precedents = Array.isArray(m.historicalPrecedents) ? m.historicalPrecedents : [];
    97	  if (!precedents.length) problems.push('manifest 未记历史真机先例（SUT_DEFECT 面证据引用）');
    98	  for (const p of precedents) {
