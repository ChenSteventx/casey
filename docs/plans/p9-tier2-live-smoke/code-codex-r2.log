    62	  }
    63	  if (caseLimit !== null && members.length > caseLimit) problems.push(`成员数超声明上限（${members.length} > ${caseLimit}）`);
    64	
    65	  const seen = new Set();
    66	  for (const raw of members) {
    67	    const member = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
    68	    const id = member.caseId;
    69	    if (typeof id !== 'string' || !SAFE_CASE_ID.test(id)) { problems.push(`成员 caseId 不安全或缺失（只允许字母数字下划线单段）`); continue; }
