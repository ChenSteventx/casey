   147	        cases.push({ ...toCaseShape(spec), ok: false, actualVerdict: null, actualReason: null, problem: `裁判二进制非零退出（${child.status}）或零产物` });
   148	        continue;
   149	      }
   150	      let out;
   151	      try { out = JSON.parse(readFileSync(outFile, 'utf8')); }
   152	      catch { cases.push({ ...toCaseShape(spec), ok: false, actualVerdict: null, actualReason: null, problem: '裁判产物不是合法 JSON' }); continue; }
   153	      const step = out && Array.isArray(out.steps) ? out.steps[0] : null;
   154	      const actualVerdict = step && typeof step.verdict === 'string' ? step.verdict : null;
   155	      const actualReason = step && typeof step.reason === 'string' ? step.reason : null;
   156	      if (actualVerdict) statesProduced.add(actualVerdict);
   157	      const ok = actualVerdict === spec.expectVerdict
   158	        && TIER2_FOUR_STATES.includes(actualVerdict)
   159	        && (!spec.expectReason || actualReason === spec.expectReason);
   160	      cases.push({ ...toCaseShape(spec), ok, actualVerdict, actualReason, problem: ok ? null : '与冻结期望不符' });
   161	    }
   162	  } finally {
   163	    rmSync(tmp, { recursive: true, force: true });
   164	  }
   165	
