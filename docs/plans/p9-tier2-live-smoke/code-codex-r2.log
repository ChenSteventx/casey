   113	function baseReceipt({ caseId, member, authorizedMutation, cls, ran, runDirRel, extra = {}, refusalReason = null }) {
   114	  return {
   115	    schemaVersion: 1,
   116	    artifactKind: 'tier2-run-receipt',
   117	    caseId,
   118	    class: cls,
   119	    ran,
   120	    runDir: runDirRel,
   121	    effect: member.effect,
   122	    loginBootstrap: true,
   123	    // 字段名避开禁字段关键词表（自家账不许被自家扫描判命中）。
   124	    approval: {
   125	      smokeAuthorized: member.smokeAuthorized === true,
   126	      perRunApproved: authorizedMutation === true,
   127	      source: 'signed-suite-manifest',
   128	    },
   129	    ...(refusalReason ? { refusalReason } : {}),
   130	    ...extra,
   131	    generatedAt: new Date().toISOString(),
   132	  };
   133	}
