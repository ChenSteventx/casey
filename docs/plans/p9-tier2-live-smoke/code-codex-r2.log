   408	export function runTier2(env = {}) {
   409	  const e = obj(env);
   410	  const readinessResult = judgeTier2Readiness(e);
   411	  const readiness = readinessResult.items;
   412	  // 第三面恒判（缺席即红）：判定不依赖用例跑没跑，故前置门红/空集时也如实出这一面。
   413	  const judgeSmoke = judgeTier2JudgeChannelSmoke(e.judgeSmoke);
   414	  const emptyResult = (reasons) => ({
   415	    exitCode: 2,
   416	    readiness,
   417	    caseResults: [],
   418	    coverage: { forensics: false, streaming: false, sutDefect: judgeSmoke.ok },
   419	    judgeSmoke,
   420	    evidenceEmitted: false,
   421	    aborted: false,
   422	    stoppedAtCaseId: null,
   423	    tailLine: null,
   424	    reasons,
   425	  });
   426	  // fail-closed：前置门任一红 → 一例不跑（run 子进程从未启动的机器可读形态 = caseResults 为空）。
   427	  if (!readinessResult.ok) return emptyResult([`前置门红：${readinessResult.redIds.join('/')}`]);
   428	
   429	  const cases = arr(e.cases).map(obj);
   430	  if (!cases.length) return emptyResult(['用例集为空（覆盖矩阵空，绝不空转成绿）']);
   431	
   432	  const caseResults = [];
   433	  const reasons = [];
   434	  let aborted = false;
   435	  let stoppedAtCaseId = null;
   436	  let refusedCount = 0;
   437	  let machineRedCount = 0;
   438	  let scanViolation = false;
   439	
   440	  for (const entry of cases) {
   441	    const caseId = typeof entry.caseId === 'string' ? entry.caseId : null;
   442	    const auth = screenTier2CaseAuthorization(entry);
