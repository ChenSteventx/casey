   259	// 先例 hash 绑定核验（第三面证据的一半；另一半是裁判二进制冒烟）。
   260	export function verifyHistoricalPrecedents(manifest) {
   261	  const list = manifest && manifest.json && Array.isArray(manifest.json.historicalPrecedents) ? manifest.json.historicalPrecedents : [];
   262	  return list.map((raw) => {
   263	    const p = raw && typeof raw === 'object' ? raw : {};
   264	    const id = typeof p.id === 'string' ? p.id : '未标注';
   265	    const digest = typeof p.sha256 === 'string' ? p.sha256 : '';
   266	    const pathOk = isRepoRelativePath(p.path, ['runs/']);
   267	    const attestOk = isRepoRelativePath(p.attestedIn, ['docs/']) && existsSync(join(PROJECT_ROOT, p.attestedIn));
   268	    let attestRecordsHash = false;
   269	    if (attestOk && SHA256_HEX.test(digest)) {
   270	      try { attestRecordsHash = readFileSync(join(PROJECT_ROOT, p.attestedIn), 'utf8').includes(digest.slice(0, 8)); } catch { attestRecordsHash = false; }
   271	    }
   272	    const abs = pathOk ? join(PROJECT_ROOT, p.path) : null;
   273	    const artifactPresent = !!abs && existsSync(abs);
   274	    let hashMatch = null;
   275	    let producedAt = null;
   276	    if (artifactPresent) {
   277	      try {
   278	        hashMatch = sha256(readFileSync(abs)) === digest;
   279	        producedAt = new Date(statSync(abs).mtimeMs).toISOString();
   280	      } catch { hashMatch = false; }
   281	    }
   282	    return {
   283	      id,
   284	      hashBound: pathOk && SHA256_HEX.test(digest) && attestOk && attestRecordsHash,
   285	      artifactPresent,
   286	      hashMatch,
   287	      attestedIn: typeof p.attestedIn === 'string' ? p.attestedIn : null,
   288	      producedAt,
   289	    };
   290	  });
   291	}
     1	// lib/selftest-tier2-scan.mjs —— tier-2 凭据兜底扫描【采集层】
     2	//   （GRILL D2 v3 扫描时序；联审 r1 H4 + M1 收口）。
     3	// 三条纪律：
     4	//   ① 时序：原始字节先扫（子进程输出 + 每个原始产物文件的字节，解析之前）→ 白名单投影 → 落盘前复扫；
     5	//      阶段只在【真正跑完】才记账（记账器由本模块出，不许硬写三阶段常量冒充跑满）；
     6	//   ② 判据复用共享凭据门（`lib/cred-gate.mjs`）：禁字段关键词 + 凭据文件真实敏感字面量，
     7	//      外加非回环地址形态——不自造第二套敏感判据；
     8	//   ③ 出口零回显：命中只出「阶段 + 规则码」，命中内容一律不出模块；最终渲染文本再过凭据门。
     9	import { readFileSync } from 'node:fs';
    10	import { FORBIDDEN_KEYWORDS, collectSecretLiterals, credentialGate } from './cred-gate.mjs';
    11	import { TIER2_SCAN_STAGES, isLoopbackBaseUrl } from './selftest-tier2.mjs';
    12	
    13	const URL_SHAPE = /https?:\/\/[^\s"'`,)\]}]+/g;
    14	
    15	// 凭据文件敏感字面量池：一个进程内取一次（每次重取都要读凭据文件，越少越好）。
    16	// 唯一剔除项：回环基址本身。GRILL D6 已定「隧道回环基址非敏感」（doctor 就直接回显回环端口号），
    17	//   而站点配置里的 devProxyUrl 会被共享池当敏感字面量收进来——不剔除的话，
    18	//   凡产物里出现回环基址（legacy-loopback 传输模式下的浏览器可见地址就是它）就会命中，
    19	//   于是每次真机跑都零证据落盘：这是无安全收益的 fail-closed 地雷。
    20	//   剔除面严格限「整个字面量就是一个回环基址」，其余字面量（含任何含回环子串的长值）一律照收。
    21	let literalPool = null;
    22	function secretLiterals() {
    23	  if (literalPool === null) {
    24	    try { literalPool = collectSecretLiterals().filter((s) => !isLoopbackBaseUrl(s)); }
    25	    catch { literalPool = []; }
    26	  }
    27	  return literalPool;
    28	}
    29	
    30	// 单段文本扫描：命中即返回具名规则（内容绝不带出）。
    31	export function scanTextForSensitive(text, stage, { rule = 'nested-sensitive-value' } = {}) {
    32	  const hits = [];
    33	  const raw = typeof text === 'string' ? text : String(text == null ? '' : text);
    34	  const lower = raw.toLowerCase();
    35	  for (const kw of FORBIDDEN_KEYWORDS) {
    36	    if (lower.includes(kw)) { hits.push({ stage, rule }); break; }
    37	  }
    38	  for (const lit of secretLiterals()) {
    39	    if (lit && raw.includes(lit)) { hits.push({ stage, rule: 'secret-literal' }); break; }
    40	  }
    41	  for (const found of raw.match(URL_SHAPE) || []) {
    42	    if (!isLoopbackBaseUrl(found)) { hits.push({ stage, rule: 'target-address-shape' }); break; }
    43	  }
    44	  return hits;
    45	}
    46	
    47	// 原始产物字节扫描（H4）：解析之前先按字节过一遍——白名单投影会把嵌套敏感值丢掉，
    48	//   若只扫投影后的结果，原始产物里的敏感值就永远看不见了。畸形 JSON 单列具名规则。
    49	export function scanRawArtifactFile(absPath, { stage = 'raw_bytes', rule = 'nested-sensitive-value' } = {}) {
    50	  let text;
    51	  try { text = readFileSync(absPath, 'utf8'); }
    52	  catch { return { read: false, hits: [], json: null }; }
    53	  const hits = scanTextForSensitive(text, stage, { rule });
    54	  let json = null;
    55	  try { json = JSON.parse(text); }
    56	  catch { hits.push({ stage, rule: 'malformed-json' }); }
    57	  return { read: true, hits, json, byteLength: Buffer.byteLength(text, 'utf8') };
    58	}
    59	
    60	// 阶段记账器：`complete(stage)` 只在该阶段真跑完时调；未跑的阶段不进账，
    61	//   于是「三阶段有序跑满」这条判据由实际执行产生，不是常量冒充。
    62	export function createScanRecorder() {
    63	  const hits = [];
    64	  const stages = [];
    65	  return {
    66	    add(newHits) { for (const h of newHits || []) hits.push(h); return this; },
    67	    scan(text, stage, opts) { return this.add(scanTextForSensitive(text, stage, opts)); },
    68	    complete(stage) {
    69	      if (!TIER2_SCAN_STAGES.includes(stage)) throw new Error(`未知扫描阶段：${stage}`);
    70	      if (!stages.includes(stage)) stages.push(stage);
    71	      return this;
    72	    },
    73	    snapshot() { return { stages: [...stages], hits: hits.map((h) => ({ ...h })) }; },
    74	    get hitCount() { return hits.length; },
    75	  };
    76	}
    77	
    78	// 出口密封（M1）：最终渲染文本过共享凭据门——【逐行】密封。
    79	// 逐行而非整段：整段抹掉会把全部诊断一起烧掉（一个误报就等于没有输出可看），
    80	//   逐行既保住 fail-closed（命中行一个字符都不出去），又不牵连无辜行。
    81	const SEALED_LINE = '[本行经凭据兜底门判命中，已整行抑制（fail-closed，护栏 #7）]';
    82	export function sealTier2Output(text, label = 'tier2-output') {
    83	  const s = typeof text === 'string' ? text : String(text == null ? '' : text);
    84	  const gate = (piece) => {
    85	    try { return credentialGate({ [label]: piece }).ok === true; }
    86	    catch { return false; }
    87	  };
    88	  if (gate(s)) return { ok: true, text: s, sealedLines: 0 };
    89	  let sealedLines = 0;
    90	  const out = s.split('\n').map((line) => {
    91	    if (!line.trim() || gate(line)) return line;
    92	    sealedLines += 1;
    93	    return SEALED_LINE;
    94	  });
    95	  return { ok: false, text: out.join('\n'), sealedLines };
    96	}
     1	// lib/selftest-tier2-projection.mjs —— tier-2 单 run 产物白名单投影 + receipt 归类【采集层】
     2	//   （plan §1.2/§1.3；联审 r1 H4 + H5 收口）。
     3	// 三条硬纪律：
