    36	  if (typeof value !== 'string' || !value.trim()) return false;
    37	  try {
    38	    const u = new URL(value);
    39	    if (!['http:', 'https:'].includes(u.protocol)) return false;
    40	    if (u.username || u.password) return false;
    41	    return LOOPBACK_HOSTS.has(u.hostname);
    42	  } catch { return false; }
    43	}
