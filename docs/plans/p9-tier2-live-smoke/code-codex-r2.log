   123	// ── 采集：单次读字节 → hash → 同一份字节解析 → 结构校验 → 磁盘件核验 ────
   124	export function readSuiteManifest() {
   125	  const manifestAbs = process.env.AT_TIER2_MANIFEST || join(PROJECT_ROOT, MANIFEST_REL);
   126	  const absent = {
   127	    present: false, signed: false, checksumOk: false, memberCount: 0,
   128	    caseLimit: TIER2_DEFAULT_CASE_LIMIT, members: [], memberIds: [], memberEffects: {},
   129	    json: null, digest: null, problems: ['人签 manifest 不在场（草案不算数）'],
   130	  };
   131	  if (!existsSync(manifestAbs)) return absent;
   132	
   133	  let bytes;
   134	  try { bytes = readFileSync(manifestAbs); } catch { return { ...absent, present: true, problems: ['manifest 不可读'] }; }
   135	  const digest = sha256(bytes);                       // ① hash 与解析同一份字节
   136	  let doc = null;
   137	  let parseOk = true;
   138	  try { doc = JSON.parse(bytes.toString('utf8')); } catch { parseOk = false; }
   139	  if (!parseOk) {
   140	    return {
   141	      ...absent, present: true, digest, problems: ['manifest 不是合法 JSON'],
   142	    };
   143	  }
   144	
   145	  const structural = validateSuiteManifestDoc(doc);
   146	  const problems = [...structural.problems];
   147	
   148	  const frozen = frozenManifestChecksum();
   149	  let checksumOk = false;
   150	  if (typeof frozen !== 'string') problems.push('manifest 未冻入契约 testChecksums（未在册即不放行）');
   151	  else if (frozen !== digest) problems.push('manifest 字节与契约冻结值失配（件已漂移）');
   152	  else checksumOk = true;
   153	
   154	  // 磁盘件核验：结构合格的成员逐件核字节 hash（缺件/失配 → 整集 fail-closed）。
   155	  const verifiedMembers = [];
   156	  if (structural.ok) {
   157	    for (const member of structural.members) {
   158	      const files = {};
   159	      let memberOk = true;
   160	      for (const [rel, want] of Object.entries(member.artifacts)) {
   161	        const abs = join(PROJECT_ROOT, rel);
   162	        if (!existsSync(abs)) { problems.push(`成员 ${member.caseId} 的冻结件不在场：${rel}`); memberOk = false; continue; }
   163	        if (sha256(readFileSync(abs)) !== want) { problems.push(`成员 ${member.caseId} 的冻结件 hash 失配：${rel}`); memberOk = false; continue; }
   164	        files[rel.slice(`cases/${member.caseId}/`.length)] = abs;
   165	      }
   166	      if (!memberOk) { checksumOk = false; continue; }
   167	      verifiedMembers.push({ ...member, verifiedFiles: files });
   168	    }
   169	  } else {
   170	    checksumOk = false;
   171	  }
   172	
   173	  const acceptable = structural.ok && checksumOk;
   174	  return {
   175	    present: true,
   176	    signed: structural.signedOk,
   177	    checksumOk,
   178	    memberCount: acceptable ? verifiedMembers.length : 0,
   179	    caseLimit: structural.caseLimit,
   180	    members: acceptable ? verifiedMembers : [],
   181	    memberIds: acceptable ? verifiedMembers.map((m) => m.caseId) : [],
   182	    memberEffects: acceptable ? Object.fromEntries(verifiedMembers.map((m) => [m.caseId, m.effect])) : {},
   183	    json: doc,
   184	    digest,
   185	    problems,
   186	  };
   187	}
   188	
   189	// ⑤ spawn 前重核执行件：字节 hash 再核一遍（准入到执行之间的 TOCTOU 缝），出核过的精确路径。
   190	export function verifyMemberExecutionFiles(member) {
   191	  const problems = [];
   192	  const paths = {};
   193	  const artifacts = member && member.artifacts && typeof member.artifacts === 'object' ? member.artifacts : {};
   194	  for (const [rel, want] of Object.entries(artifacts)) {
   195	    const abs = join(PROJECT_ROOT, rel);
   196	    if (!existsSync(abs)) { problems.push(`执行件不在场：${rel}`); continue; }
   197	    if (sha256(readFileSync(abs)) !== want) { problems.push(`执行件 hash 失配：${rel}`); continue; }
   198	    paths[rel.slice(`cases/${member.caseId}/`.length)] = abs;
   199	  }
   200	  for (const need of REQUIRED_ARTIFACT_NAMES) {
   201	    if (!paths[need]) problems.push(`执行件缺必备项：${need}`);
   202	  }
   203	  return { ok: problems.length === 0, problems, paths };
   204	}
