    45	// 脱敏类别：只描述「值长什么样」，绝不带值本身。
    46	export function redactCategory(value) {
    47	  const s = String(value == null ? '' : value);
    48	  if (/:\/\//.test(s)) return '地址形态';
    49	  if (/[/\\]/.test(s)) return '含路径分隔符';
    50	  if (s.includes('..')) return '含上跳段';
    51	  if (s.startsWith('-')) return '旗标形态';
    52	  if (/[^A-Za-z0-9_]/.test(s)) return '含非法字符';
    53	  return '形状不合格';
    54	}
