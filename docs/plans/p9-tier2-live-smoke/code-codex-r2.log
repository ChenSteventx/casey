    51	  const caseLimit = Number.isInteger(m.caseLimit) && m.caseLimit > 0 ? m.caseLimit : null;
    52	  if (caseLimit === null) problems.push('manifest 未声明合法 caseLimit');
    53	
    54	  for (const [key, prefix] of [['winProbeResultPath', 'runs/'], ['outOfBandReceiptPath', 'runs/']]) {
    55	    if (!isRepoRelativePath(m[key], [prefix])) problems.push(`manifest 的 ${key} 非法（须仓内相对路径、无上跳段、落在 ${prefix} 下）`);
