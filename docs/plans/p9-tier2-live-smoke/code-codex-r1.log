   168	  const p = obj(e.probes);
   169	  const now = e.now;
   170	  const win = e.freshnessWindowMs;
   171	  const items = [
   172	    checkNode(p.node),
   173	    checkPlaywrightPresent(p.playwright),
   174	    checkPlaywrightImportable(p.playwright),
   175	    checkChromium(p.chromium),
   176	    credsShapeItem(p.creds),
   177	    loginBootstrapItem(p.loginBootstrap),
   178	    executionTargetItem(p.executionTarget),
   179	    tunnelListeningItem(p.tunnel),
   180	    outOfBandReceiptItem(p.outOfBandReceipt, now, win),
   181	    connectivityItem('connectivity-win-target', obj(p.connectivity).winTarget, now, win, '真实目标段'),
   182	    connectivityItem('connectivity-wsl-tunnel', obj(p.connectivity).wslTunnel, now, win, '回环→隧道段'),
   183	    suiteManifestItem(p.suiteManifest),
