   330	// ── 逐次授权筛（壳层 spawn 前与聚合层判定共用同一判据，防两处漂移）──────
   331	// 拒付码用词纪律：这些码会写进 receipt，而 receipt 落盘前要过凭据兜底扫描（`lib/cred-gate.mjs`
   332	//   的禁字段关键词表含 authorization/token/secret/cookie...）——自家字段名与码值一律避开禁词，
   333	//   否则自己的账会被自己的扫描判命中、零证据落盘（本会话探针实测过这个坑）。
   334	export function screenTier2CaseAuthorization(entry = {}) {
   335	  const e = obj(entry);
   336	  if (e.smokeAuthorized !== true) {
   337	    return { ran: false, refusalReason: 'manifest_smoke_authorized_flag_absent' };
   338	  }
   339	  if (e.effect !== 'read' && e.effect !== 'mutation') {
   340	    return { ran: false, refusalReason: 'effect_class_unauthorized' };
   341	  }
   342	  if (e.effect === 'mutation' && e.authorizedMutation !== true) {
   343	    return { ran: false, refusalReason: 'per_run_mutation_authorized_flag_absent' };
   344	  }
   345	  return { ran: true, refusalReason: null };
   346	}
   347	
   348	// ── tier-2 专用严格解析器（GRILL D2 v3；现役通用解析器的 --case 后值覆盖前值不可用）──
   349	// 重复 --case 收数组并钉顺序；缺值/重复/危险 caseId/非成员/超上限/未知参数/两层并出/非回环 --sut 全拒 64。
   350	export function parseTier2Args(argv = [], ctx = {}) {
   351	  const c = obj(ctx);
   352	  const memberIds = new Set(arr(c.memberIds).map(String));
   353	  const memberEffects = obj(c.memberEffects);
   354	  const caseLimit = Number.isInteger(c.caseLimit) && c.caseLimit > 0 ? c.caseLimit : TIER2_DEFAULT_CASE_LIMIT;
   355	  const args = arr(argv).map(String);
   356	  const errors = [];
   357	  const requestedCases = [];
   358	  const requestedMutations = [];
   359	  let sut = null;
   360	  let sutSeen = false;
   361	
   362	  for (let i = 0; i < args.length; i++) {
   363	    const a = args[i];
   364	    const value = (flag) => {
   365	      const v = args[i + 1];
   366	      if (v === undefined || v.startsWith('--')) { errors.push(`--${flag} 缺值`); return null; }
   367	      i += 1;
   368	      return v;
   369	    };
   370	    if (a === '--tier2') continue;
   371	    if (a === '--tier1') { errors.push('--tier1 与 --tier2 不得并出（两层自检各跑一次，绝不混开）'); continue; }
   372	    if (a === '--sut') {
   373	      const v = value('sut');
   374	      if (v !== null) {
   375	        if (sutSeen) errors.push('--sut 重复给值');
   376	        sutSeen = true;
   377	        sut = v;
   378	      }
   379	      continue;
   380	    }
   381	    if (a === '--case') { const v = value('case'); if (v !== null) requestedCases.push(v); continue; }
   382	    if (a === '--authorize-mutation') { const v = value('authorize-mutation'); if (v !== null) requestedMutations.push(v); continue; }
   383	    errors.push(`未知参数 ${a}`);
   384	  }
   385	
   386	  if (!sutSeen) errors.push('缺 --sut（只吃隧道回环基址）');
   387	  else if (!isLoopbackBaseUrl(sut)) errors.push('--sut 只吃隧道回环基址（非回环基址一律拒，真目标地址绝不进命令行）');
   388	
   389	  const seenCases = new Set();
   390	  for (const id of requestedCases) {
   391	    if (seenCases.has(id)) { errors.push(`--case 重复：${id}`); continue; }
   392	    seenCases.add(id);
   393	    if (!SAFE_CASE_ID.test(id)) { errors.push(`--case caseId 不安全（只允许字母数字下划线单段）：${id}`); continue; }
   394	    if (!memberIds.has(id)) errors.push(`--case 非人签 manifest 成员（零动态发现）：${id}`);
   395	  }
   396	  if (requestedCases.length > caseLimit) {
   397	    errors.push(`--case 数超 manifest 声明上限（${requestedCases.length} > ${caseLimit}）`);
   398	  }
   399	
   400	  const seenMutations = new Set();
   401	  for (const id of requestedMutations) {
   402	    if (seenMutations.has(id)) { errors.push(`--authorize-mutation 重复：${id}`); continue; }
   403	    seenMutations.add(id);
   404	    if (!SAFE_CASE_ID.test(id)) { errors.push(`--authorize-mutation caseId 不安全：${id}`); continue; }
   405	    if (!memberIds.has(id)) { errors.push(`--authorize-mutation 非人签 manifest 成员：${id}`); continue; }
   406	    if (Object.keys(memberEffects).length && memberEffects[id] !== 'mutation') {
   407	      errors.push(`--authorize-mutation 指向非变更型成员（无需逐次授权）：${id}`);
   408	      continue;
   409	    }
   410	    if (requestedCases.length && !seenCases.has(id)) {
   411	      errors.push(`--authorize-mutation 指向本次未选中的用例：${id}`);
   412	    }
   413	  }
   414	
   415	  return {
   416	    ok: errors.length === 0,
   417	    exitCode: errors.length === 0 ? 0 : 64,
   418	    errors,
   419	    sut,
   420	    requestedCases: [...requestedCases],
   421	    authorizedMutations: [...requestedMutations],
   422	    caseLimit,
   423	  };
   424	}
   425	
   426	// ── 聚合（plan §1.1：前置门红 → 2；证据红 → 1；全绿 → 0 + 尾行常量）─────
   427	function coverageOf(caseResults) {
   428	  const ran = caseResults.filter((r) => r.ran);
   429	  const forensics = ran.some((r) => {
   430	    const ids = arr(obj(r.evidence).items).filter((i) => !isRed(i)).map((i) => i.id);
   431	    return ids.includes('network-forensics-attribution') && ids.includes('lifecycle-forensics');
   432	  });
   433	  const streaming = ran.some((r) => arr(obj(obj(r.projection).streamingAssertions).expected)
   434	    .map(obj).some((e) => e.kind === 'streamReplyReceived' && e.soft === false));
   435	  return { forensics, streaming };
   436	}
   437	
   438	export function runTier2(env = {}) {
   439	  const e = obj(env);
   440	  const readinessResult = judgeTier2Readiness(e);
   441	  const readiness = readinessResult.items;
   442	  const emptyResult = (reasons) => ({
   443	    exitCode: 2,
   444	    readiness,
   445	    caseResults: [],
   446	    coverage: { forensics: false, streaming: false },
   447	    evidenceEmitted: false,
   448	    aborted: false,
   449	    stoppedAtCaseId: null,
   450	    tailLine: null,
   451	    reasons,
   452	  });
   453	  // fail-closed：前置门任一红 → 一例不跑（run 子进程从未启动的机器可读形态 = caseResults 为空）。
   454	  if (!readinessResult.ok) return emptyResult([`前置门红：${readinessResult.redIds.join('/')}`]);
   455	
   456	  const cases = arr(e.cases).map(obj);
   457	  if (!cases.length) return emptyResult(['用例集为空（覆盖矩阵空，绝不空转成绿）']);
   458	
   459	  const caseResults = [];
   460	  const reasons = [];
   461	  let aborted = false;
   462	  let stoppedAtCaseId = null;
   463	  let refusedCount = 0;
   464	  let machineRedCount = 0;
   465	  let scanViolation = false;
   466	
   467	  for (const entry of cases) {
   468	    const caseId = typeof entry.caseId === 'string' ? entry.caseId : null;
   469	    const auth = screenTier2CaseAuthorization(entry);
   470	    if (!auth.ran) {
   471	      refusedCount += 1;
   472	      reasons.push(`用例 ${caseId} 拒跑：${auth.refusalReason}`);
   473	      caseResults.push({
   474	        caseId,
   475	        ran: false,
   476	        machineRed: false,
   477	        receiptClass: 'refused_unauthorized',
   478	        receipt: {
   479	          ...obj(entry.receipt),
   480	          caseId,
   481	          class: 'refused_unauthorized',
   482	          ran: false,
   483	          refusalReason: auth.refusalReason,
   484	        },
   485	        evidence: null,
   486	        projection: null,
   487	      });
   488	      continue;
   489	    }
   490	
   491	    const projection = obj(entry.projection);
   492	    const receipt = obj(entry.receipt);
   493	    const receiptClass = typeof receipt.class === 'string' ? receipt.class : null;
   494	    const evidence = judgeTier2RunEvidence(projection);
   495	    const scan = judgeTier2ScanTimeline(obj(projection.credentialScan));
   496	    if (!scan.emitEvidence) scanViolation = true;
   497	
   498	    let machineRed;
   499	    if (receiptClass === 'pipeline_complete_with_verdict') {
