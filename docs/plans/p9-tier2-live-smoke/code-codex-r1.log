   461	export async function executeTier2({ parsed, manifest }) {
   462	  const now = new Date().toISOString();
   463	  const freshnessWindowMs = Number.isInteger(manifest.json?.connectivityFreshnessWindowMs)
   464	    ? manifest.json.connectivityFreshnessWindowMs : DEFAULT_FRESHNESS_WINDOW_MS;
   465	  const { site, env: doctorEnv } = await collectDoctorEnv();
   466	  const probes = {
   467	    node: doctorEnv.node,
   468	    playwright: doctorEnv.playwright,
   469	    chromium: doctorEnv.chromium,
   470	    creds: doctorEnv.creds,
   471	    // 壳层对每例恒透传登录引导（GRILL D4：production 受众锁无登录必被凭据上下文门拒）。
   472	    loginBootstrap: { requestedForEveryCase: true },
   473	    executionTarget: {
   474	      resolved: site.present === true && doctorEnv.executionTarget?.ready === true,
   475	      mode: doctorEnv.executionTarget?.transportMode || null,
   476	    },
   477	    tunnel: { proxyPort: doctorEnv.tunnel.proxyPort, portListening: doctorEnv.tunnel.portListening },
   478	    suiteManifest: {
   479	      present: manifest.present, checksumOk: manifest.checksumOk, signed: manifest.signed,
   480	      memberCount: manifest.memberCount, caseLimit: manifest.caseLimit,
   481	    },
   482	    outOfBandReceipt: probeOutOfBandReceipt(manifest),
   483	    connectivity: {
   484	      winTarget: probeWinTargetResult(manifest),
   485	      wslTunnel: await probeLoopbackTunnelSegment(parsed.sut),
   486	    },
   487	  };
   488	  const readiness = judgeTier2Readiness({ now, freshnessWindowMs, probes });
   489	  // fail-closed：前置门任一红 → 一例不跑（子进程从未启动）。
   490	  if (!readiness.ok) {
   491	    return { result: runTier2({ now, freshnessWindowMs, probes, cases: [] }), manifestProblems: manifest.problems };
   492	  }
   493	
   494	  const selected = parsed.requestedCases.length
   495	    ? manifest.members.filter((m) => parsed.requestedCases.includes(m.caseId))
   496	    : manifest.members;
   497	  const exitCodeLegend = collectExitCodeLegend();
   498	  const cases = [];
   499	  for (const member of selected) {
   500	    const authorizedMutation = parsed.authorizedMutations.includes(member.caseId);
   501	    const entry = {
   502	      caseId: member.caseId,
   503	      effect: member.effect,
   504	      smokeAuthorized: member.smokeAuthorized === true,
   505	      authorizedMutation,
   506	    };
   507	    const screen = screenTier2CaseAuthorization(entry);
   508	    if (!screen.ran) {
   509	      // 拒跑：绝不启动子进程，但 receipt 照落（授权缺失原因在册）。
   510	      entry.receipt = writeRefusalReceipt({ member, refusalReason: screen.refusalReason, authorizedMutation });
   511	      entry.projection = null;
   512	      cases.push(entry);
   513	      continue;
   514	    }
   515	    const outcome = runOneCase({ member, sut: parsed.sut, exitCodeLegend, authorizedMutation });
   516	    entry.receipt = outcome.receipt;
   517	    entry.projection = outcome.projection;
   518	    cases.push(entry);
   519	    // 系统性故障立即停全集（plan §5 R2）。
   520	    if (outcome.receipt.class === 'systemic_abort') break;
   521	  }
   522	  return { result: runTier2({ now, freshnessWindowMs, probes, cases }), manifestProblems: manifest.problems };
   523	}

