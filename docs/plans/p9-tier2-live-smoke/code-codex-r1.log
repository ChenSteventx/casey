   188	// ── 凭据扫描时序（GRILL D2 v3：先扫原始字节，再投影，落盘前复扫；命中即零证据落盘）──
   189	export function judgeTier2ScanTimeline({ stages, hits } = {}) {
   190	  const seen = arr(stages).map(String);
   191	  const found = arr(hits);
   192	  const orderOk = seen.length === TIER2_SCAN_STAGES.length
   193	    && TIER2_SCAN_STAGES.every((s, i) => seen[i] === s);
   194	  const problems = [];
   195	  if (!orderOk) problems.push(`扫描阶段须严格有序 ${TIER2_SCAN_STAGES.join(' → ')}，实得 ${seen.join(' → ') || '（空）'}`);
   196	  if (found.length > 0) problems.push(`命中 ${found.length} 条（规则 ${found.map((h) => obj(h).rule || '未标注').join('/')}）`);
   197	  const allOk = problems.length === 0;
   198	  return {
   199	    ok: allOk,
   200	    emitEvidence: allOk, // fail-closed：时序不对或有命中 → 一个字节的证据都不许落盘
   201	    stages: seen,
   202	    hitCount: found.length,
   203	    hitRules: found.map((h) => obj(h).rule || 'unlabeled'),
   204	    problems,
   205	  };
   206	}
