   454	    }
   455	    for (const e of parsed.errors) refusalLines.push(`- ${e}`);
   456	    refusalLines.push(`用例集来源：${MANIFEST_REL}（人签，零动态发现；${manifest.present ? `成员 ${manifest.memberCount}` : '当前不在场'}）`);
   457	  }
   458	  return { ok: parsed.ok, parsed, manifest, refusalLines };
   459	}
