   328	// ── 单例执行（走生产 run 同链，不自建第二条编排）─────────────────
   329	function classifySystemicRefusal(text) {
   330	  const raw = String(text == null ? '' : text);
   331	  for (const { code, marker } of SYSTEMIC_REFUSAL_MARKERS) {
   332	    if (raw.includes(marker)) return code;
   333	  }
   334	  return null;
   335	}
   336	
   337	function runOneCase({ member, sut, exitCodeLegend, authorizedMutation }) {
   338	  const caseId = member.caseId;
   339	  const runDirRel = `runs/${caseId}/run_tier2_${stamp()}`;
   340	  const runDirAbs = join(PROJECT_ROOT, runDirRel);
   341	  const timeoutMs = Number.isInteger(member.timeoutMs) && member.timeoutMs > 0 ? member.timeoutMs : DEFAULT_CASE_TIMEOUT_MS;
   342	  const args = ['run', caseId, '--sut', sut, '--run-dir', runDirAbs, '--login-bootstrap'];
   343	  if (typeof member.uniqueNameToken === 'string' && member.uniqueNameToken) args.push('--unique-name', member.uniqueNameToken);
   344	  const t0 = Date.now();
   345	  const child = spawnSync(NODE_EXE, [CASEY_BIN, ...args], {
   346	    cwd: PROJECT_ROOT, encoding: 'utf8', timeout: timeoutMs, killSignal: 'SIGKILL',
   347	  });
   348	  const durationMs = Date.now() - t0;
   349	  // ① 原始字节先扫（子进程 stdout/stderr 都扫；stderr 命中单列具名规则）。
   350	  const hits = [
   351	    ...scanText(child.stdout, 'raw_bytes'),
   352	    ...scanText(child.stderr, 'raw_bytes', { rule: 'child-stderr-sensitive' }),
   353	  ];
   354	  const timedOut = child.error && (child.error.code === 'ETIMEDOUT' || /timed?\s*out/i.test(String(child.error.message || '')));
   355	  const systemicCode = classifySystemicRefusal(String(child.stdout || '') + String(child.stderr || ''));
   356	  const exitCode = Number.isInteger(child.status) ? child.status : null;
   357	
   358	  // ② 白名单投影。
   359	  const projected = projectRunArtifacts({
   360	    caseId, runDirRel, runDirAbs, exitCodeLegend,
   361	    expectedAbs: casePaths(caseId).expected,
   362	  });
   363	  hits.push(...projected.hits);
   364	
   365	  const present = projected.artifactsPresent;
   366	  const allArtifacts = present.axes && present.verdict && present.reportModel && present.report;
   367	  const someArtifacts = present.axes || present.verdict || present.reportModel || present.report;
   368	  const exitInLegend = exitCode === null ? false : exitCodeLegend.includes(exitCode);
   369	  let receiptClass;
   370	  if (timedOut) receiptClass = 'timeout';
   371	  else if (systemicCode) receiptClass = 'systemic_abort';
   372	  else if (allArtifacts && projected.verdictWellFormed && exitInLegend) receiptClass = 'pipeline_complete_with_verdict';
   373	  else if (someArtifacts) receiptClass = 'partial_artifacts';
   374	  else receiptClass = 'stage_failed';
   375	
   376	  const receipt = {
   377	    schemaVersion: 1,
   378	    artifactKind: 'tier2-run-receipt',
   379	    caseId,
   380	    class: receiptClass,
   381	    ran: true,
   382	    runDir: runDirRel,
   383	    effect: member.effect,
   384	    loginBootstrap: true,
   385	    // 字段名避开禁字段关键词表（自家账不许被自家扫描判命中；探针实测过这个坑）。
   386	    approval: {
   387	      smokeAuthorized: member.smokeAuthorized === true,
   388	      perRunApproved: authorizedMutation === true,
   389	      source: 'signed-suite-manifest',
   390	    },
   391	    childExitCode: exitCode,
   392	    childExitInLegend: exitInLegend,
   393	    durationMs,
   394	    timedOut: !!timedOut,
   395	    systemicRefusalCode: systemicCode,
   396	    artifactsPresent: present,
   397	    verdictStateCounts: projected.projection.verdict.stateCounts,
   398	    generatedAt: new Date().toISOString(),
   399	  };
   400	  // ③ 落盘前复扫 → 命中即零 tier-2 证据落盘（生产 run 自身产物归生产链，本层只管 tier-2 证据）。
   401	  const receiptBytes = `${JSON.stringify(receipt, null, 2)}\n`;
   402	  hits.push(...scanText(receiptBytes, 'pre_write'));
   403	  const timeline = judgeTier2ScanTimeline({ stages: [...TIER2_SCAN_STAGES], hits });
   404	  if (timeline.emitEvidence) {
   405	    mkdirSync(runDirAbs, { recursive: true });
   406	    writeFileSync(join(runDirAbs, 'tier2-receipt.json'), receiptBytes, 'utf8');
   407	  }
   408	  const projection = projected.projection;
   409	  projection.credentialScan = { stages: [...TIER2_SCAN_STAGES], hits };
   410	  return { receipt, projection, receiptWritten: timeline.emitEvidence, runDirRel };
   411	}
   412	
   413	export function writeRefusalReceipt({ member, refusalReason, authorizedMutation }) {
   414	  const caseId = member.caseId;
   415	  const runDirRel = `runs/${caseId}/run_tier2_${stamp()}`;
   416	  const receipt = {
