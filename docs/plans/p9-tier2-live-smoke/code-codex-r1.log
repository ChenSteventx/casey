     1	#!/usr/bin/env node
     2	/**
     3	 * casey —— LLM 驱动的「文本用例 → 测试报告」自动化测试 CLI。
     4	 *
     5	 * 生命周期（设计 §3，LLM 只在相0/1/2/5 出现；相3/4/6 是零 LLM 确定性）：
     6	 *   相0 ingest   归一(L1)    excel/json/txt/freetext → 规范 TestCase
     7	 *   相1 compile  编译(L3)    agent 真机跑一遍 → spec/events + observed（地面真值）
     8	 *   相2 draft    断言草拟(L2) 从 intent + observed 推导带类型 expected[]
     9	 *   相2 sign     人签门       人签掉冻结断言（gate 绿 ≠ 完成）
    10	 *   相3 replay   回放(L0)     确定性重放 + 录屏 + 取证（零 LLM）
    11	 *   相4 verdict  多态裁定(L0) verdict.mjs 判定树 → PASS/SUT_DEFECT/HARNESS_ERROR/NEEDS_HUMAN
    12	 *   相5 heal     自愈(L3)     仅对确证 HARNESS_ERROR 的非就地有界重锚
    13	 *   相6 report   报告(L0)     自包含 HTML + 裁定徽章 + 缺陷单
    14	 *   run          端到端串起以上（MVP 串行单用例）
    15	 *
    16	 * loop 机制（薄壳直通 loop-kit）：lint / gate / breaker / contract。
    17	 * selftest --tier1 = hermetic 链路自检（零外部依赖，验证确定性内核 + 统一语言双向有效）。
    18	 *
    19	 * 设计立场：本 CLI 是确定性引擎入口；skill 与 MCP server 都只是它的薄壳。
    20	 * 退出码：0 成功；1 失败/红；2 熔断/互锁拦截；3 该阶段尚未实现（见计划 Pn）；64 用法错误。
    21	 */
    22	import { spawnSync } from 'node:child_process';
    23	import fs from 'node:fs';
    24	import path from 'node:path';
    25	import { PROJECT_ROOT, CASES_DIR, NODE_EXE, kit, casePaths, isSafeCaseId } from '../lib/paths.mjs';
    26	import { summarizeRunVerdict } from '../lib/run-outcome.mjs';
    27	// tier-2 纯层（判定与文案的单一事实源；壳层只采集、转发、按其退出码退出）。
    28	import { TIER2_MACHINE_GREEN_TAIL } from '../lib/selftest-tier2.mjs';
    29	
    30	const C = { reset: '\x1b[0m', cyan: '\x1b[36m', gray: '\x1b[90m', yellow: '\x1b[33m', green: '\x1b[32m', red: '\x1b[31m', bold: '\x1b[1m' };
    31	const col = (c, s) => `${c}${s}${C.reset}`;
    32	
    33	function parseArgs(argv) {
    34	  const opts = {}; const pos = [];
    35	  for (let i = 0; i < argv.length; i++) {
    36	    const a = argv[i];
    37	    if (a.startsWith('--')) {
    38	      const eq = a.indexOf('=');
    39	      if (eq >= 0) opts[a.slice(2, eq)] = a.slice(eq + 1);
    40	      else if (i + 1 < argv.length && !argv[i + 1].startsWith('--')) opts[a.slice(2)] = argv[++i];
    41	      else opts[a.slice(2)] = true;
    42	    } else pos.push(a);
    43	  }
    44	  return { opts, pos };
    45	}
    46	
    47	function runNode(scriptAbs, args, { quiet = false } = {}) {
    48	  const r = spawnSync(NODE_EXE, [scriptAbs, ...args], { cwd: PROJECT_ROOT, stdio: quiet ? 'pipe' : 'inherit', encoding: 'utf8' });
    49	  return { code: r.status ?? 1, stdout: r.stdout || '', stderr: r.stderr || '' };
    50	}
    51	
    52	// ── loop 机制薄壳（直通 loop-kit）──────────────────────────────
    53	function passThrough(kitScript, rest) {
    54	  const r = runNode(kit(kitScript), rest);
    55	  process.exit(r.code);
    56	}
    57	
    58	// 阶段桩已清零：门面最后一个 notImplemented 消费者是 `selftest --tier2`，本契约落地后移除；
    59	// 现存唯一诚实桩是 `heal` 的 --apply/--promote/--reverify 三模式（由 bin/heal.mjs 自陈 exit 3）。
    60	
    61	function blockedByRealSutOnlyPolicy(command) {
    62	  console.error(col(C.red, `\n[${command}] 已由真实 SUT only 策略禁用。`));
    63	  console.error(col(C.gray, 'fake-sut 与夹具 SUT 只允许静态阅读；本入口可能启动历史夹具或执行未经逐条审计的验收命令。'));
    64	  console.error(col(C.gray, '请直接运行已人工确认不接触任何 SUT 的静态/schema/纯函数检查，或在联网真实目标上运行正式用例。\n'));
    65	  process.exit(1);
    66	}
    67	
    68	// ── run：确定性尾段编排（相3 回放 → 相4 裁定 → 报表模型装配 → 相6 报告）────
    69	// LLM 前段（相0-2 ingest/compile/draft/sign）未建、route:human；本命令喂 compile产物直跑尾段。
    70	function runPipeline(pos, opts) {
    71	  const caseId = pos[0];
    72	  const invalidCaseId = Boolean(caseId) && !isSafeCaseId(caseId);
    73	  const safeCaseId = caseId && !invalidCaseId ? caseId : null;
    74	  const cp = safeCaseId ? casePaths(safeCaseId) : null;
