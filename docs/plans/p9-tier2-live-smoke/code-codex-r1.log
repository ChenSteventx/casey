   114	    return { present: true, shapeOk: !!j && typeof j === 'object' && ('user' in j) && ('pass' in j) }; // 只看键名，值不取
   115	  } catch { return { present: true, shapeOk: false }; }
   116	}
   117	
   118	// ── 隧道回环端口 TCP 连（只回状态 + 耗时；绝不回显地址）─────────────
   119	export function probeTunnel(proxyPort) {
   120	  return new Promise((res) => {
   121	    const t0 = Date.now();
   122	    if (proxyPort == null) { res({ proxyPort: null, portListening: false, probeMs: 0 }); return; }
   123	    let done = false;
   124	    const finish = (listening) => {
   125	      if (done) return; done = true;
   126	      try { sock.destroy(); } catch { /* ignore */ }
   127	      res({ proxyPort, portListening: listening, probeMs: Date.now() - t0 });
   128	    };
   129	    const sock = net.connect({ host: '127.0.0.1', port: proxyPort });
   130	    sock.setTimeout(800);
   131	    sock.on('connect', () => finish(true));
   132	    sock.on('timeout', () => finish(false));
   133	    sock.on('error', () => finish(false));
   134	  });
   135	}
   136	
   137	// ── 结构化采集：一次跑齐全部探针 → 纯层 env（doctor 与 tier-2 共用同一入口）──
   138	// 返回 { platform, isWSL, site, env }：site 只给壳层判「配没配」，env 直接喂 lib/doctor.mjs 的 runDoctor。
   139	export async function collectDoctorEnv() {
   140	  const platform = process.platform;
   141	  const isWSL = detectWSL();
   142	  const pw = await probePlaywright();
   143	  const site = probeSite();
   144	  const env = {
   145	    node: { nodeVersion: process.version, requiredRange: requiredNodeRange() },
   146	    playwright: { present: pw.present, importable: pw.importable },
   147	    chromium: { execResolved: pw.execResolved, execExists: pw.execExists },
   148	    fonts: { platform, isWSL, cjkProbeNonEmpty: probeFonts(platform) },
   149	    siteJson: { present: site.present, shapeOk: site.shapeOk },
   150	    creds: probeCreds(),
   151	    tunnel: await probeTunnel(site.proxyPort),
   152	    executionTarget: classifyExecutionTargetShape({
   153	      platform,
   154	      isWSL,
   155	      hasLogicalTarget: site.hasLogicalTarget,
   156	      hasLoopbackTransport: site.hasLoopbackTransport,
   157	      configuredMode: site.configuredMode,
   158	    }),
   159	  };
   160	  return { platform, isWSL, site, env };
   161	}
