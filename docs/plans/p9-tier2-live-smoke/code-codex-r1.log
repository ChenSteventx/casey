    77	    expected: safeCaseId ? `cases/${safeCaseId}/expected.frozen.json` : 'cases/<caseId>/expected.frozen.json',
    78	    entityLocks: safeCaseId ? `cases/${safeCaseId}/entity-locks.frozen.json` : 'cases/<caseId>/entity-locks.frozen.json',
    79	    profile: safeCaseId ? `cases/${safeCaseId}/profile.json` : 'cases/<caseId>/profile.json',
    80	    observed: safeCaseId ? `cases/${safeCaseId}/observed-${safeCaseId}.json` : 'cases/<caseId>/observed-<caseId>.json',
   400	    default:
   401	      console.error(col(C.red, `未知命令：${cmd}`));
   402	      console.error('跑 `casey help` 看命令表。');
   403	      process.exit(64);
   404	  }
   405	}
   406	
