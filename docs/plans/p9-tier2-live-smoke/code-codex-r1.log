   434	  const timeline = judgeTier2ScanTimeline({ stages: [...TIER2_SCAN_STAGES], hits: scanText(bytes, 'pre_write') });
   435	  if (timeline.emitEvidence) {
   436	    mkdirSync(join(PROJECT_ROOT, runDirRel), { recursive: true });
   437	    writeFileSync(join(PROJECT_ROOT, runDirRel, 'tier2-receipt.json'), bytes, 'utf8');
   438	  }
   439	  return receipt;
   440	}
