   224	  const badges = arr(obj(reportModel).badgeStates).map(String);
   225	  const badBadges = badges.filter((b) => !TIER2_FOUR_STATES.includes(b));
   226	  if (badBadges.length) return fail('catch-all-intact', `报表徽章出现四态外标签：${badBadges.join('/')}`, '徽章集只允许四态');
   227	  return ok('catch-all-intact', 'catch-all 语义未被旁路（无第五态、兜底可达）');
   228	}
   229	function networkForensicsItem(axes, network) {
   230	  const a = obj(axes);
   231	  const n = obj(network);
   232	  if (a.schemaOk !== true) return fail('network-forensics-attribution', '三轴产物 schema 不合法', '查相3 回放产物结构');
   233	  if (n.present !== true) return fail('network-forensics-attribution', '网络取证结构缺席', '回放须落网络取证');
   234	  const entries = arr(n.entries);
   235	  if (!entries.length) return fail('network-forensics-attribution', '网络取证在场但零条目', '取证为空不足以背书任何裁定');
   236	  // 归因字段两项都须在场：initiator 非空串（发起方分类），attributedStepId 键在场且为串或 null
   237	  //   （null = 本条不归任何步，正是「背景流量不背书本步」的 fail-safe 表达，不是缺字段）。
   238	  const bad = entries.filter((e) => {
   239	    const it = obj(e);
   240	    if (typeof it.initiator !== 'string' || !it.initiator) return true;
   241	    if (!Object.prototype.hasOwnProperty.call(it, 'attributedStepId')) return true;
   242	    return !(it.attributedStepId === null || (typeof it.attributedStepId === 'string' && it.attributedStepId));
   243	  });
   244	  if (n.attributedByInitiator !== true || bad.length) {
   245	    return fail('network-forensics-attribution', `网络取证未按发起方归因（缺 initiator/attributedStepId 的条目 ${bad.length} 条）`,
   246	      '归因须按发起方，不得退回时间窗猜归属');
   247	  }
   248	  return ok('network-forensics-attribution', `网络取证按发起方归因在场（${entries.length} 条）`);
   249	}
   250	function lifecycleForensicsItem(axes, lifecycle) {
   251	  const a = obj(axes);
   252	  const l = obj(lifecycle);
   253	  if (a.schemaOk !== true) return fail('lifecycle-forensics', '三轴产物 schema 不合法', '查相3 回放产物结构');
   254	  if (l.present !== true) return fail('lifecycle-forensics', '生命周期取证缺席', '回放须落生命周期取证');
   255	  if (typeof l.pageerrorCount !== 'number' || typeof l.crashed !== 'boolean') {
   256	    return fail('lifecycle-forensics', '生命周期取证形状不合法（计数/崩溃标志缺或类型错）', '补齐生命周期取证字段');
   257	  }
   258	  return ok('lifecycle-forensics', `生命周期取证在场（页面错误 ${l.pageerrorCount}，崩溃 ${l.crashed ? '是' : '否'}）`);
   259	}
   260	function credentialScanItem(scan) {
   261	  const t = judgeTier2ScanTimeline(obj(scan));
   262	  return t.ok
   263	    ? ok('credential-scan-clean', '凭据兜底扫描三阶段有序跑满且零命中')
   264	    : fail('credential-scan-clean', `凭据兜底扫描不合格：${t.problems.join('；')}`, '命中即零证据落盘；先查投影白名单与原始字节扫描');
   265	}
   266	function streamingItem(streamingAssertions, axes) {
   267	  const sa = obj(streamingAssertions);
   268	  const expected = arr(sa.expected).map(obj);
   269	  const judged = arr(sa.judged).map(obj);
   270	  const steps = arr(obj(axes).steps).map(obj);
   271	  const hard = expected.filter((e) => e.kind === 'streamReplyReceived' && e.soft === false);
   272	  if (!hard.length) {
   273	    // 本例不含硬流式断言：本项不适用（覆盖矩阵非空由聚合层单独 fail-closed，绝不靠本项空转成绿）。
   274	    return ok('streaming-hard-assertion-judged', '本例无硬流式断言（覆盖矩阵非空另由聚合层判定）');
   275	  }
   276	  const problems = [];
   277	  for (const h of hard) {
   278	    const matches = judged.filter((j) => j.intentId === h.intentId && j.stepId === h.stepId && j.kind === h.kind);
   279	    if (matches.length !== 1) {
   280	      problems.push(`断言 ${h.intentId}/${h.stepId}/${h.kind} 的裁定条目 join 不唯一（${matches.length} 条）`);
   281	      continue;
   282	    }
   283	    if (typeof matches[0].ok !== 'boolean') {
   284	      problems.push(`断言 ${h.intentId}/${h.stepId}/${h.kind} 的裁定结论非布尔（防非布尔静默降级）`);
   285	      continue;
   286	    }
   287	    const step = steps.find((s) => s.stepId === h.stepId && s.intentId === h.intentId);
   288	    const hardKinds = arr(step && step.hardAssertionKinds).map(String);
   289	    const judgedKinds = arr(step && step.judgedAssertionKinds).map(String);
   290	    if (!step || !hardKinds.includes(h.kind) || !judgedKinds.includes(h.kind)) {
   291	      problems.push(`断言 ${h.intentId}/${h.stepId}/${h.kind} 在三轴步账里未记为已裁硬断言`);
   292	    }
   293	  }
   294	  return problems.length
   295	    ? fail('streaming-hard-assertion-judged', `硬流式断言未被真实裁过：${problems.join('；')}`, '流式面只判回完，正文与耗时绝不入裁；裁定条目须按意图/步/种类唯一 join')
   296	    : ok('streaming-hard-assertion-judged', `硬流式断言已被真实裁过（${hard.length} 条）`);
   297	}
   298	function exitCodeLegendItem(reportModel) {
   299	  const rm = obj(reportModel);
   300	  if (rm.schemaOk !== true) return fail('exit-code-legend', '报表模型 schema 不合法', '查报表模型装配产物结构');
   301	  const legend = arr(rm.exitCodeLegend);
   302	  const legal = legend.every((c) => TIER2_EXIT_CODE_LEGEND.includes(c))
   303	    && TIER2_EXIT_CODE_LEGEND.every((c) => legend.includes(c));
   304	  return legal
   305	    ? ok('exit-code-legend', `退出码归一图例合法（${TIER2_EXIT_CODE_LEGEND.join('/')}）`)
   306	    : fail('exit-code-legend', `退出码归一图例非法：实得 ${legend.join('/') || '（空）'}`, `图例须恰为 ${TIER2_EXIT_CODE_LEGEND.join('/')}`);
   307	}
   308	
   309	export function judgeTier2RunEvidence(projection = {}) {
   310	  const p = obj(projection);
   311	  const axes = obj(p.axes);
   312	  const forensics = obj(axes.forensics);
   313	  const items = [
   314	    quadStateItem(p.verdict),
   315	    catchAllItem(p.verdict, p.reportModel),
   316	    networkForensicsItem(axes, forensics.network),
   317	    lifecycleForensicsItem(axes, forensics.lifecycle),
   318	    credentialScanItem(p.credentialScan),
   319	    streamingItem(p.streamingAssertions, axes),
   320	    exitCodeLegendItem(p.reportModel),
   321	  ];
   322	  return {
   323	    caseId: typeof p.caseId === 'string' ? p.caseId : null,
   324	    items,
   325	    ok: items.every((i) => !isRed(i)),
   326	    redIds: items.filter(isRed).map((i) => i.id),
   327	  };
   328	}
