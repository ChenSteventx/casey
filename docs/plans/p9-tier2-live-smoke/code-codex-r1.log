     1	const VERDICTS = ['PASS', 'SUT_DEFECT', 'HARNESS_ERROR', 'NEEDS_HUMAN'];
     2	
     3	export function summarizeRunVerdict(verdictDoc) {
     4	  const steps = Array.isArray(verdictDoc?.steps) ? verdictDoc.steps : [];
     5	  const counts = Object.fromEntries(VERDICTS.map((name) => [name, 0]));
     6	  let malformed = !Array.isArray(verdictDoc?.steps);
     7	  for (const step of steps) {
     8	    const verdict = step?.verdict;
     9	    if (!VERDICTS.includes(verdict)) {
    10	      malformed = true;
    11	      continue;
    12	    }
    13	    counts[verdict] += 1;
    14	  }
    15	  return {
    16	    counts,
    17	    total: steps.length,
    18	    allPass: !malformed && steps.length > 0 && counts.PASS === steps.length,
    19	    malformed,
    20	  };
    21	}

