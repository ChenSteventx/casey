   208	// ── 单 run 证据判定（吃产物投影的白名单字段，非全文）────────────────
   209	function quadStateItem(verdict) {
   210	  const v = obj(verdict);
   211	  const counts = obj(v.stateCounts);
   212	  if (v.schemaOk !== true) return fail('verdict-quadstate-wellformed', '裁定产物 schema 不合法', '查相4 裁定产物结构');
   213	  const missing = TIER2_FOUR_STATES.filter((s) => !Number.isInteger(counts[s]));
   214	  if (missing.length) return fail('verdict-quadstate-wellformed', `四态账缺态计数：${missing.join('/')}`, '四态计数须逐态在场且为整数');
   215	  return ok('verdict-quadstate-wellformed', `四态账 well-formed（${TIER2_FOUR_STATES.map((s) => `${s} ${counts[s]}`).join(' / ')}）`);
   216	}
   217	function catchAllItem(verdict, reportModel) {
   218	  const v = obj(verdict);
   219	  const unknown = arr(v.unknownStates).map(String);
   220	  if (unknown.length) return fail('catch-all-intact', `出现四态外终态标签：${unknown.join('/')}（catch-all 被旁路）`, '裁判判定树的 catch-all 必须收全部未证明分支');
   221	  const extraKeys = Object.keys(obj(v.stateCounts)).filter((k) => !TIER2_FOUR_STATES.includes(k));
   222	  if (extraKeys.length) return fail('catch-all-intact', `态计数混入未知终态键：${extraKeys.join('/')}`, '终态集只允许四态');
