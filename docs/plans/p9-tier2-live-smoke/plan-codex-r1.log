   133	function probeTunnel(proxyPort) {
   134	  return new Promise((res) => {
   135	    const t0 = Date.now();
   136	    if (proxyPort == null) { res({ proxyPort: null, portListening: false, probeMs: 0 }); return; }
   137	    let done = false;
   138	    const finish = (listening) => {
   139	      if (done) return; done = true;
   140	      try { sock.destroy(); } catch { /* ignore */ }
   141	      res({ proxyPort, portListening: listening, probeMs: Date.now() - t0 });
