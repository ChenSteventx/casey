   255	function walkSources(dir, prefix, acc) {
   256	  for (const entry of readdirSync(dir, { withFileTypes: true })) {
   257	    const abs = join(dir, entry.name);
   258	    const rel = `${prefix}/${entry.name}`;
   259	    if (entry.isDirectory()) walkSources(abs, rel, acc);
   260	    else if (entry.isFile() && entry.name.endsWith('.mjs')) acc.push(rel);
   261	  }
   262	  return acc;
   263	}
