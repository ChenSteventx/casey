   297	// 非消费式验真：只暴露 binding 元数据与 pending/resolved 计数，供 axes 适配器在双消费之前核绑定。
   298	// 探针、错绑与 cross-pair 因此烧不掉 genuine one-shot projection。
   299	export function inspectResolvedProjectionAuthority(options = {}) {
   300	  const authority = options?.resolvedProjectionAuthority;
   301	  const entry = authority && typeof authority === 'object'
   302	    ? RESOLVED_PROJECTION_STATE.get(authority) : null;
   303	  if (!entry || entry.consumed) return denied('RESOLVED_PROJECTION_AUTHORITY_INVALID');
   304	  const projection = entry.projection;
   305	  return frozen({
   306	    ok: true,
   307	    caseId: projection.caseId,
   308	    captureSha256: projection.captureSha256,
   309	    expectedSha256: projection.expectedSha256,
   310	    pendingCount: Array.isArray(projection.pending) ? projection.pending.length : -1,
   311	    resolvedCount: Array.isArray(projection.resolved) ? projection.resolved.length : -1,
   312	  });
   313	}
   314	
   315	// canonical raw axes consumer 的唯一入口：一次性读取 authority 绑定的 resolved projection。
   316	export function consumeResolvedProjectionAuthority(options = {}) {
   317	  const authority = options?.resolvedProjectionAuthority;
   318	  const entry = authority && typeof authority === 'object'
   319	    ? RESOLVED_PROJECTION_STATE.get(authority) : null;
   320	  if (!entry || entry.consumed) return denied('RESOLVED_PROJECTION_AUTHORITY_INVALID');
   321	  entry.consumed = true;
   322	  return frozen({ ok: true, projection: entry.projection });
   323	}
   324	
   325	// canonical issuer 的唯一执行面：只有拿到 opaque runExecutionAuthority 才能取用
   326	// 本次 run 已绑定的 runtime capability 与 exact artifacts；调用方无从自造。
   327	// 一次性开箱：同一 runExecutionAuthority 只允许开一次 runtime 三件套与 artifacts。
   328	// authority 万一外泄，第二次开箱固定返回 null，拿不到 fresh/topology/owner capability。
   329	const OPENED_EXECUTIONS = new WeakSet();
   330	
   331	export function openRunExecution(runExecutionAuthority) {
   332	  const record = runExecutionAuthority && typeof runExecutionAuthority === 'object'
   333	    ? EXECUTION_STATE.get(runExecutionAuthority) : null;
   334	  if (!record) return null;
   335	  if (OPENED_EXECUTIONS.has(runExecutionAuthority)) return null;
   336	  OPENED_EXECUTIONS.add(runExecutionAuthority);
   337	  return frozen({
   338	    role: record.role,
   339	    runNamespace: record.runNamespace,
   340	    caseId: record.caseId,
   341	    captureAuthority: record.captureAuthority,
   342	    expectedBytes: Buffer.from(record.expectedBytes),
   343	    artifacts: frozen({
   344	      candidateBytes: Buffer.from(record.artifactBytes.candidateBytes),
   345	      eventsBytes: Buffer.from(record.artifactBytes.eventsBytes),
   346	      entityLockBytes: Buffer.from(record.artifactBytes.entityLockBytes),
   347	    }),
   348	    freshRuntimeAuthority: record.freshRuntimeAuthority,
   349	    topologyAuthority: record.topologyAuthority,
   350	    runtimeOwnerAuthority: record.runtimeOwnerAuthority,
   351	    executionTargetAuthority: record.executionTargetAuthority,
   352	    entityLockHandle: record.entityLockHandle || null,
   353	  });
   354	}
   355	
   356	export function readSourceCompletionRecord(authority) {
   357	  if (!authority || typeof authority !== 'object') return null;
   358	  const record = SOURCE_COMPLETION_STATE.get(authority);
   359	  return record && !record.consumed ? record : null;
   360	}

