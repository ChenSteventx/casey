    86	export async function executeAuthorizedSourceReplay({
    87	  runAuthority, trustedRawReplayIssuer, ...extraInputs
    88	}) {
    89	  if (Object.keys(extraInputs).length > 0) return denied('RUN_COMPLETION_INVALID');
    90	  const record = readRunRecord(runAuthority);
    91	  if (!record || record.role !== 'source' || record.executed) {
    92	    return denied('RUN_COMPLETION_AUTHORITY_INVALID');
    93	  }
    94	  if (!usableIssuer(trustedRawReplayIssuer, 'executeAndVerify')) {
    95	    return denied('REPLAY_ISSUER_INVALID');
    96	  }
    97	  // run 是一次性 ratchet：真实执行发生前就落闸，失败不得换 issuer 重跑到 CLEAN。
    98	  record.executed = true;
    99	  const runExecutionAuthority = frozen(Object.create(null));
   100	  EXECUTION_STATE.set(runExecutionAuthority, record);
   101	
   102	  let result;
   103	  try {
   104	    result = await trustedRawReplayIssuer.executeAndVerify({ runExecutionAuthority });
   105	  } catch {
   106	    return denied('RUN_COMPLETION_INVALID');
   107	  }
   108	  if (!exactKeys(result, RAW_RESULT_KEYS) || result.ok !== true) {
   109	    return denied('RUN_COMPLETION_INVALID');
   110	  }
   111	  if (result.runExecutionAuthority !== runExecutionAuthority) {
   112	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   113	  }
   114	  const digests = artifactDigests(result.artifacts);
   115	  if (!digests) return denied('RUN_COMPLETION_INVALID');
   116	  if (!exactKeys(result.rawReplay, ['status', 'cleanProofAuthority'])) {
   117	    return denied('RUN_COMPLETION_INVALID');
   118	  }
   119	  if (result.rawReplay.status !== 'CLEAN') return denied('RUN_COMPLETION_INVALID');
   120	  if (!artifactsAgree(digests, record.planDigests)) {
   121	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   122	  }
   123	  if (result.runtimeOwnerAuthority !== record.runtimeOwnerAuthority) {
   124	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   125	  }
   126	  // CLEAN 只做非消费式验真；唯一 consumer 仍是 resolved projection。
   127	  const proof = inspectCleanRawReplayAuthority({
   128	    cleanProofAuthority: result.rawReplay.cleanProofAuthority,
   129	  });
   130	  if (proof?.ok !== true) return denied('RUN_COMPLETION_INVALID');
   131	  if (proof.captureSha256 !== record.captureSha256) {
   132	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   133	  }
   134	  const observation = inspectRawEventObservationAuthority({
   135	    rawObservationAuthority: result.rawObservationAuthority,
   136	  });
   137	  if (observation?.ok !== true) return denied('RUN_COMPLETION_INVALID');
   138	  if (observation.captureSha256 !== record.captureSha256
   139	    || observation.runExecutionAuthority !== runExecutionAuthority) {
   140	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   141	  }
   142	
   143	  const rawExecutionAuthority = frozen(Object.create(null));
   144	  RAW_EXECUTION_STATE.set(rawExecutionAuthority, {
   145	    record,
   146	    digests,
   147	    rawObservationAuthority: result.rawObservationAuthority,
   148	    captureSha256: record.captureSha256,
   149	    consumed: false,
   150	  });
   151	  return frozen({
   152	    ok: true,
   153	    rawExecutionAuthority,
   154	    cleanProofAuthority: result.rawReplay.cleanProofAuthority,
   155	    sourceRuntimeOwnerAuthority: record.runtimeOwnerAuthority,
   156	  });
   157	}
