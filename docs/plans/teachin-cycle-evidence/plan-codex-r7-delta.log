   180	
   181	  const resolvedProjectionAuthority = frozen(Object.create(null));
   182	  RESOLVED_PROJECTION_STATE.set(resolvedProjectionAuthority, {
   183	    consumed: false,
   184	    projection: frozen({
   185	      caseId: resolution.caseId,
   186	      captureSha256: resolution.captureSha256,
   187	      expectedSha256: raw.record.planDigests.expectedSha256,
   188	      resolved: resolution.resolved,
   189	      pending: resolution.pending,
   190	      structural: resolution.structural,
   191	    }),
   192	  });
   193	
   194	  let result;
   195	  try {
   196	    result = await trustedResolvedSourceIssuer.projectAndVerify({
   197	      rawObservationAuthority: raw.rawObservationAuthority,
   198	      resolvedProjectionAuthority,
   199	    });
   200	  } catch {
   201	    return denied('SOURCE_SEMANTIC_COMPLETION_INVALID');
   202	  }
   203	  if (!exactKeys(result, SEMANTIC_RESULT_KEYS) || result.ok !== true) {
   204	    return denied('SOURCE_SEMANTIC_COMPLETION_INVALID');
   205	  }
   206	  if (result.rawObservationAuthority !== raw.rawObservationAuthority
   207	    || result.resolvedProjectionAuthority !== resolvedProjectionAuthority) {
   208	    return denied('SOURCE_SEMANTIC_BINDING_MISMATCH');
   209	  }
   210	  if (!Buffer.isBuffer(result.axesBytes) || !Buffer.isBuffer(result.verdictBytes)) {
   211	    return denied('SOURCE_SEMANTIC_COMPLETION_INVALID');
   212	  }
   213	  const projected = projectSemanticEvidence(result.evidence, raw.record.expectedObligations);
   214	  if (projected.ok !== true) return closedFailure(projected.reason);
   215	
   216	  const completionAuthority = frozen(Object.create(null));
   217	  SOURCE_COMPLETION_STATE.set(completionAuthority, {
   218	    record: raw.record,
   219	    binding: bindingOf(raw.record, raw.digests, result.axesBytes, result.verdictBytes),
   220	    freshness: raw.record.freshness,
   221	    projection: projected.projection,
   222	    consumed: false,
   223	  });
