    54	    eventsSha256: digestOf(artifacts.eventsBytes),
    55	    entityLockSetSha256: digestOf(artifacts.entityLockBytes),
    56	  };
    57	}
    58	
    59	function artifactsAgree(digests, expected) {
    60	  return digests.candidateSha256 === expected.candidateSha256
    61	    && digests.eventsSha256 === expected.eventsSha256
    62	    && digests.entityLockSetSha256 === expected.entityLockSetSha256;
    63	}
    64	
    65	function bindingOf(record, digests, axesBytes, verdictBytes) {
    66	  const plan = record.planDigests;
    67	  return {
    68	    testcaseSha256: plan.testcaseSha256,
    69	    expectedSha256: plan.expectedSha256,
    70	    expectedObligationsSha256: plan.expectedObligationsSha256,
    71	    candidateSha256: digests.candidateSha256,
    72	    eventsSha256: digests.eventsSha256,
    73	    axesSha256: digestOf(axesBytes),
    74	    verdictSha256: digestOf(verdictBytes),
    75	    entityLockSetSha256: digests.entityLockSetSha256,
    76	    executionTargetAttestationSha256: record.executionTargetAttestationSha256,
