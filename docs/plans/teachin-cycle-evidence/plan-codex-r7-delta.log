   225	  BASELINE_GRANT_STATE.set(authoringBaselineGrant, {
   226	    consumed: false,
   227	    pairId: raw.record.pairId,
   228	    caseId: raw.record.caseId,
   229	    baselineProjectionSha256: raw.record.freshness.baselineProjectionSha256,
   230	    resetPlanDigest: raw.record.planDigests.resetPlanDigest,
   231	    executionTargetAuthority: raw.record.executionTargetAuthority,
   232	  });
   233	  return frozen({ ok: true, completionAuthority, authoringBaselineGrant });
   234	}
