    38	// 语义纵向失败返回闭合四键，绝不携带 evidence、异常原文或半成品 authority。
    39	function closedFailure(reason) {
    40	  return frozen({
    41	    ok: false, equivalent: false, promotionEligible: false, reason,
    42	  });
    43	}
    44	
    45	function usableIssuer(issuer, method) {
    46	  return !!issuer && typeof issuer === 'object' && typeof issuer[method] === 'function';
    47	}
    48	
    49	function artifactDigests(artifacts) {
    50	  if (!exactKeys(artifacts, ARTIFACT_KEYS)) return null;
    51	  for (const key of ARTIFACT_KEYS) if (!Buffer.isBuffer(artifacts[key])) return null;
    52	  return {
