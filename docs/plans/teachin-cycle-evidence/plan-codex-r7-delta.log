   159	export async function completeResolvedSourceReplay({
   160	  rawExecutionAuthority, sourceSemanticGrant, trustedResolvedSourceIssuer, ...extraInputs
   161	}) {
   162	  if (Object.keys(extraInputs).length > 0) return denied('SOURCE_SEMANTIC_COMPLETION_INVALID');
   163	  const raw = rawExecutionAuthority && typeof rawExecutionAuthority === 'object'
   164	    ? RAW_EXECUTION_STATE.get(rawExecutionAuthority) : null;
   165	  if (!raw || raw.consumed) return denied('RAW_EXECUTION_AUTHORITY_INVALID');
