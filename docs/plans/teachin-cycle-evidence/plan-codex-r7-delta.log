   170	    return denied('REPLAY_ISSUER_INVALID');
   171	  }
   172	  if (inspected.captureSha256 !== raw.captureSha256
   173	    || (inspected.caseId !== null && raw.record.caseId !== null
   174	      && inspected.caseId !== raw.record.caseId)) {
   175	    return denied('SOURCE_SEMANTIC_BINDING_MISMATCH');
   176	  }
   177	  const resolution = consumeSourceSemanticGrant(sourceSemanticGrant);
   178	  if (!resolution) return denied('SOURCE_SEMANTIC_GRANT_INVALID');
