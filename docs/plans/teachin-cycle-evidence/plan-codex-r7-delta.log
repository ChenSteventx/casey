   644	function recordingDoubles(stats, { mismatchedPair = false } = {}) {
   645	  const browser = {
   646	    on: (...args) => { stats.push(`browser.on:${args[0]}`); },
   647	    close: async () => { stats.push('browser.close'); },
   648	    isConnected: () => { stats.push('browser.isConnected'); return true; },
   649	  };
   650	  const other = { on() {}, close() {}, isConnected() { return true; } };
   651	  const context = {
   652	    on: (...args) => { stats.push(`context.on:${args[0]}`); },
   653	    close: async () => { stats.push('context.close'); },
   654	    browser: () => { stats.push('context.browser'); return mismatchedPair ? other : browser; },
   655	  };
   656	  return { browser, context };
   657	}
