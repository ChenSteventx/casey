   272	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   273	  }
   274	  const projected = projectSemanticEvidence(result.evidence, record.expectedObligations);
   275	  if (projected.ok !== true) return closedFailure(projected.reason);
   276	
   277	  const completionAuthority = frozen(Object.create(null));
   278	  COMPLETION_STATE.set(completionAuthority, {
   279	    pairBound: true,
   280	    pairRecord: record.pairRecord,
   281	    pairId: record.pairId,
   282	    role: 'distilled',
   283	    runOrdinal: 2,
   284	    runNamespace: record.runNamespace,
