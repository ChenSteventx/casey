    79	    identityProfileDigest: plan.identityProfileDigest,
    80	    replayKernelDigest: plan.replayKernelDigest,
    81	    resetPlanDigest: plan.resetPlanDigest,
    82	    sessionPolicyDigest: plan.sessionPolicyDigest,
    83	  };
    84	}
