   233	function captureConsole(fn) {
   234	  const chunks = [];
   235	  const outWrite = process.stdout.write;
   236	  const errWrite = process.stderr.write;
   237	  process.stdout.write = (chunk) => { chunks.push(`out:${String(chunk)}`); return true; };
   238	  process.stderr.write = (chunk) => { chunks.push(`err:${String(chunk)}`); return true; };
   239	  const restore = () => { process.stdout.write = outWrite; process.stderr.write = errWrite; };
   240	  let value;
   241	  try {
   242	    value = fn();
   243	  } catch (error) {
   244	    restore();
   245	    throw error;
   246	  }
   247	  if (value && typeof value.then === 'function') {
   248	    return value.then((resolved) => { restore(); return { value: resolved, chunks }; },
   249	      (error) => { restore(); throw error; });
   250	  }
   251	  restore();
   252	  return Promise.resolve({ value, chunks });
   253	}
