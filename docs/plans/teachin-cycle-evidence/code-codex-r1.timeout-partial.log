   297	    admission = checkReplayEntityAdmission({
   298	      caseId: claimed.caseId,
   299	      eventsBytes: claimed.execution.artifacts.eventsBytes,
   300	      eventsDocument,
   301	    });
   302	  } catch {
   303	    return 'REPLAY_ENTITY_ADMISSION_INVALID';
   304	  }
   305	  if (admission?.ok !== true) {
