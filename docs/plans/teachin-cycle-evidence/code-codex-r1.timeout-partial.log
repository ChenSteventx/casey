   112	    return SCHEMA_REJECTED;
   113	  }
   114	  for (const event of document.events) {
   115	    if (!isRecord(event)) return SCHEMA_REJECTED;
   116	    for (const [key, value] of Object.entries(event)) {
   117	      if (!EVENT_KEY_SET.has(key) && key !== 'refusalPoint') return SCHEMA_REJECTED;
   118	      if (!legalField(key, value)) return SCHEMA_REJECTED;
   119	    }
   120	    if (!REFUSAL_POINT_SET.has(event.refusalPoint)) return SCHEMA_REJECTED;
   121	    if (!STAGE_SET.has(event.stage)) return SCHEMA_REJECTED;
   122	  }
   123	  return null;
   124	}
   125	
   126	// 三层：地址形态逐串扫（键与值同扫）。
   127	function screenAddresses(document) {
   128	  const pending = [document];
   129	  while (pending.length > 0) {
   130	    const node = pending.pop();
   131	    if (Array.isArray(node)) {
   132	      for (const item of node) pending.push(item);
   133	      continue;
   134	    }
   135	    if (isRecord(node)) {
   136	      for (const [key, value] of Object.entries(node)) {
   137	        if (hasAddressForm(key)) return CREDENTIAL_REJECTED;
   138	        pending.push(value);
   139	      }
   140	      continue;
   141	    }
   142	    if (typeof node === 'string' && hasAddressForm(node)) return CREDENTIAL_REJECTED;
   143	  }
   144	  return null;
   145	}
   146	
   147	// 文档面三层闸：形状 → 类型 → 地址形态。末门整文扫在 screenCycleEvidenceText。
   148	export function screenCycleEvidenceDocument(document) {
   149	  const shape = screenShape(document);
   150	  if (shape) return denied(shape);
   151	  const address = screenAddresses(document);
   152	  if (address) return denied(address);
   153	  return frozen({ ok: true });
   154	}
   155	
   156	// 末门：规范化整文一并过地址形态与现役凭据兜底门，命中即整文拒写。
   157	export function screenCycleEvidenceText(text) {
   158	  if (typeof text !== 'string' || text.length === 0) return denied(SCHEMA_REJECTED);
   159	  if (Buffer.byteLength(text, 'utf8') > MAX_TEXT_BYTES) return denied(SCHEMA_REJECTED);
   160	  if (hasAddressForm(text)) return denied(CREDENTIAL_REJECTED);
   161	  let gate;
   162	  try {
   163	    gate = credentialGate({ 'cycle-evidence.json': text });
   164	  } catch {
   165	    return denied(CREDENTIAL_REJECTED);
   166	  }
   167	  if (gate?.ok !== true) return denied(CREDENTIAL_REJECTED);
   168	  return frozen({ ok: true });
   169	}
   170	
   171	// 文件名按完整摘要派生：异 capture 天然不碰撞，前 12 位相同的两枚摘要也落不到同一目标。
   172	export function cycleEvidenceFileName(captureSha256) {
   173	  if (typeof captureSha256 !== 'string' || !DIGEST_RE.test(captureSha256)) return null;
   174	  return `cycle-evidence.${captureSha256}.json`;
   175	}
   176	
   177	function canonicalEvent(event) {
   178	  const row = {};
   179	  for (const key of CYCLE_EVIDENCE_EVENT_KEYS) {
   180	    if (key === 'refusalPoint') continue;
   181	    if (Object.hasOwn(event, key)) row[key] = event[key];
   182	  }
   183	  return { refusalPoint: event.refusalPoint, ...row };
   184	}
   185	
   186	function stagesOf(events) {
   187	  const seen = new Set(events.map((event) => event.stage));
   188	  return CYCLE_EVIDENCE_STAGES.filter((stage) => seen.has(stage));
   189	}
   190	
   191	// 成档：中毒批次一律拒付，绝不静默丢单条冒充完整；键序固定，同一批次逐字节可复现。
   192	export function buildCycleEvidenceDocument({ snapshot, captureSha256, recordedAt } = {}) {
   193	  if (!isRecord(snapshot) || !Array.isArray(snapshot.events)) return denied(SCHEMA_REJECTED);
   194	  if (snapshot.poisoned === true) return denied(SCHEMA_REJECTED);
   195	  if (typeof captureSha256 !== 'string' || !DIGEST_RE.test(captureSha256)) {
   196	    return denied(SCHEMA_REJECTED);
   197	  }
   198	  const stamped = recordedAt === undefined || recordedAt === null
   199	    ? new Date().toISOString()
   200	    : recordedAt;
   201	  if (typeof stamped !== 'string' || !RECORDED_AT_RE.test(stamped)) return denied(SCHEMA_REJECTED);
   202	  let events;
   203	  try {
   204	    events = snapshot.events.map((event) => canonicalEvent(event));
   205	  } catch {
   206	    return denied(SCHEMA_REJECTED);
   207	  }
   208	  const document = {
   209	    schemaVersion: CYCLE_EVIDENCE_SCHEMA_VERSION,
   210	    artifactKind: CYCLE_EVIDENCE_ARTIFACT_KIND,
   211	    captureSha256,
   212	    recordedAt: stamped,
   213	    stages: stagesOf(events),
   214	    events,
   215	  };
   216	  const screened = screenCycleEvidenceDocument(document);
   217	  if (screened.ok !== true) return denied(screened.reason);
   218	  return frozen({ ok: true, document });
   219	}
   220	
   221	function serialize(document) {
   222	  return `${JSON.stringify(document, null, 2)}\n`;
   223	}
   224	
   225	function discardTemp(path) {
   226	  try {
   227	    unlinkSync(path);
   228	  } catch { /* 临时件已不在即可，拒写路径绝不触碰既有目标 */ }
   229	}
   230	
   231	// 先闸后盘：内存内序列化 → 四层闸 → 才写临时件 → rename。
   232	// 拒写路径零临时件零目标写入；写失败只清临时件，既有目标一个字节都不动。
   233	export function writeCycleEvidenceSidecar({ outDir, document } = {}) {
   234	  if (typeof outDir !== 'string' || !outDir) return denied(SCHEMA_REJECTED);
   235	  const screened = screenCycleEvidenceDocument(document);
   236	  if (screened.ok !== true) return denied(screened.reason);
   237	  const fileName = cycleEvidenceFileName(document.captureSha256);
   238	  if (!fileName) return denied(SCHEMA_REJECTED);
   239	  let text;
   240	  try {
   241	    text = serialize(document);
   242	  } catch {
   243	    return denied(SCHEMA_REJECTED);
   244	  }
   245	  const gated = screenCycleEvidenceText(text);
   246	  if (gated.ok !== true) return denied(gated.reason);
   247	
   248	  tempOrdinal += 1;
   249	  const tempPath = join(outDir, `${fileName}.${process.pid}-${tempOrdinal}.tmp`);
   250	  try {
   251	    writeFileSync(tempPath, text, { encoding: 'utf8', flag: 'wx' });
   252	  } catch {
   253	    discardTemp(tempPath);
   254	    return denied(WRITE_FAILED);
   255	  }
   256	  try {
   257	    renameSync(tempPath, join(outDir, fileName));
   258	  } catch {
   259	    discardTemp(tempPath);
   260	    return denied(WRITE_FAILED);
   261	  }
   262	  return frozen({ ok: true, fileName });
   263	}
   264	
   265	// 读取方：按完整摘要派生名定位，再用顶层摘要复核绑定——改名冒充与旧档冒充都在此终结。
   266	export function readCycleEvidence(captureSha256, options = {}) {
   267	  const fileName = cycleEvidenceFileName(captureSha256);
   268	  if (!fileName) return denied(SCHEMA_REJECTED);
   269	  const outDir = options?.outDir;
   270	  if (typeof outDir !== 'string' || !outDir) return denied(SCHEMA_REJECTED);
   271	  let text;
   272	  try {
   273	    text = readFileSync(join(outDir, fileName), 'utf8');
   274	  } catch {
   275	    return denied(SCHEMA_REJECTED);
   276	  }
   277	  let document;
   278	  try {
   279	    document = JSON.parse(text);
   280	  } catch {
   281	    return denied(SCHEMA_REJECTED);
   282	  }
   283	  const screened = screenCycleEvidenceDocument(document);
   284	  if (screened.ok !== true) return denied(screened.reason);
   285	  if (document.captureSha256 !== captureSha256) return denied(SCHEMA_REJECTED);
   286	  return frozen({ ok: true, document });
   287	}

