   326	export async function runCanonicalPreflight(input = {}) {
   327	  const outcome = await runCanonicalPreflightCore(input);
   328	  if (outcome?.ok !== true) reportSeamRefusal('prepared-runtime.preflight', outcome);
   329	  return outcome;
   330	}
   331	
   332	async function runCanonicalPreflightCore(input) {
   333	  if (!exactKeys(input, PREFLIGHT_INPUT_KEYS)) return denied(COMPLETION_INVALID);
   334	  const stage = PREFLIGHT_STAGE.get(input.eventRunnerInput) || null;
   335	  if (!stage) return denied(OWNERSHIP_MISMATCH);
   336	  PREFLIGHT_STAGE.delete(input.eventRunnerInput);
   337	  if (stage.runExecutionAuthority !== input.runExecutionAuthority
   338	    || stage.runtimeOwnerAuthority !== input.runtimeOwnerAuthority
   339	    || stage.page !== input.page
   340	    || stage.execution !== input.execution
   341	    || stage.axesProjectionInput !== input.axesProjectionInput) {
   342	    return denied(OWNERSHIP_MISMATCH);
   343	  }
   344	  // owner 必须此刻仍然在线：先前 claim 与真正跑事件之间被关掉的 runtime 不许再跑。
   345	  if (!readRuntimeOwner(input.runtimeOwnerAuthority)) return denied(OWNERSHIP_MISMATCH);
   346	  let failure;
   347	  try {
   348	    failure = runProductionGates(stage);
   349	  } catch {
   350	    return denied(COMPLETION_INVALID);
   351	  }
   352	  if (failure) return denied(failure);
