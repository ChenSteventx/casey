   143	function mintFreshRuntime(topologyAuthority) {
   144	  let recordingConnected = true;
   145	  const recordingBrowser = emitterDouble({
   146	    isConnected: () => recordingConnected,
   147	  });
   148	  const recordingContext = emitterDouble({
   149	    browser: () => recordingBrowser,
   150	  });
   151	  const witnessed = createFreshReplayWitness({
   152	    recordingBrowser,
   153	    recordingContext,
   154	  });
   155	  assert(witnessed?.ok === true, `witness 创建失败：${JSON.stringify(witnessed)}`);
   156	  recordingContext.emit('close');
   157	  recordingConnected = false;
   158	  recordingBrowser.emit('disconnected');
   159	
   160	  const replayBrowser = emitterDouble({ isConnected: () => true });
   161	  const replayContext = emitterDouble({ browser: () => replayBrowser });
   162	  const replayPage = emitterDouble({
   163	    context: () => replayContext,
   164	    isClosed: () => false,
   165	  });
   166	  const authorized = authorizeFreshReplayRuntime({
   167	    witness: witnessed.witness,
   168	    replayBrowser,
   169	    replayContext,
   170	    replayPage,
   171	    topologyAuthority,
   172	  });
   173	  assert(authorized?.ok === true && authorized.freshRuntimeAuthority,
   174	    `fresh runtime 授权失败：${JSON.stringify(authorized)}`);
   175	  return authorized.freshRuntimeAuthority;
   176	}
