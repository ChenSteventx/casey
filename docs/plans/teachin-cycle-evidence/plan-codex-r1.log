   110	function topologyDouble({
   111	  consumeResult = { ok: true },
   112	  expectedNewPagePath = '/agents',
   113	} = {}) {
   114	  const initialAuthority = Object.freeze(Object.create(null));
   115	  const popupAuthority = Object.freeze(Object.create(null));
   116	  let activeAuthority = initialAuthority;
   117	  const calls = [];
   118	  return {
   119	    topology: {
   120	      activePageAuthority() {
   121	        return activeAuthority;
   122	      },
   123	      async consumeNewPageEvent({ pageAuthority, event }) {
   124	        calls.push({ pageAuthority, event });
   125	        if (consumeResult.ok !== true) return consumeResult;
   126	        if (pageAuthority !== popupAuthority
   127	          || event?.action !== 'newpage'
   128	          || event?.path !== expectedNewPagePath) {
   129	          return { ok: false, reason: 'TOPOLOGY_PATH_MISMATCH' };
   130	        }
   131	        return { ok: true, pageId: 'opaque_page' };
   132	      },
   133	      promoteToPopup() {
   134	        activeAuthority = popupAuthority;
   135	      },
   136	    },
   137	    initialAuthority,
   138	    popupAuthority,
   139	    calls,
   140	  };
   141	}
