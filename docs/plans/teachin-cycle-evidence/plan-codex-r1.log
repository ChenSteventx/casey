    65	function emitterDouble(extra = {}) {
    66	  const listeners = new Map();
    67	  return {
    68	    ...extra,
    69	    on(event, handler) {
    70	      const entries = listeners.get(event) || [];
    71	      entries.push(handler);
    72	      listeners.set(event, entries);
    73	    },
    74	    emit(event) {
    75	      for (const handler of listeners.get(event) || []) handler();
    76	    },
    77	  };
    78	}
