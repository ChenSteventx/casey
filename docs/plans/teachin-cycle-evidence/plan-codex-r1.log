   178	// actionDriver 的冻结窄接口：
   179	// - readActivePath：只回 host-free path+query；
   180	// - resolve：只解析 selector，unique 时铸一次性 actionAuthority，不产生页面副作用；
   181	// - perform：只消费 genuine actionAuthority 执行真实动作；
   182	// - goto：poison method，raw runner 在任何分支调用即金牌红。
   183	function actionDriverDouble({
   184	  paths = [],
   185	  resolutions = [],
   186	  actionResults = [],
   187	  topology,
   188	  promoteOnSelector = null,
   189	} = {}) {
   190	  let pathIndex = 0;
   191	  let resolutionIndex = 0;
   192	  let actionIndex = 0;
   193	  let gotoCalls = 0;
   194	  let resolveCalls = 0;
   195	  let performCalls = 0;
   196	  const seenEvents = [];
   197	  const actionGates = new WeakMap();
   198	  return {
   199	    driver: {
   200	      async readActivePath() {
   201	        return paths[pathIndex++];
   202	      },
   203	      async resolve({ event, topologyAuthority, executionTargetAuthority }) {
   204	        resolveCalls += 1;
   205	        seenEvents.push(event);
   206	        assert(topologyAuthority === topology, 'resolver 必须收到同一 topologyAuthority');
   207	        assert(executionTargetAuthority === execution.authority,
   208	          'resolver 必须收到 opaque execution target authority');
   209	        assert(typeof event.fallbackCss === 'string' && event.fallbackCss,
   210	          `selector 未固定投影到 fallbackCss：${JSON.stringify(event)}`);
   211	        const resolution = resolutions[resolutionIndex++] || {
   212	          resolution: 'unique',
   213	          candidateCount: 1,
   214	        };
   215	        if (resolution.resolution !== 'unique' || resolution.candidateCount !== 1) {
   216	          return resolution;
   217	        }
   218	        const actionAuthority = Object.freeze(Object.create(null));
   219	        actionGates.set(actionAuthority, { event });
   220	        return { ...resolution, actionAuthority };
   221	      },
   222	      async perform({ actionAuthority, topologyAuthority, executionTargetAuthority }) {
   223	        performCalls += 1;
   224	        const gate = actionGates.get(actionAuthority);
   225	        assert(gate, 'perform 必须消费 resolver 铸造的 genuine actionAuthority');
   226	        actionGates.delete(actionAuthority);
   227	        assert(topologyAuthority === topology, 'perform 必须收到同一 topologyAuthority');
   228	        assert(executionTargetAuthority === execution.authority,
   229	          'perform 必须收到 opaque execution target authority');
   230	        if (promoteOnSelector && gate.event.fallbackCss === promoteOnSelector) {
   231	          topology.promoteToPopup();
   232	        }
   233	        return actionResults[actionIndex++] || {
   234	          ok: true,
   235	          identityReadback: { ok: true },
   236	        };
   237	      },
   238	      async goto() {
   239	        gotoCalls += 1;
   240	        throw new Error('RAW_NAV_MUST_NOT_GOTO');
   241	      },
   242	    },
   243	    stats: {
   244	      get pathCalls() { return pathIndex; },
   245	      get resolveCalls() { return resolveCalls; },
   246	      get performCalls() { return performCalls; },
   247	      get gotoCalls() { return gotoCalls; },
   248	      seenEvents,
   249	    },
   250	  };
   251	}
