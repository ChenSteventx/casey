    30	    && caseId.length > 0
    31	    && caseId !== '.'
    32	    && caseId !== '..'
    33	    && !path.isAbsolute(caseId)
    34	    && !caseId.includes('/')
    35	    && !caseId.includes('\\')
    36	    && !caseId.includes('..');
    37	}
    38	
    39	export function assertSafeCaseId(caseId) {
    40	  if (!isSafeCaseId(caseId)) {
    41	    throw new Error('caseId 不安全：仅允许单段目录名，不得含 /、\\、.. 或绝对路径');
    42	  }
    43	  return caseId;
    44	}
    45	
    46	/** 某条用例的目录与产物路径。 */
    47	export function caseDir(caseId) {
    48	  assertSafeCaseId(caseId);
    49	  return path.join(CASES_DIR, caseId);
    50	}
    51	export function casePaths(caseId) {
    52	  const dir = caseDir(caseId);
    53	  return {
    54	    dir,
    55	    events: path.join(dir, 'events.json'),
    56	    expected: path.join(dir, 'expected.frozen.json'),
    57	    entityLocks: path.join(dir, 'entity-locks.frozen.json'),
    58	    profile: path.join(dir, 'profile.json'),
    59	    observed: path.join(dir, `observed-${caseId}.json`),
    60	    caseMeta: path.join(dir, 'testcase.json'),
    61	    contract: path.join(LOOP_DIR, `prd-${caseId}.json`),
    62	  };
    63	}
    64	
    65	/** Playwright CLI（P3 起 npm install 后存在）；当前可能缺失，调用方需自检。 */
    66	export const PLAYWRIGHT_CLI = path.join(PROJECT_ROOT, 'node_modules', '@playwright', 'test', 'cli.js');
    67	export function hasPlaywright() {
    68	  return fs.existsSync(PLAYWRIGHT_CLI);
    69	}

