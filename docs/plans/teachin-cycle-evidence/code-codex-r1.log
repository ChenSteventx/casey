   477	async function main() {
   478	  const args = parseArgs(process.argv.slice(2));
   479	  const caseId = args.pos[0];
   480	  if (!caseId) dieUsage('缺 caseId');
   481	  // caseId 进产物路径段——限路径安全字符，拒 / .. 等穿越形态（fail-closed，镜像 draft.mjs:42 / compile.mjs:283 先例；异构评审 F1）。
   482	  if (!/^[A-Za-z0-9_-]+$/.test(caseId)) { console.error('record: caseId 含非法字符（仅限字母数字_-；原值不回显——CLI 参数在凭据门扫描面外）'); process.exit(65); }
   483	  // 必填/带值旗标须真带值——裸旗标（parseArgs 记 true）不得静默降级为 <cwd>/true 之类落点（镜像 draft.mjs:44；异构评审 F3）。
   484	  for (const k of [
   485	    'sut', 'out-dir', 'from-events', 'max-ms', 'cycle-plan',
   486	    'testcase', 'expected', 'entity-lock', 'profile', 'sut-build-digest',
   487	  ]) {
   488	    if (args[k] !== undefined && typeof args[k] !== 'string') dieUsage(`--${k} 须带值`);
   489	  }
   490	  if (!args.sut) dieUsage('缺 --sut');
   491	  if (!args['out-dir']) dieUsage('缺 --out-dir');
   492	  if (!!args['login-bootstrap'] === !!args['no-login']) dieUsage('须且只能传 --login-bootstrap 或 --no-login');
   493	  const cycleMode = inspectRecordedCycleArgs(args);
   494	  if (cycleMode.ok !== true) dieUsage(cycleMode.reason);
   495	  if (cycleMode.requested && !args['login-bootstrap']) {
   496	    dieUsage('示教闭环须使用 --login-bootstrap');
   497	  }
   498	  if (cycleMode.requested && args['from-events']) {
   499	    dieUsage('--from-events 没有可交接的 live recording runtime，不能开示教闭环');
   500	  }
   501	
   502	  if (args['from-events']) {
   503	    const raw = readRawEvents(resolve(String(args['from-events'])));
   504	    writePackage({ caseId, outDir: args['out-dir'], startUrl: raw.startUrl || args.sut, events: raw.events });
   505	    return;
   506	  }
   507	  await browserMode({ caseId, args, cycleMode });
   508	}
   509	
   510	main().catch((e) => {
   511	  process.exit(emitExecutionTargetCliFailure({
   512	    command: 'record',
   513	    failure: e,
   514	  }));
   515	});

