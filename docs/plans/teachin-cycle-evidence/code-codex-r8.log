   154	        continue;
   155	      }
   156	      blankAt(i); i += 1;
   157	      let inClass = false;
   158	      while (i < source.length && source[i] !== '\n') {
   159	        const cur = source[i];
   160	        if (cur === '\\') { blankAt(i); blankAt(i + 1); i += 2; continue; }
