   210	function lexicalSpan(text, needle) {
   211	  const at = text.indexOf(needle);
   212	  if (at < 0) return null;
   213	  const open = at + needle.length - 1;
   214	  let depth = 0;
   215	  for (let i = open; i < text.length; i += 1) {
   216	    const ch = text[i];
   217	    if (ch === '(') depth += 1;
   218	    else if (ch === ')') {
   219	      depth -= 1;
   220	      if (depth === 0) return { start: at, argsAt: open + 1, end: i };
   221	    }
   222	  }
   223	  return null;
   224	}
