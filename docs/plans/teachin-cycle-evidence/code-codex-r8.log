   448	  //    目标名必须是对应模块 import 花括号里的一条**独立 specifier 裸形**（逗号分隔、左右无 as）。
   449	  assert(!/\bimport\s+\*\s+as\b/.test(record),
   450	    'record CLI 不得用命名空间导入（import * as）——拼名取函数会绕开原始字节计数纪律');
   451	  for (const [moduleSpecifier, name] of [
   452	    ['../lib/teachin/replayability-cycle-entry.mjs', 'runRecordedTeachinReplayabilityCycle'],
   453	    ['../lib/teachin/cycle-evidence-context.mjs', 'runWithCycleEvidence'],
   454	  ]) {
   455	    assert(!new RegExp(`\\bas\\s+${name}\\b`).test(record),
   456	      `全文任何 import 都不许把别的导出别名成「${name}」——别名改写不用转义就能把包裹换成另一个函数`);
   457	    const escaped = moduleSpecifier.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
   458	    const statement = record.match(
   459	      new RegExp(`import\\s*\\{([^}]*)\\}\\s*from\\s*'${escaped}'`, 's'),
   460	    );
   461	    assert(statement, `「${name}」必须从 ${moduleSpecifier} 具名导入（花括号形）`);
   462	    const specifiers = statement[1].split(',').map((row) => row.trim()).filter(Boolean);
   463	    assert(specifiers.includes(name),
   464	      `「${name}」必须是该 import 花括号里的一条独立 specifier 裸形（逗号分隔、不许 as 改写），实得 ${JSON.stringify(specifiers)}`);
   465	  }
   466	});
