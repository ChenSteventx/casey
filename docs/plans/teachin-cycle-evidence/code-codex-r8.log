   131	      blankAt(i); i += 1;
   132	      while (i < source.length && source[i] !== ch && source[i] !== '\n') {
   133	        if (source[i] === '\\') { blankAt(i); i += 1; }
   134	        blankAt(i); i += 1;
   135	      }
   136	      blankAt(i); i += 1;
   137	      previous = { type: 'literal' };
   138	      continue;
   139	    }
   140	    if (ch === '`') { blankAt(i); i += 1; mode = 'template'; continue; }
   141	    if (ch === '/') {
   142	      const verdict = classifySlash(previous);
   143	      if (verdict === 'ambiguous') {
   144	        // fail-closed：证不出就不猜，整扫描作废（判据宁可红，也不许靠猜判绿）。
   145	        return {
   146	          text: chars.join(''),
   147	          poisoned: true,
