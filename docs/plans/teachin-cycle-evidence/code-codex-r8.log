   173	      i = end;
   174	      continue;
   175	    }
   176	    if (ch === '(') { previous = { type: 'punct', text: '(' }; i += 1; continue; }
   177	    if (ch === ')') { previous = { type: 'close', text: ')' }; i += 1; continue; }
   178	    if (ch === ']') { previous = { type: 'close', text: ']' }; i += 1; continue; }
