   265	// 读取方：按完整摘要派生名定位，再用顶层摘要复核绑定。
   266	// 口径（威胁模型见 GRILL D4）：单侧误放/残留旧档、或改名但内文摘要未同步——在此拦下；
   267	// 协调双改（改名 + 同步改内文顶层摘要）在界外，本层不声称拦得住。
   268	export function readCycleEvidence(captureSha256, options = {}) {
