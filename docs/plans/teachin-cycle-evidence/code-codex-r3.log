    77	    case 'stage': return STAGE_SET.has(value);
    78	    case 'reason': return REASON_SET.has(value);
    79	    case 'errorName': return ERROR_NAME_SET.has(value);
    80	    case 'action': return ACTION_SET.has(value);
    81	    case 'resolution': return RESOLUTION_SET.has(value);
    82	    case 'seq': return counted(value);
    83	    case 'candidateCount': return counted(value);
