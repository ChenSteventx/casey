    97	  if (document.schemaVersion !== CYCLE_EVIDENCE_SCHEMA_VERSION) return SCHEMA_REJECTED;
    98	  if (document.artifactKind !== CYCLE_EVIDENCE_ARTIFACT_KIND) return SCHEMA_REJECTED;
    99	  if (typeof document.captureSha256 !== 'string'
   100	    || !DIGEST_RE.test(document.captureSha256)) return SCHEMA_REJECTED;
   101	  if (typeof document.recordedAt !== 'string'
   102	    || !RECORDED_AT_RE.test(document.recordedAt)) return SCHEMA_REJECTED;
