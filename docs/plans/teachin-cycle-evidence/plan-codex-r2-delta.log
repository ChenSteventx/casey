   238	export async function runRawReplay(options = {}) {
   239	  let captureAuthority;
   240	  let freshRuntimeAuthority;
   241	  let topologyAuthority;
   242	  let executionTargetAuthority;
   243	  let actionDriver;
   244	  let eventObserver;
   245	  try {
   246	    if (!options || typeof options !== 'object') {
   247	      return denied('RAW_CAPTURE_AUTHORITY_INVALID');
   248	    }
   249	    ({
   250	      captureAuthority,
   251	      freshRuntimeAuthority,
   252	      topologyAuthority,
   253	      executionTargetAuthority,
   254	      actionDriver,
   255	      eventObserver,
   256	    } = options);
   257	  } catch {
   258	    return denied('RAW_CAPTURE_AUTHORITY_INVALID');
   259	  }
   260	  // 1. capture 只 inspect、不消费；伪造/clone 在读页面之前拒。
   261	  const inspected = inspectAdmittedRawReplayCapture({ captureAuthority });
   262	  if (inspected.ok !== true) return denied(stableReason(inspected.reason));
   263	  // 2. fresh authority 在读取任何页面状态之前原子消费：后续失败也不得退还或重试。
   264	  const fresh = consumeFreshReplayRuntimeAuthority({
   265	    freshRuntimeAuthority,
   266	    topologyAuthority,
   267	  });
   268	  if (fresh.ok !== true) return denied(stableReason(fresh.reason));
   269	  if (!driverAvailable(actionDriver)) return denied('RAW_REPLAY_INTERNAL_ERROR');
   270	  // observer 可缺席（独立 raw 诊断入口）；一旦给出就必须是完整的 begin/finish 闭包。
   271	  const observer = eventObserver === undefined || eventObserver === null
   272	    ? null
   273	    : (observerAvailable(eventObserver) ? eventObserver : undefined);
   274	  if (observer === undefined) return denied('RAW_REPLAY_INTERNAL_ERROR');
   275	
   276	  const capture = inspected.capture;
   277	  const proofInput = {
   278	    caseId: capture.caseId,
   279	    captureSha256: inspected.captureSha256,
   280	    totalEvents: capture.events.length,
   281	  };
   282	  const steps = [];
   283	  for (const event of capture.events) {
   284	    // 固定顺序：begin(seq) → path/resolve/perform 或 topology → finish(seq,actionAxis)。
   285	    // 首错 event 仍 finish 以保留失败动作轴，但下一 seq 不得 begin。
   286	    if (observer) {
   287	      const begun = await observer.begin({ seq: event.seq, topologyAuthority });
   288	      if (begun?.ok !== true) {
   289	        const reason = stableReason(begun?.reason);
   290	        steps.push({ seq: event.seq, action: event.action, outcome: 'FAILED', reason });
   291	        return failedRun(reason, { ...proofInput, steps });
   292	      }
   293	    }
   294	    let reason = null;
   295	    let axis = actionAxis('unique', 1, true);
   296	    const checkpoint = await readCheckpoint({
   297	      actionDriver,
   298	      topologyAuthority,
   299	      executionTargetAuthority,
   300	      event,
   301	    });
   302	    if (checkpoint) {
   303	      reason = stableReason(checkpoint);
   304	      axis = actionAxis('checkpoint_failed', 0, false);
   305	    } else {
   306	      const projected = projectRawReplayAction(event);
   307	      if (projected.ok !== true) {
   308	        reason = 'RAW_ACTION_INVALID';
   309	        axis = actionAxis('action_invalid', 0, false);
   310	      } else if (projected.kind === 'control' && projected.controlAction === 'newpage') {
   311	        const topologyReason = await consumeTopologyEvent({ topologyAuthority, event });
   312	        if (topologyReason) {
   313	          reason = stableReason(topologyReason);
   314	          axis = actionAxis('topology_failed', 0, false);
   315	        }
   316	      } else if (projected.kind === 'action') {
   317	        const performed = await performBusinessEvent({
   318	          actionDriver,
   319	          actionRequest: projected.actionRequest,
   320	          seq: event.seq,
   321	          topologyAuthority,
   322	          executionTargetAuthority,
   323	        });
   324	        reason = performed.reason === null ? null : stableReason(performed.reason);
   325	        axis = performed.axis;
   326	      }
   327	      // nav 是纯 checkpoint：path 相等即记复现，绝不导航修正。
   328	    }
   329	    if (observer) {
   330	      const finished = await observer.finish({
   331	        seq: event.seq,
   332	        actionAxis: axis,
   333	        topologyAuthority,
   334	      });
   335	      if (finished?.ok !== true && !reason) {
   336	        reason = stableReason(finished?.reason);
   337	      }
   338	    }
   339	    if (reason) {
   340	      steps.push({ seq: event.seq, action: event.action, outcome: 'FAILED', reason });
   341	      return failedRun(reason, { ...proofInput, steps });
   342	    }
   343	    steps.push({ seq: event.seq, action: event.action, outcome: 'REPRODUCED' });
   344	  }
   345	
   346	  const proof = buildProof({ ...proofInput, status: 'CLEAN', steps });
   347	  const sealed = sealCleanRawReplay({ captureSha256: inspected.captureSha256 });
   348	  if (sealed.ok !== true) return failedRun('RAW_REPLAY_INTERNAL_ERROR', { ...proofInput, steps });
   349	  return frozen({
   350	    ok: true,
   351	    status: 'CLEAN',
   352	    proof,
   353	    cleanProofAuthority: sealed.cleanProofAuthority,
   354	  });
   355	}
   356	
   357	// 唯一 admission → runtime 编排边界：全包准入失败时 fresh factory 与全部 driver 调用数恒为零。
   358	export async function admitAndRunRawReplay(options = {}) {
   359	  let caseId;
   360	  let captureBytes;
   361	  let freshRuntimeFactory;
   362	  let topologyAuthority;
   363	  let executionTargetAuthority;
   364	  let actionDriver;
   365	  let eventObserver;
   366	  try {
   367	    if (!options || typeof options !== 'object') {
   368	      return denied('RAW_CAPTURE_INPUT_INVALID');
   369	    }
   370	    ({
   371	      caseId,
   372	      captureBytes,
   373	      freshRuntimeFactory,
   374	      topologyAuthority,
   375	      executionTargetAuthority,
   376	      actionDriver,
   377	      eventObserver,
   378	    } = options);
   379	  } catch {
   380	    return denied('RAW_CAPTURE_INPUT_INVALID');
   381	  }
   382	  const admitted = admitRawReplayCapture({ caseId, captureBytes });
   383	  if (admitted.ok !== true) return admitted;
   384	  if (typeof freshRuntimeFactory !== 'function') {
   385	    return denied('FRESH_RUNTIME_AUTHORITY_INVALID');
   386	  }
   387	  let created;
   388	  try {
   389	    created = await freshRuntimeFactory({ topologyAuthority });
   390	  } catch {
   391	    return denied('FRESH_RUNTIME_AUTHORITY_INVALID');
   392	  }
   393	  if (created?.ok !== true || !created.freshRuntimeAuthority) {
   394	    return denied(stableReason(created?.reason || 'FRESH_RUNTIME_AUTHORITY_INVALID'));
   395	  }
   396	  return runRawReplay({
   397	    captureAuthority: admitted.captureAuthority,
   398	    freshRuntimeAuthority: created.freshRuntimeAuthority,
   399	    topologyAuthority,
   400	    executionTargetAuthority,
   401	    actionDriver,
   402	    ...(eventObserver === undefined ? {} : { eventObserver }),
   403	  });
