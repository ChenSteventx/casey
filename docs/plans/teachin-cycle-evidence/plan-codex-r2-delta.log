   267	  }
   268	  if (!artifactsAgree(digests, record.roleDigests)) {
   269	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   270	  }
   271	  if (result.runtimeOwnerAuthority !== record.runtimeOwnerAuthority) {
   272	    return denied('RUN_COMPLETION_BINDING_MISMATCH');
   273	  }
   274	  const projected = projectSemanticEvidence(result.evidence, record.expectedObligations);
   275	  if (projected.ok !== true) return closedFailure(projected.reason);
