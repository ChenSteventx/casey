   277	  const completionAuthority = frozen(Object.create(null));
   278	  COMPLETION_STATE.set(completionAuthority, {
   279	    pairBound: true,
   280	    pairRecord: record.pairRecord,
   281	    pairId: record.pairId,
   282	    role: 'distilled',
   283	    runOrdinal: 2,
   284	    runNamespace: record.runNamespace,
   285	    predecessorReceiptSha256: record.sourceReceiptSha256,
   286	    binding: bindingOf(record, digests, result.axesBytes, result.verdictBytes),
   287	    freshness: record.freshness,
   288	    projection: projected.projection,
   289	  });
