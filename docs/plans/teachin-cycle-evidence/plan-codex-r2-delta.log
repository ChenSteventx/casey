    29	  'CAPTURE_SEQ_INVALID',
    30	  'CLEAN_PROOF_AUTHORITY_INVALID',
    31	  'FRESH_RUNTIME_AUTHORITY_INVALID',
    32	  'FRESH_RUNTIME_WITNESS_INVALID',
    33	  'RECORDING_RUNTIME_NOT_CLOSED',
    34	  'REPLAY_RUNTIME_NOT_FRESH',
    35	  'REPLAY_RUNTIME_NOT_LIVE',
    36	  'REPLAY_RUNTIME_OWNERSHIP_MISMATCH',
    37	  'REPLAY_RUNTIME_REUSED',
