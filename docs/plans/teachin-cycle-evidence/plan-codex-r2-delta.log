   241	  if (!record || record.role !== 'distilled' || record.executed) {
   242	    return denied('RUN_COMPLETION_AUTHORITY_INVALID');
   243	  }
   244	  if (!usableIssuer(trustedReplayIssuer, 'executeAndVerify')) {
   245	    return denied('REPLAY_ISSUER_INVALID');
   246	  }
   247	  record.executed = true;
   248	  const runExecutionAuthority = frozen(Object.create(null));
   249	  EXECUTION_STATE.set(runExecutionAuthority, record);
