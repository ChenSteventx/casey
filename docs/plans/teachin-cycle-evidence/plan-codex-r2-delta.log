     1	#!/usr/bin/env node
     2	// 示教复现闭环的薄别名入口。闭环必须在同一进程里从录制交出 live handles，
     3	// 因此本文件不自行执行准入、复现、编译或比较，只把调用原样转交同进程录制入口
     4	// bin/record.mjs（透传参数在前，--login-bootstrap 追加在末位）；它才拥有
     5	// recording Browser/Context。
     6	//
     7	// 技术闭环恒为开发期候选：本入口不产测试结论，也不产正式报告。
     8	
     9	import path from 'node:path';
    10	import { spawnSync } from 'node:child_process';
    11	import { fileURLToPath } from 'node:url';
    12	
    13	const PROJECT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
    14	const RECORD_ENTRY = path.join(PROJECT_ROOT, 'bin', 'record.mjs');
    15	const USAGE = [
    16	  '用法: casey teachin-cycle <caseId> --sut <本地基址> --out-dir <d>',
    17	  '  --testcase <f> --expected <f> --entity-lock <f> --profile <f>',
    18	  '  --sut-build-digest <sha256:...> [--headless --max-ms <ms>]',
    19	  '兼容: 可用 --cycle-plan <f> 作为 mapping/expected 模板；capture 身份仍重绑本次录制。',
    20	].join('\n');
    21	
    22	const rest = process.argv.slice(2);
    23	if (rest.includes('--help') || rest.includes('-h')) {
    24	  console.log(USAGE);
    25	  process.exit(0);
    26	}
    27	
    28	// --login-bootstrap 必须追加在透传参数之后：record 的通用解析器把 `--key` 后面
    29	// 紧跟的非 `--` token 当成该旗标的值，前插会把位置参数 caseId 吃掉；尾位无后继
    30	// token，解析为布尔，caseId 保持首位。
    31	const result = spawnSync(process.execPath, [RECORD_ENTRY, ...rest, '--login-bootstrap'], {
    32	  stdio: 'inherit',
    33	  shell: false,
    34	});
    35	process.exit(typeof result.status === 'number' ? result.status : 1);
     1	// 同进程 record → capture admission → source runtime preparation → 编排 façade 的唯一入口。
     2	// 录制 handles 只在本模块内交给 canonical adapter，绝不进入 core；capture 与 preparation 两枚
     3	// capability 只能由本模块在同进程铸造，plain JSON 无法跨进程重建。
     4	// 任何早退都按 lifecycle 状态收尾 recording owner，恰关闭一次，且不重复 close 宽容。
     5	
     6	import { admitRawReplayCapture } from './raw-capture.mjs';
     7	import { canonicalRuntimeCycleAdapter } from './runtime-cycle-adapter.mjs';
     8	import { runTeachinReplayabilityCycle } from './dual-replay-orchestrator.mjs';
     9	
    10	const ENTRY_KEYS = [
    11	  'caseId', 'captureBytes', 'recordingBrowser', 'recordingContext', 'cycleInput',
    12	];
    13	const CYCLE_KEYS = ['sourcePlan', 'executionTargetAuthority', 'projection', 'distilled'];
    14	const SOURCE_KEYS = ['candidateBytes', 'eventsBytes', 'entityLockBytes', 'runNamespace'];
    15	const DISTILLED_KEYS = ['authoringRunNamespace', 'runNamespace'];
    16	const INPUT_INVALID = 'CYCLE_ENTRY_INPUT_INVALID';
    17	const ENTRY_FAILED = 'CYCLE_ENTRY_FAILED';
    18	
    19	function frozen(value) {
    20	  return Object.freeze(value);
    21	}
    22	
    23	function denied(reason) {
    24	  return frozen({ ok: false, reason });
    25	}
    26	
    27	function exactKeys(value, expected) {
    28	  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
    29	  return Object.keys(value).sort().join(' ') === [...expected].sort().join(' ');
    30	}
    31	
    32	function isRecord(value) {
    33	  return !!value && typeof value === 'object' && !Array.isArray(value);
    34	}
    35	
    36	function liveRecordingPair(recordingBrowser, recordingContext) {
    37	  for (const [handle, methods] of [
    38	    [recordingBrowser, ['on', 'close', 'isConnected']],
    39	    [recordingContext, ['on', 'close', 'browser']],
    40	  ]) {
    41	    if (!isRecord(handle)) return false;
    42	    if (!methods.every((name) => typeof handle[name] === 'function')) return false;
    43	  }
    44	  try {
    45	    return recordingContext.browser() === recordingBrowser;
    46	  } catch {
    47	    return false;
    48	  }
    49	}
    50	
    51	function validCycleInput(cycleInput) {
    52	  if (!exactKeys(cycleInput, CYCLE_KEYS)) return false;
    53	  const sourcePlan = cycleInput.sourcePlan;
    54	  if (!isRecord(sourcePlan) || !exactKeys(sourcePlan.source, SOURCE_KEYS)) return false;
    55	  if (typeof sourcePlan.source.runNamespace !== 'string' || !sourcePlan.source.runNamespace) {
    56	    return false;
    57	  }
    58	  if (!exactKeys(cycleInput.distilled, DISTILLED_KEYS)) return false;
    59	  if (!isRecord(cycleInput.projection)) return false;
    60	  if (!isRecord(cycleInput.executionTargetAuthority)) return false;
    61	  return true;
    62	}
    63	
    64	// 唯一顺序的第一步：capture 准入。canonical 缺省实现在此，注入接缝只替换它。
    65	function canonicalAdmission(input) {
    66	  return admitRawReplayCapture(input);
    67	}
    68	
    69	export function createReplayabilityCycleEntry(deps = {}) {
    70	  const admit = typeof deps.admitRawReplayCapture === 'function'
    71	    ? deps.admitRawReplayCapture
    72	    : canonicalAdmission;
    73	  const runtimeCycleAdapter = isRecord(deps.runtimeCycleAdapter)
    74	    ? deps.runtimeCycleAdapter
    75	    : canonicalRuntimeCycleAdapter;
    76	  const runCycle = typeof deps.runTeachinReplayabilityCycle === 'function'
    77	    ? deps.runTeachinReplayabilityCycle
    78	    : canonicalCycleFacade;
    79	
    80	  async function runRecordedCycle(input = {}) {
    81	    if (!exactKeys(input, ENTRY_KEYS)) return denied(INPUT_INVALID);
    82	    const { caseId, captureBytes, recordingBrowser, recordingContext, cycleInput } = input;
    83	    if (typeof caseId !== 'string' || !caseId) return denied(INPUT_INVALID);
    84	    if (!Buffer.isBuffer(captureBytes) || captureBytes.length === 0) return denied(INPUT_INVALID);
    85	    if (!liveRecordingPair(recordingBrowser, recordingContext)) return denied(INPUT_INVALID);
    86	    if (!validCycleInput(cycleInput)) return denied(INPUT_INVALID);
    87	
    88	    // 关闭事实只能来自真实 lifecycle 事件；失败清理据此判定，绝不靠重复 close 宽容。
    89	    let contextClosed = false;
    90	    try {
    91	      recordingContext.on('close', () => { contextClosed = true; });
    92	      // Browser 断连蕴含其 Context 已随之关闭：与 close 事件一样真置位，
    93	      // 否则清理分支会在 browser 先断时误判「还没关」而重复关一次。
    94	      recordingBrowser.on('disconnected', () => { contextClosed = true; });
    95	    } catch {
    96	      return denied(INPUT_INVALID);
    97	    }
    98	    const stillLive = () => {
    99	      try {
   100	        return recordingBrowser.isConnected() === true;
   101	      } catch {
   102	        return false;
   103	      }
   104	    };
   105	
   106	    try {
   107	      const admitted = await admit({ caseId, captureBytes });
   108	      if (admitted?.ok !== true) return denied(admitted?.reason || ENTRY_FAILED);
   109	
   110	      const prepared = await runtimeCycleAdapter.prepareSourceReplayRuntime({
   111	        executionTargetAuthority: cycleInput.executionTargetAuthority,
   112	        recordingBrowser,
   113	        recordingContext,
   114	        runNamespace: cycleInput.sourcePlan.source.runNamespace,
   115	      });
   116	      if (prepared?.ok !== true) return denied(prepared?.reason || ENTRY_FAILED);
   117	
   118	      const result = await runCycle({
   119	        sourcePlan: {
   120	          ...cycleInput.sourcePlan,
   121	          source: {
   122	            ...cycleInput.sourcePlan.source,
   123	            captureAuthority: admitted.captureAuthority,
   124	          },
   125	        },
   126	        executionTargetAuthority: cycleInput.executionTargetAuthority,
   127	        sourceRuntime: {
   128	          sourceRuntimePreparationAuthority: prepared.sourceRuntimePreparationAuthority,
   129	        },
   130	        projection: cycleInput.projection,
   131	        distilled: cycleInput.distilled,
   132	      });
   133	      return result;
   134	    } catch {
   135	      return denied(ENTRY_FAILED);
   136	    } finally {
   137	      if (stillLive()) {
   138	        if (!contextClosed) {
   139	          try {
   140	            await recordingContext.close();
   141	          } catch { /* 清理失败不改变闭合返回 */ }
   142	        }
   143	        try {
   144	          await recordingBrowser.close();
   145	        } catch { /* 清理失败不改变闭合返回 */ }
   146	      }
   147	    }
   148	  }
   149	
   150	  return frozen({ runRecordedCycle });
   151	}
   152	
   153	// 唯一顺序的最后一步：编排 façade。它只在 admission 与 source runtime preparation 都成功后被调用，
   154	// 所以 canonical 缺省实现放在准入/准备两步之后，与 entry 内部推进次序一致。
   155	function canonicalCycleFacade(input) {
   156	  return runTeachinReplayabilityCycle(input);
   157	}
   158	
   159	const canonicalEntry = createReplayabilityCycleEntry({});
   160	
   161	export async function runRecordedTeachinReplayabilityCycle(input) {
   162	  return canonicalEntry.runRecordedCycle(input);
   163	}

