/bin/bash -lc "sed -n '185,290p' docs/design/txt2testreport-design.md && sed -n '1,230p' docs/plans/bootstrap/plan.md && sed -n '1,100p' loop/GUARDRAILS.md" in /mnt/d/ctx/heren/casey
