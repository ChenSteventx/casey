/bin/bash -lc "node --experimental-vm-modules --input-type=module <<'NODE'
import { readFileSync } from 'node:fs';
import vm from 'node:vm';

const original = readFileSync('bin/record.mjs', 'utf8');
const golden = readFileSync('tests/_golden/teachin-replayability-cycle-plan.static.golden.mjs', 'utf8');
const helperStart = golden.indexOf('const REGEX_LEAD_WORDS');
const helperEnd = golden.indexOf('\\nasync function check(');
const helperSource = "'`${golden.slice(helperStart, helperEnd)}'"\\nexport { stripLexical, lexicalSpan, countRaw };"'`;
const { stripLexical, lexicalSpan, countRaw } = await import(`data:text/javascript,${encodeURIComponent(helperSource)}`);

const oldBlock = `      const evidenceCollector = createCycleEvidenceCollector();
      const cycle = await runWithCycleEvidence(evidenceCollector, () => (
        runRecordedTeachinReplayabilityCycle({
          caseId,
          captureBytes: exactCaptureBytes,
          recordingBrowser: browser,
          recordingContext: context,
          cycleInput: built.cycleInput,
        })
      ));`;
const counterexample = `      const evidenceCollector = createCycleEvidenceCollector();
      const startedOutsideEvidence = eval(
        '"'runRecordedTeachinReplayability' +
        'Cycle({ caseId, captureBytes: exactCaptureBytes, recordingBrowser: browser, recordingContext: context, cycleInput: built.cycleInput })'
      );
      const cycle = await runWithCycleEvidence(evidenceCollector, () => (
        'runRecordedTeachinReplayabilityCycle(' && (startedOutsideEvidence)
      ));"'`;
if (!original.includes(oldBlock)) throw new Error('"'mutation anchor missing');
const record = original.replace(oldBlock, counterexample);

const stripped = stripLexical(record);
const code = stripped.text;
const wrap = lexicalSpan(code, 'runWithCycleEvidence(');
const callAt = record.indexOf('runRecordedTeachinReplayabilityCycle(');
const minted = code.match(/const\\s+([A-Za-z0-9_"'$]+)'"\\s*=\\s*createCycleEvidenceCollector\\(\\)/);
const collector = minted?.[1];
const head = code.slice(wrap.argsAt, callAt);
const headPass = new RegExp("'`''^'"\\\\s*"'${collector}'"\\\\s*,\\\\s*\\\\(\\\\s*\\\\)\\\\s*=>\\\\s*\\\\(\\\\s*"'$`).test(head);
let depth = 0;
let callEnd = -1;
for (let i = callAt + '"'runRecordedTeachinReplayabilityCycle'.length; i < wrap.end; i += 1) {
  const ch = code[i];
  if (ch === '(') depth += 1;
  else if (ch === ')') {
    depth -= 1;
    if (depth === 0) { callEnd = i; break; }
  }
}
const tail = code.slice(callEnd + 1, wrap.end);
const result = {
  syntaxValid: true,
  poisoned: stripped.poisoned,
  rawCounts: {
    cycleBare: countRaw(record, 'runRecordedTeachinReplayabilityCycle'),
