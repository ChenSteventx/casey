// 逐字符剥成同长空格，换行原样保留——剥离结果与原文逐字符同偏移，下标可直接切原文。
// 只服务两件事：定位取证包裹的 span、括号配平。判不出的 / 不再猜，直接毒化。
function stripLexical(source) {
