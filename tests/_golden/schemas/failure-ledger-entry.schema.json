{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "casey/failure-ledger-entry.schema.json",
  "title": "failure ledger 单条记录 — 失败记录台账条目（seams-freeze-v2 冻结）",
  "description": "多态裁定下游的只读诊断记录：verdict.mjs 出完四态后，每条非 PASS 步级裁定追加成一条不可变条目，供人做失败聚类/优先级/编译期建议。红线：只读追加不改、产出绝不进 bin/verdict.mjs、绝不作自愈输入、不能自动改断言/删用例/把 NEEDS_HUMAN 改 HARNESS_ERROR、编译期建议须经人签链路(护栏 #13/#15)。凭据兜底：绝不含 request/response body、headers、cookie、token、PII、replyText 全文 —— additionalProperties:false 机制兜底(护栏 #7)。本 schema 校验台账数组中的每一条；fixture 见 tests/_golden/fixtures/seams-v2/failure-ledger.fixture.json。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entryId",
    "caseId",
    "stepId",
    "intentId",
    "atom",
    "channel",
    "verdict",
    "reason",
    "fingerprint",
    "fingerprintInputs",
    "failedAssertion",
    "forensicsRef",
    "observedAt",
    "humanResolution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "接缝版本，整数。"
    },
    "entryId": {
      "type": "string",
      "pattern": "^fle_[0-9a-zA-Z_]+$",
      "description": "条目唯一 id(append-only 台账每条一个)；定位/审计用，不进 fingerprint。"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "description": "TestCase.caseId；定位字段，绝不进 fingerprint —— 这样同一失败模式可跨用例聚类。"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "description": "产生该观测的运行 id(runs/<caseId>/<runId>/)；审计用，绝不进 fingerprint。未知则 null。"
    },
    "stepId": {
      "type": "string",
      "pattern": "^atstep_[0-9]+$",
      "description": "位置式回放事件 id，与三轴/verdict.json 一致；定位字段，绝不进 fingerprint(位置会随 spec 平移)。"
    },
    "intentId": {
      "type": "string",
      "minLength": 1,
      "description": "用例语义步 id；定位/展示用。"
    },
    "atom": {
      "type": [
        "string",
        "null"
      ],
      "description": "稳定语义动作 id(如 workflow.save)；fingerprint 输入之一，无则 null。"
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "cef",
        "arbitrary"
      ],
      "description": "回放通道；fingerprint 输入之一。"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "SUT_DEFECT",
        "HARNESS_ERROR",
        "NEEDS_HUMAN"
      ],
      "description": "该步多态裁定(非 PASS)。PASS 不入失败台账。fingerprint 输入之一。台账绝不改写本字段(humanResolution 无 verdict 字段，结构上改不动原裁定)。"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SUT_DEFECT_OR_STALE",
        "CASE_DEFECT",
        "AMBIGUOUS_ACTION",
        "AFFORDANCE_ABSENT",
        "INDETERMINATE",
        null
      ],
      "description": "NEEDS_HUMAN 子类，或终判时 null(镜像 bin/verdict.mjs 判定树与 prd-v2 不变量)；fingerprint 输入之一。"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "可聚类失败指纹 = 'sha256:' + sha256(canonicalJSON(fingerprintInputs))；零 LLM、可复现、要进 golden。绝不含易变实例值(见 fingerprintInputs 排除项)。聚类粒度 route:human(决策 3.3)。"
    },
    "fingerprintInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "verdict",
        "reason",
        "atom",
        "assertionKind",
        "assertionOp",
        "signatureTemplate"
      ],
      "description": "哈希所用的定长、只含稳定且已模板化字段的元组，随条目落盘供人/golden 复算校验指纹。channel/verdict/reason/atom 与顶层同值(自包含哈希输入快照)——跨字段相等 draft-07 无法表达，由冻结 golden 校验防指纹与记录漂移。显式排除：caseId、stepId 序号、runId、时间戳、atl_ 实例名、实体 ID、query 串、replyText 全文、raw locator 坐标、任何凭据/PII。",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "web",
            "cef",
            "arbitrary"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "SUT_DEFECT",
            "HARNESS_ERROR",
            "NEEDS_HUMAN"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SUT_DEFECT_OR_STALE",
            "CASE_DEFECT",
            "AMBIGUOUS_ACTION",
            "AFFORDANCE_ABSENT",
            "INDETERMINATE",
            null
          ]
        },
        "atom": {
          "type": [
            "string",
            "null"
          ],
          "description": "稳定语义动作 id，非 stepId。"
        },
        "assertionKind": {
          "type": [
            "string",
            "null"
          ],
          "description": "断言失败时的 kind(urlPathname/textVisible/countChange/...)；非断言失败则 null。kind 枚举唯一权威在 check.mjs，本处只记其值不分支。 非空白 pattern(codex R11-F1)。",
          "pattern": "\\S"
        },
        "assertionOp": {
          "type": [
            "string",
            "null"
          ],
          "description": "断言 op(startsWith/equals/matches/...)；无则 null。 非空白 pattern(codex R11-F1)。",
          "pattern": "\\S"
        },
        "signatureTemplate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^role=[a-z]+;name=(?!.*(?:[cC][sS][sS]=|[xX][pP][aA][tT][hH]=|nth-child|[xXyY]=\\d))[^;#\\[\\]>+~=/.:,'\"()*]{1,120}$",
          "description": "定位/漂移类失败的稳定签名模板(role+可访问名模板)，非 raw CSS/坐标；无则 null。pattern 钉死 role=<角色>;name=<可访问名> 唯一形态(codex R4)，name 段负字符集保守收紧(codex R5-F3+R6-F2+R7-F2)：结构字符 []>+~ 与 =/.:,'\"()* 全禁——css=/xpath= 前缀(含大小写)、裸选择器(button.primary、//button、:has-text)、坐标对(x=1,y=2、left=1,top=2)在此形态下无处容身。schema 层机制化「raw locator 坐标不进 fingerprintInputs」，防指纹依赖布局坐标破坏稳定聚类；可访问名若真含这些 ASCII 标点属棘轮放宽事件 route:human。"
        }
      }
    },
    "failedAssertion": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "fieldPath",
        "expectedTemplate",
        "actualTemplate"
      ],
      "description": "断言失败的诊断快照(已模板化，绝不存 raw 字面量/实体 ID)；非断言失败则 null。",
      "properties": {
        "kind": {
          "type": "string",
          "description": "断言 kind。 非空白 pattern(codex R11-F1 空串证据封口)。",
          "pattern": "\\S"
        },
        "op": {
          "type": "string",
          "description": "断言 op。 非空白 pattern(codex R11-F1 空串证据封口)。",
          "pattern": "\\S"
        },
        "fieldPath": {
          "type": "string",
          "description": "被检字段路径(如 urlPathnameAfter)。 非空白 pattern(codex R11-F1 空串证据封口)。",
          "pattern": "\\S"
        },
        "expectedTemplate": {
          "description": "期望值的模板化形态(易变值已打模板)。",
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "actualTemplate": {
          "description": "实测值的模板化形态(易变值已打模板)。",
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "forensicsRef": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "urlTemplate",
        "status",
        "errorEnvelopeField",
        "attributedStepId"
      ],
      "description": "取证类失败的诊断指针(按请求发起方归因)，与 watchNetworkForensics 同源。绝不含 body/headers/cookie/token；URL 已模板化去 query/实体 ID。非取证失败则 null。",
      "properties": {
        "urlTemplate": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_\\-./<>]*$",
          "description": "归因请求的 URL 路径模板(去 host/query/实体 ID)。pattern 钉死纯路径形态(codex R4)：以 / 起、字符集排除 ?/=/&/#/空白——query 串形态凭据(?token=…&patientId=…)在 schema 层被拒，护栏 #7 value 侧机制化(与 run-history valueRef pattern 同思路)；实体 ID 模板位允许 <entityId> 尖括号占位。"
        },
        "status": {
          "type": "integer",
          "description": "HTTP 状态码；requestfailed 记 0。"
        },
        "errorEnvelopeField": {
          "type": [
            "string",
            "null"
          ],
          "description": "错误信封被检字段名(按 channel 参数化，如 status)；无则 null。 非空白 pattern(codex R11-F1)。",
          "pattern": "\\S"
        },
        "attributedStepId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^atstep_[0-9]+$",
          "description": "取证归因到的 stepId(按 initiator 归因、非时间窗)；background/不可归因则 null。pattern 钉 atstep_N 形态(codex R10-F1)；作 SUT_DEFECT 背书时须非 null 且等于本条 stepId(等值跨字段约束由冻结 golden 校验)。"
        }
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "失败观测时刻 ISO-8601；审计/排序用，绝不进 fingerprint、非裁定输入。"
    },
    "capturedAgainstBuild": {
      "type": [
        "string",
        "null"
      ],
      "description": "观测时 SUT 构建标识；供 重签 的 signedAgainstBuild 对齐溯源，未知则 null。"
    },
    "humanResolution": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "decision",
        "resolvedAt",
        "resolverId",
        "ref"
      ],
      "description": "人裁决回填：由人经签署链路写入，未裁前为 null。它是只读审计指针、不是执行器——ref 指向权威产物(缺陷单/重签元数据/漂移补丁)，绝不复制权威态、绝不改写原 verdict。红线：decision='drift-healed' 仅当 verdict==='HARNESS_ERROR' 才合法。",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "intended-change-resign",
            "confirm-regression-defect",
            "tighten-locator-recompile",
            "fix-case",
            "drift-healed",
            "acknowledged-flaky",
            "needs-more-evidence"
          ],
          "description": "人裁出口，镜像 CONTEXT.md 各人裁分支。intended-change-resign→重签；confirm-regression-defect→缺陷单；drift-healed→漂移补丁(仅 HARNESS_ERROR 合法)。"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "人裁决时刻 ISO-8601。"
        },
        "resolverId": {
          "type": "string",
          "minLength": 1,
          "description": "裁决人标识(与 期望版本化 signerId 同体系)。"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "指向权威产物的引用：缺陷单 id / 新签署 checksum / drift/<caseId>.<ts>.patch 路径。只引用、不复制；无适用产物(如 needs-more-evidence)则 null。"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "可选人工备注(须过凭据兜底门，绝不含凭据/PII)。"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "fail-safe 不变量(镜像 bin/verdict.mjs 判定树)：非 NEEDS_HUMAN 的终判 reason 必为 null。",
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "SUT_DEFECT",
              "HARNESS_ERROR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": null
          }
        }
      }
    },
    {
      "description": "fail-safe 不变量：NEEDS_HUMAN 必带 5 个 reason 子类之一，绝不为 null(catch-all 落 INDETERMINATE)。",
      "if": {
        "properties": {
          "verdict": {
            "const": "NEEDS_HUMAN"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "SUT_DEFECT_OR_STALE",
              "CASE_DEFECT",
              "AMBIGUOUS_ACTION",
              "AFFORDANCE_ABSENT",
              "INDETERMINATE"
            ]
          }
        }
      }
    },
    {
      "description": "自愈红线机制化(护栏 #13/#15)：humanResolution.decision='drift-healed' 仅当 verdict==='HARNESS_ERROR' 才合法——NEEDS_HUMAN/SUT_DEFECT 条目的人裁绝不能直接路由去自愈；要走自愈须先以新证据重跑产新 verdict(那是新一轮裁定、不是改台账)。镜像已冻姊妹接缝(drift-patch/expected-frozen 的 allOf 不变量)惯例钉成机制。",
      "if": {
        "properties": {
          "humanResolution": {
            "type": "object",
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "const": "drift-healed"
              }
            }
          }
        },
        "required": [
          "humanResolution"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "HARNESS_ERROR"
          }
        }
      }
    },
    {
      "description": "断言快照与指纹 kind 双向一致机制化(护栏 #17 断言侧)：failedAssertion 为 object 时 fingerprintInputs.assertionKind/assertionOp 必为 string——有断言快照必有 kind。此前仅 golden 抽查 fixture，此 allOf 补 schema 层，真实 producer 漂移也被拒。",
      "if": {
        "required": [
          "failedAssertion"
        ],
        "properties": {
          "failedAssertion": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "fingerprintInputs": {
            "required": [
              "assertionKind",
              "assertionOp"
            ],
            "properties": {
              "assertionKind": {
                "type": "string"
              },
              "assertionOp": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "description": "反向：fingerprintInputs.assertionKind 为 string 时 failedAssertion 必为 object(断言失败才有断言快照)——防有 kind 无快照漂移。",
      "if": {
        "properties": {
          "fingerprintInputs": {
            "required": [
              "assertionKind"
            ],
            "properties": {
              "assertionKind": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "failedAssertion"
        ],
        "properties": {
          "failedAssertion": {
            "type": "object"
          }
        }
      }
    },
    {
      "description": "fail-safe 证据背书机制化(codex R9-F1 修正采纳)：SUT_DEFECT 是须取证背书的终判(护栏 #14/ADR-0002)，台账条目至少携一个非 null 证据指针——failedAssertion(断言证据)或 forensicsRef(取证证据)。不强制 failedAssertion：SUT_DEFECT 可仅由 5xx/pageerror/crash 背书而无失败断言(layer3-wiring 评审裁决)；零证据指针的 SUT_DEFECT 违「证不出→NEEDS_HUMAN」，schema 层拒。",
      "if": {
        "properties": {
          "verdict": {
            "const": "SUT_DEFECT"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "failedAssertion": {
                "type": "object",
                "anyOf": [
                  {
                    "properties": {
                      "expectedTemplate": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "expectedTemplate"
                    ]
                  },
                  {
                    "properties": {
                      "actualTemplate": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "actualTemplate"
                    ]
                  }
                ]
              }
            },
            "required": [
              "failedAssertion"
            ]
          },
          {
            "properties": {
              "forensicsRef": {
                "type": "object",
                "required": [
                  "attributedStepId"
                ],
                "properties": {
                  "attributedStepId": {
                    "type": "string"
                  }
                },
                "anyOf": [
                  {
                    "properties": {
                      "status": {
                        "minimum": 500
                      }
                    }
                  },
                  {
                    "properties": {
                      "status": {
                        "const": 0
                      }
                    }
                  },
                  {
                    "properties": {
                      "errorEnvelopeField": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "errorEnvelopeField"
                    ]
                  }
                ]
              }
            },
            "required": [
              "forensicsRef"
            ]
          }
        ]
      }
    },
    {
      "description": "kind/op 成对不变量(codex R3)：fingerprintInputs.assertionKind 为 null 时 assertionOp 必为 null——非断言失败绝不携断言 op，防污染失败聚类；与上两条合成 failedAssertion⟺assertionKind⟺assertionOp 三者同真假。",
      "if": {
        "properties": {
          "fingerprintInputs": {
            "properties": {
              "assertionKind": {
                "const": null
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "fingerprintInputs": {
            "properties": {
              "assertionOp": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "description": "混合证据同锁(codex R11-F2)：SUT_DEFECT 携任何非 null forensicsRef——无论是否同时有断言证据——都须真背书(归因字段必填 string + 失败信号 anyOf)，不许「断言证据打掩护、装饰性取证指针随行」。",
      "if": {
        "properties": {
          "verdict": {
            "const": "SUT_DEFECT"
          },
          "forensicsRef": {
            "type": "object"
          }
        },
        "required": [
          "verdict",
          "forensicsRef"
        ]
      },
      "then": {
        "properties": {
          "forensicsRef": {
            "required": [
              "attributedStepId"
            ],
            "properties": {
              "attributedStepId": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "status": {
                    "minimum": 500
                  }
                }
              },
              {
                "properties": {
                  "status": {
                    "const": 0
                  }
                }
              },
              {
                "properties": {
                  "errorEnvelopeField": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "errorEnvelopeField"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
